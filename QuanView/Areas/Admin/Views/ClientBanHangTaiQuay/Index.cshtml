    // Thêm sản phẩm vào giỏ hàng với tùy chọn số lượng
    function addProductToGioHang(productId, quantity = null) {
        if (gioHangs.length === 0) {
            showWarning('Vui lòng tạo giỏ hàng trước!');
            return;
        }

        // Nếu không có số lượng, hiển thị modal để nhập số lượng
        if (quantity === null) {
            showQuantityModal(productId);
            return;
        }

        // Kiểm tra tồn kho trước khi thêm
        const productInfo = products.find(p => p.id === productId);
        if (!productInfo) {
            showError('Không tìm thấy thông tin sản phẩm!');
            return;
        }

        if (quantity > productInfo.stock) {
            showError(`Số lượng vượt quá tồn kho. Hiện có: ${productInfo.stock}`);
            return;
        }

        if (quantity <= 0) {
            showError('Số lượng phải lớn hơn 0!');
            return;
        }

        const gh = gioHangs[currentGioHang];
        const dto = {
            idGioHang: gh.id,
            idSanPhamChiTiet: productId,
            soLuong: quantity,
            nguoiCapNhat: "Admin"
        };

        $.ajax({
            url: '/Admin/ClientBanHangTaiQuay/them-vao-gio-hang',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dto),
            success: function (res) {
                $('#productModal').modal('hide');
                $('#quantityModal').modal('hide');
                loadGioHang(); // Reload từ server
                renderTabs();
                loadProducts(); // cập nhật lại tồn kho

                // Hiển thị thông báo thành công
                if (res && res.message) {
                    showSuccess(res.message);
                }
            },
            error: function (xhr) {
                let msg = 'Thêm sản phẩm thất bại!';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                else if (xhr.responseText) {
                    try {
                        let obj = JSON.parse(xhr.responseText);
                        if (obj.message) msg = obj.message;
                        else msg = xhr.responseText;
                    } catch {
                        msg = xhr.responseText;
                    }
                }
                showError(msg);
            }
        });
    }

    // Hiển thị modal nhập số lượng
    function showQuantityModal(productId) {
        const productInfo = products.find(p => p.id === productId);
        if (!productInfo) {
            showError('Không tìm thấy thông tin sản phẩm!');
            return;
        }

        // Cập nhật thông tin sản phẩm trong modal
        document.getElementById('quantityProductName').textContent = productInfo.name;
        document.getElementById('quantityProductStock').textContent = productInfo.stock;
        document.getElementById('quantityInput').value = 1;
        document.getElementById('quantityInput').max = productInfo.stock;
        document.getElementById('maxQuantityText').textContent = productInfo.stock;

        // Lưu productId để sử dụng khi xác nhận
        document.getElementById('quantityModal').setAttribute('data-product-id', productId);

        $('#quantityModal').modal('show');

        // Focus vào input số lượng
        setTimeout(() => {
            document.getElementById('quantityInput').focus();
            document.getElementById('quantityInput').select();
        }, 500);
    }

    // Xác nhận thêm sản phẩm với số lượng đã nhập
    function confirmAddProduct() {
        const modal = document.getElementById('quantityModal');
        const productId = modal.getAttribute('data-product-id');
        const quantity = parseInt(document.getElementById('quantityInput').value);
        const productInfo = products.find(p => p.id === productId);

        if (isNaN(quantity) || quantity <= 0) {
            showError('Số lượng phải lớn hơn 0!');
            return;
        }

        if (productInfo && quantity > productInfo.stock) {
            showError(`Số lượng không được vượt quá tồn kho (${productInfo.stock}).`);
            return;
        }

        addProductToGioHang(productId, quantity);
    }

