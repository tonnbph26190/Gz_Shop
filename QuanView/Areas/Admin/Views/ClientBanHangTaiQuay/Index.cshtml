    // Thay đổi số lượng sản phẩm
    function changeQty(productId, delta) {
        const gh = gioHangs[currentGioHang];
        const product = gh.products.find(p => p.id === productId);
        if (!product) return;

        const newQty = product.soLuong + delta;
        if (newQty < 1) {
            // Xóa sản phẩm nếu số lượng = 0
            removeProduct(productId);
            return;
        }

        // Kiểm tra tồn kho trước khi gửi request
        const productInfo = products.find(p => p.id === productId);
        if (productInfo) {
            // Tính tổng số lượng có thể sử dụng (tồn kho hiện tại + số lượng đã chọn)
            const availableStock = productInfo.stock + product.soLuong;
            if (newQty > availableStock) {
                showError(`Số lượng vượt quá tồn kho. Hiện có: ${availableStock}`);
                return;
            }
        }

        const dto = {
            idGioHang: gh.id,
            idSanPhamChiTiet: productId,
            soLuongMoi: newQty,
            nguoiCapNhat: "Admin"
        };

        $.ajax({
            url: '/Admin/ClientBanHangTaiQuay/cap-nhat-so-luong-gio-hang',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dto),
            success: function (res) {
                loadGioHang(); // Reload từ server
                renderTabs();
                loadProducts(); // cập nhật lại tồn kho

                // Hiển thị thông báo thành công với số lượng còn lại
                if (res && res.message) {
                    showSuccess(res.message);
                }
            },
            error: function (xhr) {
                let msg = 'Cập nhật số lượng thất bại!';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                else if (xhr.responseText) {
                    try {
                        let obj = JSON.parse(xhr.responseText);
                        if (obj.message) msg = obj.message;
                        else msg = xhr.responseText;
                    } catch {
                        msg = xhr.responseText;
                    }
                }
                showError(msg);
            }
        });
    }

    // Nhập số lượng thủ công
    function changeQtyManual(productId, value) {
        const qty = parseInt(value, 10);
        if (isNaN(qty) || qty < 1) {
            showError('Số lượng phải là số nguyên dương!');
            // Reset về giá trị cũ
            const gh = gioHangs[currentGioHang];
            const product = gh.products.find(p => p.id === productId);
            if (product) {
                const input = document.querySelector(`input[onchange*="${productId}"]`);
                if (input) input.value = product.soLuong;
            }
            return;
        }

        // Kiểm tra tồn kho trước khi gửi request
        const gh = gioHangs[currentGioHang];
        const product = gh.products.find(p => p.id === productId);
        const productInfo = products.find(p => p.id === productId);

        if (productInfo && product) {
            // Tính tổng số lượng có thể sử dụng (tồn kho hiện tại + số lượng đã chọn)
            const availableStock = productInfo.stock + product.soLuong;
            if (qty > availableStock) {
                showError(`Số lượng vượt quá tồn kho. Hiện có: ${availableStock}`);
                // Reset về giá trị cũ
                const input = document.querySelector(`input[onchange*="${productId}"]`);
                if (input) input.value = product.soLuong;
                return;
            }
        }

        const dto = {
            idGioHang: gh.id,
            idSanPhamChiTiet: productId,
            soLuongMoi: qty,
            nguoiCapNhat: "Admin"
        };

        $.ajax({
            url: '/Admin/ClientBanHangTaiQuay/cap-nhat-so-luong-gio-hang',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dto),
            success: function (res) {
                loadGioHang(); // Reload từ server
                renderTabs();
                loadProducts(); // cập nhật lại tồn kho

                // Hiển thị thông báo thành công
                if (res && res.message) {
                    showSuccess(res.message);
                }
            },
            error: function (xhr) {
                let msg = 'Cập nhật số lượng thất bại!';
                if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                else if (xhr.responseText) {
                    try {
                        let obj = JSON.parse(xhr.responseText);
                        if (obj.message) msg = obj.message;
                        else msg = xhr.responseText;
                    } catch {
                        msg = xhr.responseText;
                    }
                }
                showError(msg);

                // Reset về giá trị cũ khi có lỗi
                const gh = gioHangs[currentGioHang];
                const product = gh.products.find(p => p.id === productId);
                if (product) {
                    const input = document.querySelector(`input[onchange*="${productId}"]`);
                    if (input) input.value = product.soLuong;
                }
            }
        });
    }

