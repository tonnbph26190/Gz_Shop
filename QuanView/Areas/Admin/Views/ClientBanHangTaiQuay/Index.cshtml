                            <div class="fw-bold">${p.ten}</div>
                            <small class="text-muted">
                                <span class="badge bg-light text-dark me-1">${p.kichCo}</span>
                                <span class="badge bg-light text-dark me-1">${p.mauSac}</span>
                                ${p.hoaTiet ? `<span class="badge bg-light text-dark">${p.hoaTiet}</span>` : ''}
