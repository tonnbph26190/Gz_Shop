            let cardClass = isDisabled ? 'voucher-card-disabled' : '';
            let buttonClass = isDisabled ? 'disabled' : '';

            html += `
                <div class="col-md-6 mb-3">
                    <div class="card voucher-ticket h-100 border-0 ${!isActive ? 'opacity-75' : ''}" 
                        style="border-radius: 12px; overflow: hidden; position: relative; min-height: 130px;">
                        
                        <div class="row g-0 h-100">
                            <div class="${isExpired ? 'bg-danger' : (isActive && meetsMinimum ? 'bg-success' : 'bg-secondary')} ${typeof isBest !== 'undefined' && isBest ? 'bg-warning' : ''}" 
                                style="width: 7px;"></div>

                            <div class="col px-3 py-2 d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="text-truncate" style="max-width: 65%;">
                                        <h6 class="fw-bold mb-0 text-dark" style="font-size: 0.9rem;">${voucher.tenPhieu}</h6>
                                        ${typeof isBest !== 'undefined' && isBest ? '<span class="badge badge-best mt-1" style="font-size: 0.6rem;">🔥 ƯU TIÊN</span>' : ''}
                                    </div>
                                    <span class="badge badge-reactive ${statusBadgeClass}" style="font-size: 0.65rem; letter-spacing: 0.5px;">
                                        ${statusText}
                                    </span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between my-2">
                                    <div class="bg-light px-2 py-1 rounded">
                                        <code class="fw-bold text-primary" style="font-size: 1.1rem; background: transparent;">${voucher.maCode}</code>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-bold text-dark" style="font-size: 1.1rem;">-${voucher.giaTriGiam}%</span>
                                        <small class="text-muted d-block" style="font-size: 0.65rem;">Tối đa ${voucher.giaTriGiamToiDa.toLocaleString()}đ</small>
