                                            `<div class="text-success fw-bold" style="font-size: 0.75rem;"><i class="fas fa-check-circle"></i> Giảm ${realDiscount.toLocaleString()}đ</div>` : 
                                            `<div class="text-muted" style="font-size: 0.65rem;">Hạn: ${new Date(voucher.ngayKetThuc).toLocaleDateString('vi-VN')}</div>`)}
                                    </div>
                                    
                                    <button class="btn btn-sm py-0 px-3 rounded-pill btn-voucher-apply ${isActive && meetsMinimum ? 'btn-outline-primary btn-voucher-active' : 'btn-outline-secondary btn-voucher-disabled'}"
                                            style="font-size: 0.75rem; height: 28px; border-width: 1.5px;"
                                            onclick="selectVoucher('${voucher.maCode}', ${voucher.giaTriGiam}, ${voucher.giaTriGiamToiDa}, ${voucher.donToiThieu})"
                                            ${!isActive ? 'disabled' : ''}>
