    function getRequestedPointForUse() {
        if (!selectedCustomer || selectedCustomer.isGuest || !usePoint) {
            return 0;
        }

        let gh = gioHangs[currentGioHang];
        const total = gh && gh.products ? gh.products.reduce((sum, p) => sum + p.thanhTien, 0) : 0;
        const discount = discountValue || 0;
        const maxUsable = getMaxUsablePoint(total, discount);
        const requested = Math.max(0, parseInt($('#requestedUsedPoints').val(), 10) || 0);
        if (requested > maxUsable) {
            $('#requestedUsedPoints').val(maxUsable);
            return maxUsable;
        }

        return requested;
    }

    async function loadPointRate() {
        try {
            const response = await fetch('/Admin/ClientBanHangTaiQuay/cau-hinh-ban-hang');
            if (!response.ok) {
                moneyPerPoint = 0;
                const rateLabel = document.getElementById('pointRateLabel');
                if (rateLabel) rateLabel.textContent = 'Không lấy được cấu hình điểm';
                $('#pointSwitch').prop('checked', false);
                usePoint = false;
                updatePaymentInfoWithoutRecalculation();
                return;
            }

            const data = await response.json();
            const config = data?.config || {};
            const rate = Number(config.soTienGiamTrenMotDiem ?? config.SoTienGiamTrenMotDiem);
            maxPointsPerOrder = Math.max(0, Number(config.diemToiDaSuDungMoiDon ?? config.DiemToiDaSuDungMoiDon) || 0);
            if (!Number.isFinite(rate) || rate <= 0) {
                moneyPerPoint = 0;
                const rateLabel = document.getElementById('pointRateLabel');
                if (rateLabel) rateLabel.textContent = 'Cấu hình quy đổi điểm chưa hợp lệ';
                $('#pointSwitch').prop('checked', false);
                usePoint = false;
                updatePaymentInfoWithoutRecalculation();
                return;
            }
            moneyPerPoint = rate;

            const rateLabel = document.getElementById('pointRateLabel');
            if (rateLabel) {
                const maxText = maxPointsPerOrder > 0 ? ` | Tối đa ${maxPointsPerOrder.toLocaleString('vi-VN')} điểm/đơn` : '';
                rateLabel.textContent = `1 điểm = ${moneyPerPoint.toLocaleString('vi-VN')} VND${maxText}`;
            }
            const currentPoint = Number(selectedCustomer?.point || 0);
            $('#requestedUsedPoints').attr('max', getPointLimitByConfig(currentPoint));
            updatePaymentInfoWithoutRecalculation();
        } catch (error) {
            console.error('Không tải được cấu hình quy đổi điểm:', error);
        }
    }

    // Cập nhật thông tin thanh toán (có tính lại phí vận chuyển)
    function updatePaymentInfo() {
        let gh = gioHangs[currentGioHang];
        let total = gh && gh.products ? gh.products.reduce((sum, p) => sum + p.thanhTien, 0) : 0;
        let discount = discountValue || 0;
        let pointUsed = getRequestedPointForUse();
        let point = pointUsed * moneyPerPoint;
        let pay = total - discount - point + shippingFee;
        if (pay < 0) pay = 0;

        $('#goodsAmount').text(total.toLocaleString() + " VND");
        $('#discountAmount').text("- " + discount.toLocaleString() + " VND");
        $('#totalAmount').text(pay.toLocaleString() + " VND");

        // Fix 1: update both point discount display elements
        $('#pointDiscountLabel').text("- " + point.toLocaleString() + " VND");
        $('#totalPointDiscount').text("- " + point.toLocaleString() + " VND");

        // cap the input at max usable so user can't over-enter
        const maxUsable = getMaxUsablePoint(total, discount);
        $('#requestedUsedPoints').attr('max', maxUsable);

        $('#shippingFee').val(shippingFee);

        if (useShipping && total > 0) {
            calculateShippingFee();
        }
    }

    // Cập nhật thông tin thanh toán (không tính lại phí vận chuyển)
    function updatePaymentInfoWithoutRecalculation() {
        let gh = gioHangs[currentGioHang];
        let total = gh && gh.products ? gh.products.reduce((sum, p) => sum + p.thanhTien, 0) : 0;
        let discount = discountValue || 0;
        let pointUsed = getRequestedPointForUse();
        let point = pointUsed * moneyPerPoint;
        let pay = total - discount - point + shippingFee;
        if (pay < 0) pay = 0;

        $('#goodsAmount').text(total.toLocaleString() + " VND");
        $('#discountAmount').text("- " + discount.toLocaleString() + " VND");
        $('#totalAmount').text(pay.toLocaleString() + " VND");

        // Fix 1: same update here
        $('#pointDiscountLabel').text("- " + point.toLocaleString() + " VND");
        $('#totalPointDiscount').text("- " + point.toLocaleString() + " VND");

        const maxUsable = getMaxUsablePoint(total, discount);
        $('#requestedUsedPoints').attr('max', maxUsable);

        $('#shippingFee').val(shippingFee);
    }

