        $('#btnQrCameraToggle').click(function () {
            toggleQrCamera();
        });

        $('#btnQrUpload').click(function () {
            $('#qrFileInput').click();
        });

        $('#qrFileInput').on('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;
            if (typeof Html5Qrcode === 'undefined') {
                showError('Thư viện quét QR chưa tải xong. Vui lòng tải lại trang.');
                return;
            }
            stopQrCamera().then(function () {
                $('#btnQrCameraToggle').data('on', false);
                $('#btnQrCameraToggleText').text('Bật camera');
                $('#qrReader').empty();
                const h = new Html5Qrcode('qrReader');
                h.scanFile(file, true).then(function (decodedText) {
                    const text = (decodedText || '').trim();
                    try { h.clear(); } catch (x) { }
                    $('#qrCodeInput').val(text);
                    lookupProductByQrAndOpenQuantity(text);
                }).catch(function () {
                    showError('Không đọc được mã QR từ ảnh. Thử ảnh rõ nét hơn.');
                    try { h.clear(); } catch (x) { }
                });
            });
            e.target.value = '';
        });

        $('#qrScannerModal').on('hidden.bs.modal', function () {
            stopQrCamera();
            $('#btnQrCameraToggle').data('on', false);
            $('#btnQrCameraToggleText').text('Bật camera');
            $('#qrReader').empty();
        });

        // Cập nhật thông tin thanh toán ban đầu
        setTimeout(function () {
            if (gioHangs.length > 0) {
                updatePaymentInfo();
            }
        }, 1000);
    });

