    // Mở modal chọn địa chỉ có sẵn
    async function openAddressModal() {
        if (!selectedCustomer) {
            showWarning('Vui lòng chọn khách hàng trước!');
            return;
        }

        try {
            const response = await fetch(`/Admin/ClientBanHangTaiQuay/dia-chi-khach-hang/${selectedCustomer.id}`);
