<script>
    let gioHangs = [];
    let currentGioHang = 0;
    const maxGioHangs = 5;

    // Dữ liệu động
    let products = [];
    let customers = [];
    let lastRenderedCustomerList = []; // Danh sách đang hiển thị (full hoặc kết quả tìm kiếm) để chọn đúng
    let selectedCustomer = null;
    let discountValue = 0; // Giá trị giảm giá hiện tại
    let useShipping = false; // Có sử dụng giao hàng không
    let useGHN = false; // Địa chỉ từ API GHN (để tính phí ship chính xác)
    let usePoint = false;
    let moneyPerPoint = 1000;
    let maxPointsPerOrder = 0;
    let selectedPaymentCode;
    let shippingFee = 0;
    let isHandlingQrScan = false;
    let html5QrCodeInstance = null;
    let qrDecodeHandled = false;

    function getPointLimitByConfig(available) {
        if (maxPointsPerOrder > 0) {
            return Math.min(available, maxPointsPerOrder);
        }
        return available;
    }

    function getPointLimitByAmount(total, discount) {
        if (!moneyPerPoint || moneyPerPoint <= 0) {
            return 0;
        }
        const baseAmount = Math.max(0, (Number(total) || 0) - (Number(discount) || 0));
        return Math.floor(baseAmount / moneyPerPoint);
    }

    function getMaxUsablePoint(total, discount) {
        const available = Number(selectedCustomer?.point || 0);
        return Math.max(0, Math.min(getPointLimitByConfig(available), getPointLimitByAmount(total, discount)));
    }


    function resetKhachHangForm() {
    // Xóa input text
    document.querySelectorAll('#khachHangForm input[type="text"], #khachHangForm input[type="email"]').forEach(el => el.value = '');

    // Xóa textarea
    document.querySelectorAll('#khachHangForm textarea').forEach(el => el.value = '');

    // Reset select
    document.querySelectorAll('#khachHangForm select').forEach(el => el.selectedIndex = 0);

    // Tắt checkbox giao hàng
    const giaoHangCheckbox = document.querySelector('#GiaoHang');
    if (giaoHangCheckbox) {
        giaoHangCheckbox.checked = false;
    }

    // Xóa địa chỉ hiển thị
    const diaChiContainer = document.querySelector('#diaChiContainer');
    if (diaChiContainer) {
        diaChiContainer.innerHTML = '';
    }

    // Reset text hiển thị địa chỉ
    const diaChiFull = document.querySelector('#DiaChiDayDu');
    if (diaChiFull) {
        diaChiFull.value = '';
    }
}
    // Toast Notification System
    function showToast(message, type = 'success', duration = 4000) {
        const toastContainer = document.getElementById('toastContainer');
        const toastId = 'toast_' + Date.now();

        const icons = {
            success: '✓',
            error: '✕',
            warning: '⚠',
            info: 'ℹ'
        };

        const titles = {
            success: 'Thành công',
            error: 'Lỗi',
            warning: 'Cảnh báo',
            info: 'Thông tin'
        };

        const toast = document.createElement('div');
        toast.id = toastId;
        toast.className = `custom-toast ${type}`;
        toast.innerHTML = `
                    <div class="toast-header">
                        <div class="toast-icon ${type}">${icons[type] || icons.info}</div>
                        <div class="toast-title">${titles[type] || titles.info}</div>
                        <button class="toast-close" onclick="closeToast('${toastId}')">&times;</button>
                    </div>
                    <div class="toast-body">${message}</div>
                    <div class="toast-progress">
                        <div class="toast-progress-bar"></div>
                    </div>
                `;

        toastContainer.appendChild(toast);

        // Trigger animation
        setTimeout(() => {
            toast.classList.add('show');
        }, 10);

        // Start progress bar animation
        const progressBar = toast.querySelector('.toast-progress-bar');
        setTimeout(() => {
            progressBar.style.transition = `transform ${duration}ms linear`;
            progressBar.style.transform = 'translateX(0)';
        }, 100);

        // Auto remove
        setTimeout(() => {
            closeToast(toastId);
        }, duration);

        return toastId;
    }

    function closeToast(toastId) {
        const toast = document.getElementById(toastId);
        if (toast) {
            toast.style.transform = 'translateX(400px)';
            toast.style.opacity = '0';
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.parentNode.removeChild(toast);
                }
            }, 300);
        }
    }

    // Convenience functions
    function showSuccess(message, duration = 4000) {
        return showToast(message, 'success', duration);
    }

    function showError(message, duration = 5000) {
        return showToast(message, 'error', duration);
    }

    function showWarning(message, duration = 4500) {
        return showToast(message, 'warning', duration);
    }

    function showInfo(message, duration = 4000) {
        return showToast(message, 'info', duration);
    }

    // Load sản phẩm từ API
    function loadProducts(callback) {
        $.get('/Admin/ClientBanHangTaiQuay/danh-sach-san-pham', function (data) {
            products = data;
            if (callback) callback();
        });
    }

    function upsertProductCache(product) {
        if (!product || !product.id) return;
        const existingIndex = products.findIndex(p => p.id === product.id);
        if (existingIndex >= 0) {
            products[existingIndex] = { ...products[existingIndex], ...product };
        } else {
            products.push(product);
        }
    }

    function stopQrCamera() {
        if (!html5QrCodeInstance) return Promise.resolve();
        return html5QrCodeInstance.stop().then(function () {
            html5QrCodeInstance.clear();
            html5QrCodeInstance = null;
        }).catch(function () {
            try {
                if (html5QrCodeInstance) html5QrCodeInstance.clear();
            } catch (e) { }
            html5QrCodeInstance = null;
        });
    }

    function startQrCamera() {
        if (typeof Html5Qrcode === 'undefined') {
            showError('Thư viện quét QR chưa tải xong. Vui lòng tải lại trang.');
            return;
        }
        stopQrCamera().then(function () {
            $('#qrReader').empty();
            html5QrCodeInstance = new Html5Qrcode('qrReader');
            Html5Qrcode.getCameras().then(function (cameras) {
                if (!cameras || cameras.length === 0) {
                    showError('Không tìm thấy camera trên thiết bị.');
                    html5QrCodeInstance = null;
                    return;
                }
                const cameraId = cameras[0].id;
                html5QrCodeInstance.start(
                    cameraId,
                    { fps: 10, qrbox: { width: 250, height: 250 } },
                    function (decodedText) {
                        if (qrDecodeHandled) return;
                        const text = (decodedText || '').trim();
                        if (!text) return;
                        qrDecodeHandled = true;
                        stopQrCamera().then(function () {
                            $('#btnQrCameraToggle').data('on', false);
                            $('#btnQrCameraToggleText').text('Bật camera');
                            $('#qrCodeInput').val(text);
                            lookupProductByQrAndOpenQuantity(text);
                        });
                    },
                    function () { }
                ).then(function () {
                    $('#btnQrCameraToggle').data('on', true);
                    $('#btnQrCameraToggleText').text('Tắt camera');
                }).catch(function (err) {
                    showError('Không bật được camera: ' + (err && err.message ? err.message : err));
                    html5QrCodeInstance = null;
                });
            }).catch(function () {
                showError('Không đọc được danh sách camera.');
                html5QrCodeInstance = null;
            });
        });
    }

    function toggleQrCamera() {
        const on = $('#btnQrCameraToggle').data('on');
        if (on) {
            stopQrCamera().then(function () {
                $('#btnQrCameraToggle').data('on', false);
                $('#btnQrCameraToggleText').text('Bật camera');
            });
        } else {
            qrDecodeHandled = false;
            startQrCamera();
        }
    }

    function openQrScannerModal() {
        qrDecodeHandled = false;
        $('#qrCodeInput').val('');
        $('#qrLastResult').text('');
        stopQrCamera().then(function () {
            $('#btnQrCameraToggle').data('on', false);
            $('#btnQrCameraToggleText').text('Bật camera');
            $('#qrReader').empty();
        });
        $('#qrScannerModal').modal('show');
        setTimeout(function () {
            $('#qrCodeInput').trigger('focus');
        }, 250);
    }

    /** Gọi API theo mã QR, sau đó đóng modal QR và mở popup nhập số lượng (1..tồn). */
    function lookupProductByQrAndOpenQuantity(qrCode) {
        if (gioHangs.length === 0) {
            showWarning('Vui lòng tạo giỏ hàng trước!');
            qrDecodeHandled = false;
            return;
        }

        const code = (qrCode || '').trim();
        if (!code) {
            showWarning('Vui lòng nhập hoặc quét mã QR.');
            qrDecodeHandled = false;
            return;
        }

        if (isHandlingQrScan) return;
        isHandlingQrScan = true;
        $('#btnQrScan').prop('disabled', true);

        $.get('/Admin/ClientBanHangTaiQuay/tim-san-pham-theo-qr', { qrCode: code }, function (product) {
            upsertProductCache(product);
            $('#qrLastResult').html(`<span class="text-success">Đã nhận diện: <b>${product.name || 'Sản phẩm'}</b></span>`);
            $('#qrScannerModal').one('hidden.bs.modal', function () {
                showQuantityModal(product.id);
            });
            $('#qrScannerModal').modal('hide');
            $('#qrCodeInput').val('');
        }).fail(function (xhr) {
            let msg = 'Không tìm thấy sản phẩm từ mã QR.';
            if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
            else if (xhr.responseText) {
                try {
                    const obj = JSON.parse(xhr.responseText);
                    if (obj.message) msg = obj.message;
                    else msg = xhr.responseText;
                } catch {
                    msg = xhr.responseText;
                }
            }
            $('#qrLastResult').html(`<span class="text-danger">${msg}</span>`);
            showError(msg);
        }).always(function () {
            isHandlingQrScan = false;
            $('#btnQrScan').prop('disabled', false);
            qrDecodeHandled = false;
            $('#qrCodeInput').trigger('focus');
        });
    }

    // Load khách hàng từ API
    function loadCustomers(callback) {
        $.get('/Admin/ClientBanHangTaiQuay/danh-sach-khach-hang', function (data) {
            customers = data;
            if (callback) callback();
        });
    }

    // Tìm kiếm khách hàng (theo tên hoặc SĐT)
    function searchCustomer() {
        let q = ($('#searchCustomer').val() || '').trim();
        if (!q) {
            lastRenderedCustomerList = customers;
            renderCustomerList(customers);
            return;
        }
        $.get('/Admin/ClientBanHangTaiQuay/tim-kiem-khach-hang', { query: q }, function (data) {
            lastRenderedCustomerList = Array.isArray(data) ? data : [];
            renderCustomerList(lastRenderedCustomerList);
        }).fail(function () {
            lastRenderedCustomerList = [];
            renderCustomerList([]);
        });
    }

    // Chọn khách vãng lai (không lưu DB, chỉ dùng cho đơn này)
    function selectGuestCustomer() {
        selectedCustomer = { id: null, name: 'Khách vãng lai', phone: '', email: '', point: 0, isGuest: true };
        $('#customerModal').modal('hide');
        $('#customerName').text(selectedCustomer.name).removeClass('bg-secondary').addClass('bg-warning text-dark');
        $('#customerDetails').show();
        $('#customerPhone').text('—');
        $('#customerEmail').text('—');
        $('#customerPoint').text('0');
        $('#requestedUsedPoints').val(0).attr('max', 0);
        $('#pointSwitch').prop('checked', false);
        usePoint = false;
        $('#btnClearCustomer').show();
        $('#btnShowAddress').hide();
        $('#btnAddAddress').hide();
        $('#discountCode').val('');
        discountValue = 0;
        if (useShipping) {
            $('#shippingFormCard').show();
        }
        updatePaymentInfo();
    }

    // Thêm khách hàng mới (form trong modal) — lưu DB rồi chọn
    function submitNewCustomer() {
        let name = ($('#newCustomerName').val() || '').trim();
        let phone = ($('#newCustomerPhone').val() || '').trim();
        if (!name || !phone) {
            showWarning('Vui lòng nhập tên và số điện thoại.');
            return;
        }
        $.ajax({
            url: '/Admin/ClientBanHangTaiQuay/them-khach-hang',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ tenKhachHang: name, soDienThoai: phone }),
            success: function (res) {
                showSuccess('Thêm khách hàng thành công!');
                $('#newCustomerName').val('');
                $('#newCustomerPhone').val('');
                $('#addCustomerForm').collapse('hide');
                loadCustomers(function () {
                    lastRenderedCustomerList = customers;
                    renderCustomerList(customers);
                    var found = customers.find(function (c) { return c.phone === phone; });
                    if (found) selectCustomer(found.id);
                });
            },
            error: function (xhr) {
                var msg = (xhr.responseJSON && xhr.responseJSON.message) || xhr.responseText || 'Thêm khách hàng thất bại.';
                showError(typeof msg === 'string' ? msg : 'Số điện thoại có thể đã tồn tại.');
            }
        });
    }

    // Áp dụng mã giảm giá
    function applyDiscount() {
        if (!selectedCustomer) {
            showWarning('Vui lòng chọn khách hàng trước khi chọn phiếu giảm giá!');
            return;
        }
        if (selectedCustomer.isGuest) {
            showWarning('Khách vãng lai không có phiếu giảm giá. Chọn khách có tài khoản để dùng phiếu.');
            return;
        }
        loadCustomerDiscountVouchers();
    }
    function tinhTienGiam(v, tongTien) {
        let discount = 0;

        if (v.giaTriGiam <= 100) {
            // % giảm
            discount = tongTien * v.giaTriGiam / 100;
        } else {
            // giảm thẳng
            discount = v.giaTriGiam;
        }

        // áp trần
        if (v.giaTriGiamToiDa) {
            discount = Math.min(discount, v.giaTriGiamToiDa);
        }

        return discount;
    }
    // Load danh sách phiếu giảm giá của khách hàng
    // Load danh sách phiếu giảm giá của khách hàng
    // Load danh sách phiếu giảm giá của khách hàng
    let isLoadingVoucher = false;

    // 🔥 tính tiền giảm thực tế
    function tinhTienGiam(v, tongTien) {
        let discount = 0;

        if (v.giaTriGiam <= 100) {
            // % giảm
            discount = tongTien * v.giaTriGiam / 100;
        } else {
            // giảm thẳng
            discount = v.giaTriGiam;
        }

        // áp trần
        if (v.giaTriGiamToiDa) {
            discount = Math.min(discount, v.giaTriGiamToiDa);
        }

        return discount;
    }

    function loadCustomerDiscountVouchers() {

        if (!selectedCustomer || selectedCustomer.isGuest || !selectedCustomer.id) return;
        if (isLoadingVoucher) return;

        let gh = gioHangs[currentGioHang];
        let tongTien = (gh && gh.products)
            ? gh.products.reduce((sum, p) => sum + p.thanhTien, 0)
            : 0;

        console.log("Tổng tiền gửi lên:", tongTien);

        isLoadingVoucher = true;

        $.get('/Admin/ClientBanHangTaiQuay/danh-sach-phieu-giam-gia-khach-hang', {
            customerId: selectedCustomer.id,
            tongTien: tongTien
        }, function (data) {

            console.log("Voucher response:", data);

            if (data && data.length > 0) {

                // ✅ dùng toàn bộ list (KHÔNG filter)
                let finalVouchers = [...data];

                // reset best
                finalVouchers.forEach(v => v.isBest = false);

                // 🔥 SORT CHUẨN NHẤT
                finalVouchers.sort((a, b) => {

                    // 1. Ưu tiên dùng được
                    if (a.hopLe !== b.hopLe) return b.hopLe - a.hopLe;

                    // 2. 🔥 giảm thực tế
                    let giamA = tinhTienGiam(a, tongTien);
                    let giamB = tinhTienGiam(b, tongTien);

                    if (giamA !== giamB) return giamB - giamA;

                    // 3. gần đạt đơn tối thiểu
                    let lechA = Math.abs((a.donToiThieu || 0) - tongTien);
                    let lechB = Math.abs((b.donToiThieu || 0) - tongTien);

                    if (lechA !== lechB) return lechA - lechB;

                    // 4. còn nhiều lượt
                    if (a.soLuongConLai !== b.soLuongConLai)
                        return b.soLuongConLai - a.soLuongConLai;

                    // 5. sắp hết hạn
                    return new Date(a.ngayKetThuc) - new Date(b.ngayKetThuc);
                });

                // 🥇 đánh dấu tốt nhất
                if (finalVouchers.length > 0) {
                    finalVouchers[0].isBest = true;
                }

                renderVoucherList(finalVouchers);

                $('#voucherList').show();
                $('#noVoucherMessage').hide();

            } else {
                $('#voucherList').hide();
                $('#noVoucherMessage').show();
            }

            $('#discountVoucherModal').modal('show');

            isLoadingVoucher = false;

        }).fail(function (err) {
            console.log("API ERROR:", err.responseText);
            showError('Lỗi khi tải danh sách phiếu giảm giá!');
            isLoadingVoucher = false;
        });
    }

