        $('#confirmPaymentModal').modal('hide');
    }

    function payInvoice() {
        let gh = gioHangs[currentGioHang];
        if (!gh || !gh.products || gh.products.length === 0) return showError('Không có sản phẩm trong giỏ hàng!');
        if (!validateShippingAddressForPayment()) return;

        // API cần MÃ phương thức (MaPhuongThuc, vd: "cash", "bank") chứ không phải tên hiển thị
        let paymentMethodCode = ($('#paymentMethod').val() || selectedPaymentCode || 'cash').trim();
        let customerPaid = parseInt($('#modalCustomerPaid').val()) || 0;
        let pay = parseInt($('#totalAmount').text().replace(/\D/g, '')) || 0;

        if (customerPaid < pay) {
            showError('Khách đưa chưa đủ tiền!');
            return;
        }

        const tinhText = $('#shipTinh option:selected').text() || '';
        const quanText = $('#shipQuan option:selected').text() || '';
        const shipQuanVal = $('#shipQuan').val();
        const shipPhuongVal = $('#shipPhuong').val();
        const parsedDistrictId = parseInt(shipQuanVal, 10);
        const hasValidDistrictId = Number.isFinite(parsedDistrictId) && parsedDistrictId > 0;
        const hasValidWardCode = !!(shipPhuongVal && shipPhuongVal !== '0');

        const pointSwitchOn = $('#pointSwitch').is(':checked') && selectedCustomer && !selectedCustomer.isGuest;
        const rawPointReq = parseInt($('#requestedUsedPoints').val(), 10);
        let requestedPtsForApi = 0;
        let usePointForApi = false;
        if (pointSwitchOn) {
            usePointForApi = true;
            requestedPtsForApi = (Number.isFinite(rawPointReq) && rawPointReq > 0)
                ? getRequestedPointForUse()
                : null;
        }

        // Dữ liệu gửi đi (khách vãng lai: lấy tên/SĐT từ form giao hàng nếu có)
        let dto = {
            idGioHang: gh.id,
            customerId: (selectedCustomer && !selectedCustomer.isGuest && selectedCustomer.id) ? selectedCustomer.id : null,
            customerName: selectedCustomer ? (selectedCustomer.isGuest ? ($('#shipName').val() || 'Khách vãng lai') : selectedCustomer.name) : ($('#shipName').val() || ''),
            customerPhone: selectedCustomer ? (selectedCustomer.isGuest ? $('#shipPhone').val() : selectedCustomer.phone) : $('#shipPhone').val(),
            customerEmail: selectedCustomer ? (selectedCustomer.isGuest ? $('#shipEmail').val() : selectedCustomer.email) : $('#shipEmail').val(),
            address: $('#shipAddress').val(),
            discountCode: $('#discountCode').val(),
            usePoint: usePointForApi,
            requestedUsedPoints: requestedPtsForApi,
            shipping: useShipping,
            paymentMethod: paymentMethodCode,
            customerPaid: customerPaid,
            shippingFee: shippingFee,
            province: tinhText && tinhText !== 'Tỉnh Thành' ? tinhText : '',
            district: quanText && quanText !== 'Quận Huyện' ? quanText : '',
            toDistrictId: hasValidDistrictId ? parsedDistrictId : null,
            toWardCode: hasValidWardCode ? String(shipPhuongVal) : null,
            weight: (hasValidDistrictId && hasValidWardCode) ? 500 : null,
            shippingFeeSource: 'Config'
        };

        // Nếu chọn chuyển khoản/thẻ (VNPay): theo mã thường là "vnpay", "bank", "chuyển khoản", "thẻ"
        const codeLower = paymentMethodCode.toLowerCase();
        const isPosVnpay = codeLower === 'vnpay' || codeLower === 'bank' || codeLower === 'chuyển khoản' || codeLower === 'thẻ' || codeLower === 'chuyenkhoan';
        if (isPosVnpay) {
            const paymentInfo = {
                orderType: 'billpayment',
                amount: pay,
                orderDescription: `Thanh toan don POS ${dto.customerName}`,
                name: dto.customerName || 'Khach POS'
            };
            fetch('/Admin/ClientBanHangTaiQuay/vnpay/init', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(paymentInfo)
            }).then(r => r.json()).then(res => {
                if (res && res.success && res.paymentUrl) {
                    // Lưu tạm order để callback có thể đọc (tạo đơn sau callback)
                    sessionStorage.setItem('POS_PendingDTO', JSON.stringify(dto));
                    window.location.href = res.paymentUrl;
                } else {
                    showError('Không tạo được URL thanh toán VNPay.');
                }
            }).catch(() => showError('Lỗi khi khởi tạo thanh toán VNPay.'));
            return;
        }

        $.ajax({
            url: '/Admin/ClientBanHangTaiQuay/chuyen-gio-hang-thanh-hoa-don',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dto),
            success: function (res) {
                showSuccess('Thanh toán thành công!');
                // RESET KHÁCH HÀNG
                clearCustomerForm();

                // Tắt giao hàng
                $('#shippingSwitch').prop('checked', false);

                // 🔥 Reset luôn biến control
                useShipping = false;

                toggleShipping();

                $('#confirmPaymentModal').modal('hide');
                // Xóa giỏ hàng đã thanh toán
                gioHangs.splice(currentGioHang, 1);
                if (gioHangs.length === 0) {
                    taoGioHang();
                } else {
                    currentGioHang = Math.max(0, currentGioHang - 1);
                }

                // Cập nhật localStorage
                saveGioHangsToStorage();
                renderTabs();
                loadGioHang();
                clearDiscount();
            },
            error: function (xhr) {
                let msg = 'Thanh toán thất bại!';
                try {
                    if (xhr.responseJSON && xhr.responseJSON.message) msg = xhr.responseJSON.message;
                    else if (xhr.responseText) {
                        var o = JSON.parse(xhr.responseText);
                        if (o.message) msg = o.message;
                    }
                } catch (e) { }
                showError(msg);
            }
        });
    }

