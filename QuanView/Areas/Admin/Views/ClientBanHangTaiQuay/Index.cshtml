    // Chọn phiếu giảm giá
    function selectVoucher(code, giaTriGiam, giaTriGiamToiDa, donToiThieu) {
        let gh = gioHangs[currentGioHang];
        if (!gh || !gh.products) {
            showWarning('Không có giỏ hàng nào được chọn!');
            return;
        }

        let total = gh.products.reduce((sum, p) => sum + p.thanhTien, 0);

        // Kiểm tra đơn tối thiểu
        if (total < donToiThieu) {
            showWarning(`Đơn hàng phải có giá trị tối thiểu ${donToiThieu.toLocaleString()} VND để sử dụng phiếu này! Hiện tại: ${total.toLocaleString()} VND`);
            return;
        }

        // Tính toán giảm giá
        let discountAmount = (total * giaTriGiam / 100);
        if (discountAmount > giaTriGiamToiDa) {
            discountAmount = giaTriGiamToiDa;
        }

        // Cập nhật giao diện
        $('#discountCode').val(code);
        discountValue = discountAmount;

        // Đóng modal
        $('#discountVoucherModal').modal('hide');

        // Cập nhật thông tin thanh toán
        updatePaymentInfo();

        showSuccess(`Đã áp dụng phiếu giảm giá ${code}! Giảm ${discountAmount.toLocaleString()} VND`);
    }

    // Xóa phiếu giảm giá
    function clearDiscount() {
        $('#discountCode').val('');
        discountValue = 0;
        updatePaymentInfo();
    }

    function validateShippingAddressForPayment() {
        if (!useShipping) {
            return true;
        }

        const shipTinh = $('#shipTinh').val();
        const shipQuan = $('#shipQuan').val();
        const shipPhuong = $('#shipPhuong').val();
        const shipDiaChiChiTiet = ($('#shipDiaChiChiTiet').val() || '').trim();
        const fullAddress = ($('#shipAddress').val() || '').trim();

        if (!shipTinh || shipTinh === '0') {
            showWarning('Vui lòng chọn Tỉnh/Thành để giao hàng.');
            return false;
        }

        if (!shipQuan || shipQuan === '0') {
            showWarning('Vui lòng chọn Quận/Huyện để giao hàng.');
            return false;
        }

        if (!shipPhuong || shipPhuong === '0') {
            showWarning('Vui lòng chọn Phường/Xã để giao hàng.');
            return false;
        }

        if (!shipDiaChiChiTiet) {
            showWarning('Vui lòng nhập số nhà, tên đường để giao hàng.');
            return false;
        }

        if (!fullAddress) {
            showWarning('Vui lòng nhập đầy đủ địa chỉ giao hàng trước khi thanh toán.');
            return false;
        }

        return true;
    }

    // Thanh toán hóa đơn
    function openPaymentModal() {
        if (!validateShippingAddressForPayment()) {
            return;
        }

        let pay = $('#totalAmount').text();
        $('#modalPayAmount').text(pay);
        $('#modalCustomerPaid').val(pay.replace(/\D/g, ''));
        // Đặt lại phương thức thanh toán trong modal theo ngoài giao diện
        let currentMethod = $('#selectedPaymentMethod').text().trim();
        $('#paymentMethod').val(
            currentMethod === "Tiền mặt" ? "cash" :
                currentMethod === "Chuyển khoản" ? "bank" :
                    currentMethod === "Thẻ" ? "card" : "cash"
        );
        updateModalChangeAmount();
        $('#confirmPaymentModal').modal('show');
    }

    // Lưu tất cả giỏ hàng vào localStorage
    function saveGioHangsToStorage() {
        const gioHangData = {
            gioHangs: gioHangs.map(gh => ({ id: gh.id, ma: gh.ma })),
            currentGioHang: currentGioHang
        };
        localStorage.setItem('gioHangData', JSON.stringify(gioHangData));
    }

    // Tạo giỏ hàng mới
    function taoGioHang() {
        if (gioHangs.length >= maxGioHangs) {
            showWarning('Chỉ được tối đa 5 giỏ hàng chờ!');
            return;
        }
        const dto = {
            idKhachHang: (selectedCustomer && !selectedCustomer.isGuest && selectedCustomer.id) ? selectedCustomer.id : null,
            nguoiTao: "Admin"
        };

        $.ajax({
            url: '/Admin/ClientBanHangTaiQuay/tao-gio-hang',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(dto),
            success: function (res) {
                const gioHang = {
                    id: res.idGioHang,
                    ma: res.maGioHang,
                    products: []
                };
                gioHangs.push(gioHang);
                currentGioHang = gioHangs.length - 1;

                saveGioHangsToStorage();
                renderTabs();
                loadGioHang();
                showSuccess('Đã tạo giỏ hàng mới!');
            },
            error: function () {
                showError('Tạo giỏ hàng thất bại!');
            }
        });
    }

    function renderTabs() {
        let html = '';
        gioHangs.forEach((gh, idx) => {
            const isActive = idx === currentGioHang;
            const productCount = gh.products ? gh.products.length : 0;

            html += `
                <li class="nav-item">
                    <a class="nav-link ${isActive ? 'active' : ''}" href="#" 
                    onclick="switchGioHang(${idx}); event.preventDefault();">
                        Giỏ hàng ${idx + 1}
                        ${productCount > 0 ? `<span class="badge bg-danger ms-1">${productCount}</span>` : ''}
                        
                        <span class="tab-close" onclick="event.stopImmediatePropagation(); closeTab(${idx});" 
                            title="Đóng giỏ hàng">×</span>
                    </a>
                </li>`;
        });

        $('#invoiceTabs').html(html);
    }
    function closeTab(index) {
        if (gioHangs.length <= 1) {
            showWarning("Phải giữ ít nhất một giỏ hàng!");
            return;
        }

        // Remove the cart
        gioHangs.splice(index, 1);

        // Adjust current index
        if (currentGioHang >= index) {
            currentGioHang = Math.max(0, currentGioHang - 1);
        }

        saveGioHangsToStorage();
        renderTabs();
        loadGioHang();
    }
    function addMiddleClickSupport() {
        $(document).on('mousedown', '.nav-tabs .nav-link', function (e) {
            if (e.button === 1) { // Middle mouse button
                e.preventDefault();
                const index = $(this).parent().index();
                if (index !== -1) {
                    closeTab(index);
                }
            }
        });
    }

    // Chuyển giỏ hàng
    function switchGioHang(idx) {
        currentGioHang = idx;
        saveGioHangsToStorage();
        renderTabs();
        loadGioHang();
    }

    // Load thông tin giỏ hàng từ server
    function loadGioHang() {
        if (gioHangs.length === 0 || !gioHangs[currentGioHang]) return;

        const gioHang = gioHangs[currentGioHang];
        $.get(`/Admin/ClientBanHangTaiQuay/gio-hang/${gioHang.id}`, function (data) {
            gioHang.products = data.sanPhams || [];
            renderGioHang();
            updatePaymentInfo(); // Cập nhật thông tin thanh toán
        }).fail(function () {
            showError('Lỗi khi tải thông tin giỏ hàng!');
        });
    }

