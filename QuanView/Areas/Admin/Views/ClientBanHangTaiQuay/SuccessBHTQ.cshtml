@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var orderJson = TempData["OrderJson"] as string;
}

<style>
    /* Custom Receipt Styling */
    .receipt-card {
        border: none;
        border-radius: 15px;
        background-color: #fff;
    }
    .receipt-header {
        text-align: center;
        padding-bottom: 20px;
        border-bottom: 2px dashed #eee;
    }
    .item-list {
        list-style: none;
        padding: 0;
        margin: 20px 0;
    }
    .item-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        color: #444;
    }
    .item-name {
        flex: 1;
        padding-right: 10px;
        font-size: 0.95rem;
    }
    .item-price {
        font-weight: 500;
    }
    .summary-section {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 0.9rem;
        color: #666;
    }
    .total-row {
        display: flex;
        justify-content: space-between;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #ddd;
        font-size: 1.2rem;
        font-weight: 700;
        color: #0d6efd;
    }
    .info-label { color: #888; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .info-value { font-weight: 600; color: #333; }

    @@media print {
        .btn, .navbar, .sidebar { display: none !important; }
        .card { border: none !important; shadow: none !important; }
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm receipt-card">
                <div class="card-body p-5">
                    <div class="receipt-header mb-4">
                        <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center mb-3" style="width:60px;height:60px;">
                            <i class="bi bi-check2-all" style="font-size:30px;"></i>
                        </div>
                        <h3 class="fw-bold">Thanh toán thành công</h3>
                        <p class="text-muted small">Cảm ơn bạn đã mua sắm tại GZ Shop</p>
                    </div>

                    <div id="order-detail">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4 no-print">
                        <a class="btn btn-primary px-4" href="@Url.Action("Index", "ClientBanHangTaiQuay", new { area = "Admin" })">
                            <i class="bi bi-cart-plus me-2"></i>&nbsp;&nbsp;Bán tiếp
                        </a>
                        &nbsp;&nbsp;
                        <button class="btn btn-outline-dark px-4" onclick="window.print()">
                            <i class="bi bi-printer me-2"></i>&nbsp;&nbsp;In hóa đơn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function renderOrder(data) {
        const container = document.getElementById('order-detail');
        
        const tamTinh = (data.chiTietHoaDons || []).reduce((sum, ct) => sum + (ct.thanhTien || 0), 0);
        const phiShip = data.phiVanChuyen || 0;
        const giamGia = (data.tienGiam || 0) + (data.soTienGiamTuDiem || 0);
        const tongCong = data.tongTien || 0;

        const formatVN = (v) => v.toLocaleString('vi-VN') + ' đ';

        let itemHtml = '';
        (data.chiTietHoaDons || []).forEach(ct => {
            const name = ct.sanPhamChiTiet?.sanPham?.tenSanPham || 'Sản phẩm';
            const attr = `${ct.sanPhamChiTiet?.kichCo?.tenKichCo ? 'Size ' + ct.sanPhamChiTiet.kichCo.tenKichCo : ''} ${ct.sanPhamChiTiet?.mauSac?.tenMauSac ? '| ' + ct.sanPhamChiTiet.mauSac.tenMauSac : ''}`;
            
            itemHtml += `
                <div class="item-row">
                    <div class="item-name">
                        <div class="fw-bold">${name}</div>
                        <small class="text-muted">${attr}</small>
                    </div>
                    <div class="item-price">${formatVN(ct.thanhTien)}</div>
                </div>`;
        });

        container.innerHTML = `
            <div class="row mb-4">
                <div class="col-6 mb-2">
                    <div class="info-label">Mã hóa đơn</div>
                    <div class="info-value">#${data.maHoaDon || '---'}</div>
                </div>
                <div class="col-6 mb-2 text-end">
                    <div class="info-label">Ngày tạo</div>
                    <div class="info-value">${new Date().toLocaleDateString('vi-VN')}</div>
                </div>
                <div class="col-12">
                    <div class="info-label">Khách hàng</div>
                    <div class="info-value">${data.khachHang?.tenKhachHang || data.tenNguoiNhan || 'Khách lẻ'}</div>
                </div>
            </div>

            <div class="item-list border-top pt-3">
                ${itemHtml}
            </div>

            <div class="summary-section">
                <div class="summary-row">
                    <span>Tạm tính</span>
                    <span>${formatVN(tamTinh)}</span>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span>${formatVN(phiShip)}</span>
                </div>
                <div class="summary-row text-danger">
                    <span>Giảm giá</span>
                    <span>-${formatVN(giamGia)}</span>
                </div>
                <div class="total-row">
                    <span>Tổng cộng</span>
                    <span>${formatVN(tongCong)}</span>
                </div>
            </div>
        `;
    }

    (async function(){
        const raw = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(orderJson));
        if (raw) {
            try { await renderOrder(JSON.parse(raw)); return; } catch(e) {}
        }

        const pending = sessionStorage.getItem('POS_PendingDTO');
        if (!pending) {
            document.getElementById('order-detail').innerHTML = '<div class="alert alert-info">Dữ liệu trống.</div>';
            return;
        }

        try {
            const dto = JSON.parse(pending);
            const res = await fetch('/Admin/ClientBanHangTaiQuay/chuyen-gio-hang-thanh-hoa-don', {
                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(dto)
            });
            const created = await res.json();
            const detailRes = await fetch(`/Admin/ClientBanHangTaiQuay/hoa-don/${created.idHoaDon}`);
            const detail = await detailRes.json();
            await renderOrder(detail);
            sessionStorage.removeItem('POS_PendingDTO');
        } catch (e) {
            document.getElementById('order-detail').innerHTML = '<div class="alert alert-danger">Lỗi xử lý hóa đơn.</div>';
        }
    })();
</script>