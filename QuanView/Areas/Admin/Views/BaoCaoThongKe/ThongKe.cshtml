</style>

@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
	<script type="text/javascript">
		/*
			PSEUDOCODE / DETAILED PLAN (placed here as requested):
			- Goal: Remove anchor wrappers for dropdown items but still allow clicking a product to open its update page.
			- Approach:
			  1. Render dropdown items as plain div.item elements with a `data-id` attribute (already implemented).
			  2. Introduce a configurable base URL `productEditBase` that will be prefixed to the product id to form the update URL.
				 - Example: '/Admin/SanPham/Edit/' + id  -> '/Admin/SanPham/Edit/123'
				 - Maintainers can change `productEditBase` if routing differs (e.g. '/Admin/SanPham/CapNhat/').
			  3. Attach a delegated click handler to capture clicks on any `.item` inside `#sapHetHangList`, `#hetHangList`, `#daBanList`.
				 - On click: read `data-id`; if present, navigate to `productEditBase + encodeURIComponent(id)`.
				 - This keeps markup anchor-free but restores navigation behavior.
			  4. Keep existing helpers and render logic intact (number formatting, escaping).
			  5. Ensure click handler executes regardless of when items are injected (use event delegation on `document`).
			  6. Do not open new tabs; navigate in same window. Consumers can modify to use `_blank` if desired.
		*/

		$(document).ready(function () {
			// API base - define once so all internal functions can access it
			var api = '/api/ChartsApi';

			// Configurable base for product edit/update route.
			// Change this to match your application's route if different.
			var productEditBase = '/Admin/SanPham/Edit/';
			var quickDetailData = { sold: [], low: [], out: [] };

			// Formatting helpers (available to all functions inside this ready block)
			function fmtVnd(n) { return (n || 0).toLocaleString('vi-VN') + ' đ'; }
			function fmtNum(n) { return (n || 0).toLocaleString('vi-VN'); }
			function num(n) { return (n || 0).toLocaleString('vi-VN'); }
			function escapeHtml(s) {
				return String(s || '').replace(/[&<>"'\/]/g, function (ch) {
					return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;', '/': '&#x2F;' }[ch];
				});
			}

			// Delegated click handler: navigate to product update/edit page when a stock dropdown item is clicked
			$(document).on('click', '#sapHetHangList .item, #hetHangList .item', function (e) {
				if ($(e.target).closest('.detail-open').length) return;
				var id = $(this).attr('data-id') || $(this).data('id');
				if (!id) return;
				var url = productEditBase + encodeURIComponent(id);
				window.location.href = url;
			});

			$(document).on('click', '#daBanList .item', function (e) {
				e.preventDefault();
				e.stopPropagation();
				renderQuickDetail('sold');
			});

			$(document).on('click', '.detail-open', function (e) {
				e.preventDefault();
				e.stopPropagation();
				renderQuickDetail($(this).data('type'));
			});

			$(document).on('click', '.detail-card', function (e) {
				if ($(e.target).closest('.item, .detail-open').length) return;
				renderQuickDetail($(this).data('detail-type'));
			});

			$('#quickDetailClose').on('click', function () {
				$('#quickDetailSection').hide();
			});
			// KPI setters
			function setKpisFromSummary(data) {
				if (!data) return;
				$('#doanhThuHomNay').text(fmtVnd(data.todayRevenue));
				$('#doanhThuThang').text(fmtVnd(data.monthRevenue));
				$('#soLuongDaBan').text(fmtNum(data.monthProductQuantity) + ' sản phẩm');
				$('#soDonVanChuyenThang').text((data.monthShippingCount || 0) + ' đơn');
				$('#tongPhiVanChuyenThang').text(fmtVnd(data.monthShippingTotal));
				$('#soDonVanChuyenHomNay').text((data.todayShippingCount || 0) + ' đơn');
				$('#tongSoSanPham').text((data.totalProducts || 0) + ' sản phẩm');
				$('#tongSoLuongTonKho').text(fmtNum(data.totalQuantity));
				$('#sanPhamSapHetHang').text((data.lowStockProducts || 0) + ' biến thể');
				$('#sanPhamHetHang').text((data.outOfStockProducts || 0) + ' biến thể');
			}

			function setInventoryKpis(data) {
				if (!data) return;
				$('#tongSoSanPham').text((data.totalProducts || 0) + ' sản phẩm');
				$('#tongSoLuongTonKho').text(fmtNum(data.totalQuantity));
				$('#sanPhamSapHetHang').text((data.lowStockProducts || 0) + ' biến thể');
				$('#sanPhamHetHang').text((data.outOfStockProducts || 0) + ' biến thể');
			}

			function variantText(p) {
				var parts = [];
				if (p.maBienThe) parts.push(p.maBienThe);
				if (p.kichCo) parts.push('Size ' + p.kichCo);
				if (p.mauSac) parts.push(p.mauSac);
				if (p.hoaTiet) parts.push(p.hoaTiet);
				return parts.join(' - ');
			}

			function renderQuickDetail(type) {
				var data = quickDetailData[type] || [];
				var titleMap = { sold: 'Chi tiết sản phẩm đã bán', low: 'Chi tiết biến thể sắp hết hàng', out: 'Chi tiết biến thể hết hàng' };
				var metaMap = { sold: 'Bảng sản phẩm đã bán trong tháng', low: 'Bấm Sửa để cập nhật sản phẩm', out: 'Bấm Sửa để cập nhật sản phẩm' };
				var head = '';
				var body = '';
				$('#quickDetailTitle').text(titleMap[type] || 'Chi tiết');
				$('#quickDetailMeta').text((metaMap[type] || '') + ' - ' + data.length.toLocaleString('vi-VN') + ' dòng');
				if (type === 'sold') {
					head = '<tr><th class="row-index">STT</th><th>Sản phẩm</th><th class="text-right">Đã bán</th></tr>';
					body = data.map(function (p, index) {
						return '<tr><td class="row-index">' + (index + 1) + '</td>' +
							'<td>' + escapeHtml(p.tenSanPham || 'Không tên') + '</td>' +
							'<td class="text-right font-weight-bold">' + num(p.soLuong) + '</td></tr>';
					}).join('');
				} else {
					head = '<tr><th class="row-index">STT</th><th>Sản phẩm</th><th>Biến thể</th><th class="text-right">Tồn khả dụng</th><th class="text-right">Thao tác</th></tr>';
					body = data.map(function (p, index) {
						return '<tr><td class="row-index">' + (index + 1) + '</td>' +
							'<td>' + escapeHtml(p.tenSanPham || 'Không tên') + '</td>' +
							'<td>' + escapeHtml(variantText(p) || '-') + '</td>' +
							'<td class="text-right font-weight-bold">' + num(p.soLuong) + '</td>' +
							'<td class="text-right"><a class="btn btn-sm btn-outline-primary" href="' + productEditBase + encodeURIComponent(p.id) + '">Sửa</a></td></tr>';
					}).join('');
				}
				if (!body) body = '<tr><td colspan="' + (type === 'sold' ? 3 : 5) + '" class="text-muted text-center py-3">Không có dữ liệu</td></tr>';
				$('#quickDetailTable thead').html(head);
				$('#quickDetailTable tbody').html(body);
				$('#quickDetailSection').show();
				document.getElementById('quickDetailSection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			function loadKpisFallback() {
				$.get(api + '/today-revenue', function (v) { $('#doanhThuHomNay').text(fmtVnd(v)); });
				$.get(api + '/month-revenue', function (v) { $('#doanhThuThang').text(fmtVnd(v)); });
				$.get(api + '/month-product-quantity', function (v) { $('#soLuongDaBan').text(fmtNum(v) + ' sản phẩm'); });
				$.get(api + '/month-shipping-stats', function (res) {
					if (res && typeof res === 'object') {
						$('#soDonVanChuyenThang').text((res.count || 0) + ' đơn');
						$('#tongPhiVanChuyenThang').text(fmtVnd(res.totalShipping));
					}
				});
				$.get(api + '/today-shipping-stats', function (res) {
					if (res && typeof res === 'object') $('#soDonVanChuyenHomNay').text((res.count || 0) + ' đơn');
				});
				$.get(api + '/inventory-summary', function (res) {
					if (res && res.success && res.data) setInventoryKpis(res.data);
				});
			}

			// Dashboard loader (centralized)
			function loadDashboard() {
				$.get(api + '/dashboard-summary')
					.done(function (res) {
						if (res && res.success && res.data) setKpisFromSummary(res.data);
						else loadKpisFallback();
					})
					.fail(function () {
						loadKpisFallback();
					});
			}

			// Inventory donut chart + details
			function loadInventoryChart() {
				$.get(api + '/product-category-inventory')
					.done(function (res) {
						if (!res || !res.success || !res.data) {
							$('#inventoryDetails').html('<span class="text-muted">Không có dữ liệu</span>');
							return;
						}
						var chartData = res.data;
						var ctx = document.getElementById('inventoryChart');
						if (!ctx) return;

						// destroy existing chart instance if any
						if (typeof Chart !== 'undefined') {
							try {
								var existing = Chart.getChart(ctx);
								if (existing) existing.destroy();
							} catch (e) { /* ignore */ }
						}

						new Chart(ctx, {
							type: 'doughnut',
							data: {
								labels: chartData.labels || [],
								datasets: [{
									data: (chartData.datasets && chartData.datasets[0] && chartData.datasets[0].data) || [],
									backgroundColor: (chartData.datasets && chartData.datasets[0] && chartData.datasets[0].backgroundColor) || [],
									borderColor: (chartData.datasets && chartData.datasets[0] && chartData.datasets[0].borderColor) || [],
									borderWidth: (chartData.datasets && chartData.datasets[0] && chartData.datasets[0].borderWidth) || 2,
									hoverOffset: 4
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								plugins: {
									legend: { position: 'bottom', labels: { padding: 20, usePointStyle: true } },
									tooltip: {
										callbacks: {
											label: function (context) {
												var v = context.parsed || 0;
												var t = (context.dataset && context.dataset.data) ? context.dataset.data.reduce(function (a, b) { return a + b; }, 0) : 0;
												var p = t ? ((v / t) * 100).toFixed(1) : 0;
												return (context.label || '') + ': ' + (v || 0).toLocaleString('vi-VN') + ' SP (' + p + '%)';
											}
										}
									}
								},
								cutout: '50%'
							}
						});

						// details rendering
						var details = chartData.details || [];
						var html = '';
						for (var i = 0; i < details.length; i++) {
							var item = details[i] || {};
							var color = (chartData.datasets && chartData.datasets[0] && chartData.datasets[0].backgroundColor && chartData.datasets[0].backgroundColor[i]) || '#999';
							html += '<div class="d-flex align-items-center mb-2">' +
								'<div style="width:12px;height:12px;background:' + escapeHtml(color) + ';border-radius:50%;margin-right:8px;"></div>' +
								'<div><strong>' + escapeHtml(item.categoryName || '') + '</strong>: ' + (item.totalQuantity || 0).toLocaleString('vi-VN') + ' SP' +
								'<small class="text-muted d-block">' + (item.productCount || 0) + ' loại · ' + (item.variantCount || 0) + ' biến thể</small></div></div>';
						}
						$('#inventoryDetails').html(html || '<span class="text-muted">Không có dữ liệu</span>');
					})
					.fail(function () {
						$('#inventoryDetails').html('<span class="text-danger">Không tải được dữ liệu kho hàng</span>');
					});
			}

			// Low stock table
			/*
				PSEUDOCODE / PLAN:
				- Fetch low-stock products from API endpoint '/SanPhamSapHetHang'
				- Normalize response to array (either array or { data: [...] })
				- If empty -> show "Không có"
				- Otherwise map each product to a non-navigating element:
				  - Render a div with class="item" and data-id attribute
				  - Left: warning emoji + escaped product name
				  - Right: badge showing remaining quantity (badge-warning)
				- Inject the generated HTML into '#sapHetHangList'
				- On failure show an error message
			*/
			function loadLowStock() {
				$.get(api + '/SanPhamSapHetHang')
					.done(function (res) {
						var data = Array.isArray(res) ? res : (res && res.data) || [];
						quickDetailData.low = data;
						if (!data.length) {
							$('#sapHetHangList').html('<div class="text-muted p-2">Không có</div>');
							return;
						}
						var html = data.map(function (p) {
							var ten = escapeHtml((p.tenSanPham || 'Không tên') + (variantText(p) ? ' - ' + variantText(p) : ''));
							var soLuong = num(p.soLuong);
							// Render non-navigating item (no anchor)
							return `
								<div class="item" data-id="${p.id}">
									<span>⚠️ ${ten}</span>
									<span class="badge badge-warning">${soLuong}</span>
								</div>
							`;
						}).join('');
						html += '<button type="button" class="btn btn-sm btn-outline-warning w-100 mt-2 detail-open" data-type="low">Xem bảng chi tiết</button>';
						$('#sapHetHangList').html(html);
					})
					.fail(function () {
						$('#sapHetHangList').html('<div class="text-danger p-2">Lỗi tải dữ liệu</div>');
					});
			}

			// Out of stock table
			/*
				PSEUDOCODE / PLAN:
				- Fetch out-of-stock products from API endpoint '/SanPhamHetHang'
				- Normalize response to array
				- If empty -> show "Không có"
				- Otherwise map each product to a non-navigating div with:
				  - data-id attribute
				  - Product name prefixed with out-of-stock emoji
				  - Badge (danger) showing quantity (or 0)
				- Inject HTML into '#hetHangList'
			*/
			function loadOutStock() {
				$.get(api + '/SanPhamHetHang')
					.done(function (res) {
						var data = Array.isArray(res) ? res : (res && res.data) || [];
						quickDetailData.out = data;
						if (!data.length) {
							$('#hetHangList').html('<div class="text-muted p-2">Không có</div>');
							return;
						}
						var html = data.map(function (p) {
							var ten = escapeHtml((p.tenSanPham || 'Không tên') + (variantText(p) ? ' - ' + variantText(p) : ''));
							// Some APIs may include quantity; default to 0 if missing
							var soLuong = (typeof p.soLuong !== 'undefined') ? num(p.soLuong) : '0';
							return `
								<div class="item" data-id="${p.id}">
									<span>❌ ${ten}</span>
									<span class="badge badge-danger">${soLuong}</span>
								</div>
							`;
						}).join('');
						html += '<button type="button" class="btn btn-sm btn-outline-danger w-100 mt-2 detail-open" data-type="out">Xem bảng chi tiết</button>';
						$('#hetHangList').html(html);
					})
					.fail(function () {
						$('#hetHangList').html('<div class="text-danger p-2">Lỗi tải dữ liệu</div>');
					});
			}

			// Sản phẩm đã bán
			/*
				PSEUDOCODE / PLAN:
				- Fetch sold products from API endpoint '/SanPhamDaBan'
				- Normalize response to array
				- If empty -> show "Không có"
				- Otherwise map each product to a non-navigating div:
				  - data-id attribute for potential future handling
				  - Display product name and sold quantity badge (info)
				- Inject into '#daBanList'
			*/
			function loadDaBan() {
				$.get(api + '/SanPhamDaBan')
					.done(function (res) {

						var data = Array.isArray(res) ? res : (res && res.data) || [];
						quickDetailData.sold = data;

						if (!data.length) {
							$('#daBanList').html('<div class="text-muted p-2">Không có</div>');
							return;
						}

						var html = data.map(function (p) {

							let ten = escapeHtml(p.tenSanPham || 'Không tên');
							let soLuong = num(p.soLuong);

							// Render non-navigating item (removed anchor to prevent page navigation)
							return `
								<div class="item" data-id="${p.id}">
									<span>🛒 ${ten}</span>
									<span class="badge badge-info">${soLuong}</span>
								</div>
							`;

						}).join('');

						html += '<button type="button" class="btn btn-sm btn-outline-info w-100 mt-2 detail-open" data-type="sold">Xem bảng chi tiết</button>';
						$('#daBanList').html(html);
					})
					.fail(function () {
						$('#daBanList').html('<div class="text-danger p-2">Lỗi tải dữ liệu</div>');
					});
			}

			// Init: load chart demo scripts after small delay
			setTimeout(function () {
				$.getScript('/admin/js/demo/chart-area-demo.js');
				$.getScript('/admin/js/demo/chart-bar-demo.js');
				$.getScript('/admin/js/demo/chart-pie-demo.js');
				$.getScript('/admin/js/demo/donhangtrongthang.js');
			}, 100);

			// Hover behavior for collapse (kept for compatibility, non-blocking)
			(function attachHoverCollapse() {
				let timeout;
				$('.hover-card').hover(
					function () {
						clearTimeout(timeout);
						$(this).find('.collapse').stop(true, true).collapse('show');
					},
					function () {
						const el = $(this);
						timeout = setTimeout(function () {
							el.find('.collapse').collapse('hide');
						}, 150);
					}
				);
			})();

			// Load everything
			loadDashboard();
			loadLowStock();
			loadOutStock();
			loadInventoryChart();
			loadDaBan();
		});
	</script>
}
