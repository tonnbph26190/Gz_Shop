	}

		.dropdown-hover .item:hover {
			background: #fff3cd;
			transform: translateX(5px);
		}

	.dropdown-hover {
		z-index: 9999; /* tăng cao */
	}

	.hover-card {
		position: relative;
		z-index: 1;
	}

		.hover-card:hover {
			z-index: 1000; /* khi hover thì nổi lên */
		}

	.row,
	.col-xl-3 {
		overflow: visible !important;
	}
	/* cho phép xổ ra ngoài */
	.card {
