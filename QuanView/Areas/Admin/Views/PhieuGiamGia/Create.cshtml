@model QuanApi.Data.PhieuGiamGia

@{
    ViewData["Title"] = "Tạo phiếu giảm giá";
}

<style>
    body {
        background-color: #f8f9fc;
    }

    .form-container {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        padding: 2.5rem;
        border: 1px solid #e3e6f0;
    }

    .card-header-custom {
        border-bottom: 2px solid #eaecf4;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #4e73df;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control, .form-check-input {
        border-radius: 8px;
        border: 1px solid #d1d3e2;
        padding: 0.75rem 1rem;
        transition: all 0.2s ease-in-out;
    }

    .form-control:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.15);
    }

    .input-group-text-btn {
        border-top-right-radius: 8px !important;
        border-bottom-right-radius: 8px !important;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-primary {
        background: #4e73df;
        border: none;
    }

    .btn-primary:hover {
        background: #2e59d9;
        transform: translateY(-1px);
    }

    .btn-secondary {
        background: #858796;
        border: none;
    }

    .btn-secondary:hover {
        background: #717384;
    }

    .alert-info {
        background-color: #f0f4fd;
        border-left: 4px solid #4e73df;
        color: #3a3b45;
        border-top: none;
        border-right: none;
        border-bottom: none;
        border-radius: 8px;
    }

    .text-muted {
        font-size: 0.8rem;
        margin-top: 0.25rem;
        display: block;
    }

    /* Style riêng cho checkbox toggle gạt */
    .form-switch .form-check-input {
        width: 2.5em;
        height: 1.25em;
        margin-left: -2.5em;
        cursor: pointer;
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<div class="container py-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 font-weight-bold">Quản lý phiếu giảm giá</h1>
            <p class="text-muted mb-0">Thêm mới chương trình khuyến mãi cho cửa hàng</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary shadow-sm">
            <i class="fas fa-arrow-left me-2"></i>Quay lại danh sách
        </a>
    </div>

    <div class="form-container">
        <div class="card-header-custom d-flex align-items-center">
            <i class="fas fa-ticket-alt text-primary fa-2x me-3"></i>
            <h4 class="mb-0 text-dark fw-bold">Thông tin phiếu giảm giá</h4>
        </div>

        <div class="alert alert-info d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="fas fa-info-circle fa-lg me-3 text-primary"></i>
            <div>
                <strong>Lưu ý công khai:</strong> Phiếu giảm giá sau khi kích hoạt sẽ hiển thị trực tiếp đến tất cả khách hàng đủ điều kiện áp dụng đơn hàng công khai trên hệ thống.
            </div>
        </div>

        <form asp-area="Admin" asp-controller="PhieuGiamGia" asp-action="Create" method="post" id="createForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="MaCode" class="form-label">Mã Code định danh <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-hashtag text-muted"></i></span>
                            <input asp-for="MaCode" class="form-control fw-bold text-primary" readonly style="background-color: #f8f9fa;" />
                            <button type="button" class="btn btn-outline-primary input-group-text-btn" onclick="generateMaCode()">
                                <i class="fas fa-sync-alt me-1"></i> Đổi mã khác
                            </button>
                        </div>
                        <span asp-validation-for="MaCode" class="text-danger small fw-bold"></span>
                        <small class="text-muted">Mã định danh tự động duy nhất dùng để áp dụng khi thanh toán.</small>
                    </div>
                </div>
                
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="TenPhieu" class="form-label">Tên hiển thị phiếu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-font text-muted"></i></span>
                            <input asp-for="TenPhieu" class="form-control" placeholder="Ví dụ: Giảm giá ngày vàng tháng 5..." />
                        </div>
                        <span asp-validation-for="TenPhieu" class="text-danger small fw-bold"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="GiaTriGiam" class="form-label">Mức giảm giá (%) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="GiaTriGiam" class="form-control text-end" type="number" min="1" max="99" placeholder="10" />
                            <span class="input-group-text bg-light fw-bold">%</span>
                        </div>
                        <span asp-validation-for="GiaTriGiam" class="text-danger small fw-bold"></span>
                        <small class="text-muted">Tỷ lệ khấu trừ tối thiểu 1% - tối đa 99%</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="GiaTriGiamToiDa" class="form-label">Số tiền giảm tối đa</label>
                        <div class="input-group">
                            <input asp-for="GiaTriGiamToiDa" class="form-control text-end" type="number" min="0" placeholder="Chưa giới hạn" />
                            <span class="input-group-text bg-light">đ</span>
                        </div>
                        <span asp-validation-for="GiaTriGiamToiDa" class="text-danger small fw-bold"></span>
                        <small class="text-muted">Để trống hoặc nhập 0 nếu muốn giảm không giới hạn trần.</small>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="form-group">
                        <label asp-for="DonToiThieu" class="form-label">Giá trị đơn tối thiểu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="DonToiThieu" class="form-control text-end" type="number" min="0" placeholder="0" />
                            <span class="input-group-text bg-light">đ</span>
                        </div>
                        <span asp-validation-for="DonToiThieu" class="text-danger small fw-bold"></span>
                        <small class="text-muted">Điều kiện tổng tiền giỏ hàng để được kích hoạt áp mã.</small>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="NgayBatDau" class="form-label">Thời gian bắt đầu <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="far fa-calendar-alt text-muted"></i></span>
                            <input asp-for="NgayBatDau" class="form-control" type="datetime-local" />
                        </div>
                        <span asp-validation-for="NgayBatDau" class="text-danger small fw-bold"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="NgayKetThuc" class="form-label">Thời gian kết thúc <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="far fa-calendar-check text-muted"></i></span>
                            <input asp-for="NgayKetThuc" class="form-control" type="datetime-local" />
                        </div>
                        <span asp-validation-for="NgayKetThuc" class="text-danger small fw-bold"></span>
                    </div>
                </div>
            </div>

            <div class="form-group my-4">
                <div class="form-check form-switch ps-5">
                    <input asp-for="TrangThai" class="form-check-input" type="checkbox" checked />
                    <label asp-for="TrangThai" class="form-check-label fw-bold text-dark ms-2">Kích hoạt phát hành ngay lập tức</label>
                </div>
                <small class="text-muted ms-2">Nếu tắt, phiếu sẽ được lưu nháp dưới dạng chưa khả dụng trên hệ thống mua hàng.</small>
            </div>

            <hr class="my-4" style="border-color: #eaecf4;">

            <div class="form-group mb-0 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary px-4">
                    <i class="fas fa-times me-2"></i>Hủy bỏ
                </a>
                <button type="submit" class="btn btn-primary px-5 shadow-sm">
                    <i class="fas fa-save me-2"></i>Xác nhận tạo phiếu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Cấu hình thông báo Toastr đẹp mắt
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "4000"
        };

        // Hàm tạo mã code ngẫu nhiên dạng chuỗi không trùng lặp
        function generateMaCode() {
            const now = new Date();
            const year = now.getFullYear().toString().slice(-2);
            const month = (now.getMonth() + 1).toString().padStart(2, '0');
            const day = now.getDate().toString().padStart(2, '0');
            const hours = now.getHours().toString().padStart(2, '0');
            const minutes = now.getMinutes().toString().padStart(2, '0');
            const seconds = now.getSeconds().toString().padStart(2, '0');
            const random = Math.floor(Math.random() * 1000).toString().padStart(3, '0');

            const maCode = `PGG${year}${month}${day}${hours}${minutes}${seconds}${random}`;
            document.getElementById('MaCode').value = maCode;
        }

        $(document).ready(function () {
            // Tự động tạo mã code khi tải trang lần đầu
            if(!$('#MaCode').val()) {
                generateMaCode();
            }

            // Thiết lập giá trị thời gian mặc định thông minh
            var now = new Date();
            
            // Ngày bắt đầu: Đặt là thời gian hiện tại
            var localNow = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
            if(!$('#NgayBatDau').val()){
                $('#NgayBatDau').val(localNow.toISOString().slice(0, 16));
            }
            
            // Ngày kết thúc: Mặc định cộng thêm 7 ngày sau
            if(!$('#NgayKetThuc').val()){
                var nextWeek = new Date(now);
                nextWeek.setDate(nextWeek.getDate() + 7);
                var localNextWeek = new Date(nextWeek.getTime() - nextWeek.getTimezoneOffset() * 60000);
                $('#NgayKetThuc').val(localNextWeek.toISOString().slice(0, 16));
            }

            // Bổ sung các logic Validations kiểm tra sâu bằng JavaScript trước khi gửi Form
            $('#createForm').on('submit', function (e) {
                // Kiểm tra xem các Validation mặc định của ASP.NET Core có hợp lệ không
                if (!$(this).valid()) {
                    toastr.error('Vui lòng kiểm tra lại các trường thông tin bắt buộc!', 'Dữ liệu thiếu');
                    return false;
                }

                var ngayBatDau = new Date($('#NgayBatDau').val());
                var ngayKetThuc = new Date($('#NgayKetThuc').val());
                var hienTai = new Date();
                
                var giaTriGiam = parseInt($('#GiaTriGiam').val());
                var giaTriGiamToiDa = parseInt($('#GiaTriGiamToiDa').val()) || 0;
                var donToiThieu = parseInt($('#DonToiThieu').val()) || 0;

                // 1. Kiểm tra: Ngày kết thúc không được nhỏ hơn hoặc bằng ngày bắt đầu
                if (ngayKetThuc <= ngayBatDau) {
                    toastr.warning('Thời gian kết thúc phải lớn hơn thời gian bắt đầu!', 'Sai ngày cấu hình');
                    $('#NgayKetThuc').focus();
                    e.preventDefault();
                    return false;
                }

                // 2. Kiểm tra: Thời gian kết thúc phải lớn hơn thời điểm hiện tại
                if (ngayKetThuc <= hienTai) {
                    toastr.warning('Thời gian kết thúc không được ở trong quá khứ!', 'Sai mốc thời gian');
                    $('#NgayKetThuc').focus();
                    e.preventDefault();
                    return false;
                }

                // 3. Kiểm tra: Giá trị giảm từ 1 đến 99%
                if (giaTriGiam < 1 || giaTriGiam > 99 || isNaN(giaTriGiam)) {
                    toastr.warning('Phần trăm giảm giá hợp lệ phải nằm trong khoảng từ 1% đến 99%!', 'Sai giá trị');
                    $('#GiaTriGiam').focus();
                    e.preventDefault();
                    return false;
                }

                // 4. Kiểm tra: Đơn tối thiểu không được âm
                if (donToiThieu < 0) {
                    toastr.warning('Giá trị đơn hàng tối thiểu không được nhỏ hơn 0 VNĐ!', 'Lỗi giá trị đơn');
                    $('#DonToiThieu').focus();
                    e.preventDefault();
                    return false;
                }

                // 5. Kiểm tra: Số tiền giảm tối đa không được nhỏ hơn 0 (nếu nhập dữ liệu)
                if ($('#GiaTriGiamToiDa').val() !== "" && giaTriGiamToiDa < 0) {
                    toastr.warning('Số tiền giảm tối đa không được nhập số âm!', 'Lỗi hạn mức giảm');
                    $('#GiaTriGiamToiDa').focus();
                    e.preventDefault();
                    return false;
                }

                // Nếu thỏa mãn tất cả điều kiện, Toastr sẽ báo thành công trước khi form submit
                toastr.success('Đang gửi dữ liệu tạo phiếu giảm giá...', 'Thành công');
                return true;
            });
        });
    </script>
}