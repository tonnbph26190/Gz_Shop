@model QuanApi.Data.LoaiOng

@{
    ViewData["Title"] = "Chi tiết Loại Ống";
}

<div class="card shadow-sm">
    <div class="card-header bg-info text-white">
        <h4>Chi tiết Loại Ống</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Mã loại</dt>
            <dd class="col-sm-9">@Model.IDLoaiOng</dd>

            <dt class="col-sm-3">Tên loại</dt>
            <dd class="col-sm-9">@Model.TenLoaiOng</dd>

            <dt class="col-sm-3">Trạng thái</dt>
            <dd class="col-sm-9">@(Model.TrangThai == true ? "Hoạt động" : "Ngừng hoạt động")</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.IDLoaiOng" class="btn btn-primary">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</div>