@model QuanApi.Data.LoaiOng

@{
    ViewData["Title"] = "Xóa Loại Ống";
}

<div class="alert alert-danger">
    <h3>Xác nhận xóa?</h3>
    <p>Bạn có chắc chắn muốn xóa Loại Ống này không?</p>
</div>

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Tên loại</dt>
            <dd class="col-sm-9">@Model.TenLoaiOng</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" name="id" value="@Model.IDLoaiOng" />
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </form>
    </div>
</div>