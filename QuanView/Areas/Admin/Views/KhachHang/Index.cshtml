
@{
    ViewData["Title"] = "Index";
}

@model IEnumerable<QuanApi.Dtos.KhachHangDto>

@{
    ViewData["Title"] = "Danh Sách Khách Hàng";
}

<div class="container-fluid py-4">
    <h2 class="mb-4 text-primary fw-bold">@ViewData["Title"]</h2>

    <!-- Thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Card tìm kiếm -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <a class="btn btn-primary" asp-area="Admin" asp-controller="KhachHang" asp-action="Create">
                    <i class="bi bi-plus-circle me-2"></i>Thêm khách hàng mới
                </a>
                <form asp-action="Index" asp-controller="KhachHang" asp-area="Admin" method="get" class="d-flex w-50">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewData["CurrentSearch"]"
                               class="form-control" placeholder="Tìm theo mã, tên, email, SĐT..." />
                        <button class="btn btn-outline-primary" type="submit">Tìm</button>
                        <a asp-action="Index" asp-controller="KhachHang" asp-area="Admin"
                           class="btn btn-outline-secondary">Xóa</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Card bảng dữ liệu -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <div class="page-size-selector">
                    <label for="pageSize">Hiển thị:</label>
                    <select id="pageSize" class="form-control form-control-sm d-inline-block w-auto ml-2"
                            onchange="changePageSize(this.value)">
                        <option value="5" selected="@(ViewBag.PageSize == 5)">5</option>
                        <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                        <option value="20" selected="@(ViewBag.PageSize == 20)">20</option>
                        <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                    </select>
                </div>
				<table id="khachHangTable" class="table table-hover align-middle">
					<thead class="table-light">
						<tr>
							<th>@Html.DisplayNameFor(model => model.MaKhachHang)</th>
							<th>@Html.DisplayNameFor(model => model.TenKhachHang)</th>
							<th>@Html.DisplayNameFor(model => model.Email)</th>
							<th>@Html.DisplayNameFor(model => model.SoDienThoai)</th>
							<th>@Html.DisplayNameFor(model => model.SoDiemHienTai)</th>
							<th>@Html.DisplayNameFor(model => model.TongDiemTichLuy)</th>
							<th>
    <a href="@Url.Action("Index", new { 
        sortBy = "rank", 
        sortAscending = ViewBag.SortBy == "rank" ? !ViewBag.SortAscending : false 
    })">
        Hạng
    </a>
</th>
							<th>@Html.DisplayNameFor(model => model.NgayTao)</th>
							<th>@Html.DisplayNameFor(model => model.NguoiTao)</th>
							<th>@Html.DisplayNameFor(model => model.TrangThai)</th>
							<th class="text-end">Thao tác</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in Model)
						{
							<tr>
								<td>@item.MaKhachHang</td>
								<td>@item.TenKhachHang</td>
								<td>@item.Email</td>
								<td>@item.SoDienThoai</td>
								<td>@item.SoDiemHienTai</td>
								<td>@item.TongDiemTichLuy</td>

								<!-- 🔥 RANK -->
								<td>
									@{
										var icon = item.Rank == "Kim cương" ? "💎" :
										item.Rank == "Vàng" ? "🥇" :
										item.Rank == "Bạc" ? "🥈" :
										item.Rank == "Đồng" ? "🥉" : "";
									


										var color = item.Rank == "Kim cương" ? "" :
										item.Rank == "Vàng" ? "" :
										item.Rank == "Bạc" ? "" :
										item.Rank == "Đồng" ? "" :
									
										"";
									}

									<span class="badge @color">
										@icon @item.Rank
									</span>
								</td>

								<td>@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
								<td>@item.NguoiTao</td>

								<td>
									@if (item.TrangThai)
									{
										<span class="badge bg-success rounded-pill">Kích hoạt</span>
									}
									else
									{
										<span class="badge bg-secondary rounded-pill">Ẩn</span>
									}
								</td>

								<td class="text-end">
									<a class="btn btn-sm btn-outline-info me-1"
									   asp-area="Admin" asp-controller="KhachHang" asp-action="Delete"
									   asp-route-id="@item.IDKhachHang">
										<i class="bi bi-eye"></i>
									</a>

									<form asp-area="Admin" asp-controller="KhachHang" asp-action="ToggleStatus"
										  asp-route-id="@item.IDKhachHang" method="post" style="display:inline;">
										@Html.AntiForgeryToken()
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
                <div class="pagination-controls d-flex justify-content-center align-items-center gap-3 ">
                       <nav aria-label="Phân trang">
                            <ul class="pagination mb-0">

                                <!-- Trang đầu -->
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { pageNumber = 1, pageSize = ViewBag.PageSize })">
                                        <i class="fas fa-angle-double-left"></i>
                                    </a>
                                </li>

                                <!-- Trang trước -->
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })">
                                        <i class="fas fa-angle-left"></i>
                                    </a>
                                </li>

                                @{
                                    var startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                                    var endPage = Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2);

                                    for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link"
                                               href="@Url.Action("Index", new { pageNumber = i, pageSize = ViewBag.PageSize })">@i</a>
                                        </li>
                                    }
                                }

                                <!-- Trang sau -->
                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })">
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                </li>

                                <!-- Trang cuối -->
                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", new { pageNumber = ViewBag.TotalPages, pageSize = ViewBag.PageSize })">
                                        <i class="fas fa-angle-double-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#khachHangTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/vi.json'
                },
                paging: false,
                searching: false,
                ordering: false,
                info: false,
                responsive: true
            });
        });
    </script>
    <script>
        function changePageSize(size) {
            const url = new URL(window.location.href);
            url.searchParams.set("pageSize", size);
            url.searchParams.set("pageNumber", 1);
            window.location.href = url.toString();
        }
    </script>

}
