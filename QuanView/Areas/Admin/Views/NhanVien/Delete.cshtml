@model QuanApi.Dtos.NhanVienUpdateDto

<div class="container mt-5">
    <div class="card border-danger mx-auto" style="max-width: 500px;">
        <div class="card-header bg-danger text-white text-center">
            <h4>Xác Nhận Xóa</h4>
        </div>
        <div class="card-body text-center">
            <p>Bạn có chắc chắn muốn xóa nhân viên này không?</p>
            <h5 class="text-primary">@Model.TenNhanVien</h5>
            <p class="text-muted">Mã NV: @Model.MaNhanVien</p>
        </div>
        <div class="card-footer d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            <form asp-action="Delete" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            </form>
        </div>
    </div>
</div>