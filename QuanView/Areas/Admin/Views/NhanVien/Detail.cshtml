@model QuanApi.Dtos.NhanVienResponseDto

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Nhân Viên</a></li>
            <li class="breadcrumb-item active">Chi tiết: @Model.MaNhanVien</li>
        </ol>
    </nav>

    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Hồ Sơ Nhân Viên</h5>
            <span class="badge bg-light text-dark">ID: @Model.IDNhanVien</span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 border-end">
                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Thông tin cá nhân</h6>
                    <dl class="row">
                        <dt class="col-sm-5">Họ và Tên:</dt>
                        <dd class="col-sm-7 text-primary fw-bold">@Model.TenNhanVien</dd>

                        <dt class="col-sm-5">Ngày sinh:</dt>
                        <dd class="col-sm-7">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-5">Giới tính:</dt>
                        <dd class="col-sm-7">@(Model.GioiTinh == true ? "Nam" : "Nữ")</dd>

                        <dt class="col-sm-5">CCCD:</dt>
                        <dd class="col-sm-7">@Model.CCCD</dd>

                        <dt class="col-sm-5">Quê quán:</dt>
                        <dd class="col-sm-7">@Model.QueQuan</dd>
                    </dl>
                </div>

                <div class="col-md-6 ps-4">
                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Công việc & Liên hệ</h6>
                    <dl class="row">
                        <dt class="col-sm-5">Mã NV:</dt>
                        <dd class="col-sm-7">@Model.MaNhanVien</dd>

                        <dt class="col-sm-5">Vai trò:</dt>
                        <dd class="col-sm-7"><span class="badge bg-info text-dark">@Model.TenVaiTro</span></dd>

                        <dt class="col-sm-5">Email:</dt>
                        <dd class="col-sm-7">@Model.Email</dd>

                        <dt class="col-sm-5">SĐT:</dt>
                        <dd class="col-sm-7">@Model.SoDienThoai</dd>

                        <dt class="col-sm-5">Trạng thái:</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.TrangThai ? "bg-success" : "bg-danger")">
                                @(Model.TrangThai ? "Đang làm việc" : "Đã nghỉ")
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <hr />

            <div class="row mt-2 small text-muted">
                <div class="col-md-6">
                    Ngày tạo: @Model.NgayTao.ToString("G")
                </div>
                <div class="col-md-6 text-md-end">
                    Lần cập nhật cuối: @(Model.LanCapNhatCuoi?.ToString("G") ?? "Chưa có")
                </div>
            </div>
        </div>
        <div class="card-footer bg-light text-end">
            <a asp-action="Edit" asp-route-id="@Model.IDNhanVien" class="btn btn-warning">Sửa thông tin</a>
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    </div>
</div>