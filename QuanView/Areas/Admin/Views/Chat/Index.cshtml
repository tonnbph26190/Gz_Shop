@{
    ViewData["Title"] = "Tin nhắn";
}

<div class="messenger-admin">
    <aside class="conversation-list">
        <div class="conversation-head">
            <div>
                <h1>Tin nhắn</h1>
                <p>Hộp thoại khách hàng</p>
            </div>
            <button type="button" class="icon-btn" id="reloadRooms" title="Tải lại">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
        <div class="conversation-search">
            <i class="fas fa-search"></i>
            <input type="search" id="roomSearch" placeholder="Tìm khách hàng...">
        </div>
        <div id="roomList" class="conversation-items">
            <div class="empty-state">Đang tải hội thoại...</div>
        </div>
    </aside>

    <section class="chat-panel">
        <div class="chat-header">
            <div class="avatar" id="roomAvatar">?</div>
            <div>
                <h2 id="roomTitle">Chọn một hội thoại</h2>
                <p id="roomSubtitle">Tin nhắn sẽ hiển thị tại đây</p>
            </div>
            <button type="button" class="icon-btn customer-info-btn" id="openCustomerInfo" title="Thông tin khách hàng" disabled>
                <i class="fas fa-id-card-alt"></i>
            </button>
        </div>

        <div id="messageList" class="message-list">
            <div class="empty-chat">
                <i class="fas fa-comments"></i>
                <p>Chọn khách hàng để bắt đầu trả lời.</p>
            </div>
        </div>

        <form id="sendForm" class="message-composer">
            <input type="text" id="messageInput" placeholder="Nhập tin nhắn..." autocomplete="off" disabled>
            <button type="submit" disabled id="sendButton">
                <i class="fas fa-paper-plane"></i>
            </button>
        </form>
    </section>
</div>

<div class="modal fade" id="customerInfoModal" tabindex="-1" role="dialog" aria-labelledby="customerInfoModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="customerInfoModalTitle">Thông tin khách hàng</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body customer-info-modal-body">
                <div class="customer-info-row">
                    <span class="customer-info-label">Tên</span>
                    <strong id="customerInfoName">-</strong>
                </div>
                <div class="customer-info-row">
                    <span class="customer-info-label">Số điện thoại</span>
                    <strong id="customerInfoPhone">-</strong>
                </div>
                <div class="customer-info-row">
                    <span class="customer-info-label">Hạng</span>
                    <strong id="customerInfoRank">-</strong>
                </div>
                <div class="customer-info-row">
                    <span class="customer-info-label">Điểm hiện tại</span>
                    <strong id="customerInfoPoints">0</strong>
                </div>
                <div class="customer-info-row">
                    <span class="customer-info-label">Địa chỉ</span>
                    <strong id="customerInfoAddress">Chưa có địa chỉ</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .messenger-admin {
        width: min(1040px, 100%);
        height: min(650px, calc(100vh - 185px));
        min-height: 560px;
        margin: 0 auto 22px;
        display: grid;
        grid-template-columns: 300px minmax(0, 1fr);
        background: #eef2f7;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .13);
    }

    .conversation-list,
    .chat-panel {
        background: #fff;
        min-height: 0;
    }

    .conversation-list {
        border-right: 1px solid #e5e7eb;
        display: flex;
        flex-direction: column;
    }

    .conversation-head {
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #eef2f7;
    }

    .conversation-head h1 {
        font-size: 1.05rem;
        font-weight: 800;
        color: #111827;
        margin: 0;
    }

    .conversation-head p,
    .chat-header p {
        margin: 3px 0 0;
        color: #64748b;
        font-size: .85rem;
    }

    .icon-btn {
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 50%;
        background: #f1f5f9;
        color: #334155;
    }

    .conversation-search {
        margin: 12px 14px;
        height: 38px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-radius: 999px;
        padding: 0 14px;
        background: #f1f5f9;
        color: #64748b;
    }

    .conversation-search input {
        border: 0;
        outline: 0;
        background: transparent;
        width: 100%;
        color: #111827;
    }

    .conversation-items {
        overflow: auto;
        padding: 4px 10px 14px;
    }

    .conversation-item {
        display: grid;
        grid-template-columns: 38px minmax(0, 1fr);
        gap: 10px;
        padding: 10px;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid transparent;
    }

    .conversation-item:hover,
    .conversation-item.active {
        background: #eff6ff;
        border-color: #bfdbfe;
    }

    .avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #2563eb;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        flex: 0 0 auto;
    }

    .conversation-name {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        color: #111827;
        font-weight: 800;
    }

    .rank-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 700;
        line-height: 1;
        padding: 4px 8px;
        white-space: nowrap;
    }

    .rank-badge.rank-kimcuong {
        background: #ede9fe;
        color: #6d28d9;
    }

    .rank-badge.rank-vang {
        background: #fef3c7;
        color: #92400e;
    }

    .rank-badge.rank-bac {
        background: #e2e8f0;
        color: #334155;
    }

    .rank-badge.rank-dong {
        background: #ffedd5;
        color: #9a3412;
    }

    .rank-badge.rank-default {
        background: #e5e7eb;
        color: #374151;
    }

    .conversation-preview {
        color: #64748b;
        font-size: .84rem;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .conversation-time {
        color: #94a3b8;
        font-size: .72rem;
        white-space: nowrap;
        font-weight: 600;
    }

    .chat-panel {
        display: flex;
        flex-direction: column;
    }

    .chat-header {
        height: 64px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
    }

    .customer-info-btn {
        margin-left: auto;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .room-info-btn {
        width: 24px;
        height: 24px;
        border: 0;
        border-radius: 50%;
        background: #e2e8f0;
        color: #334155;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .72rem;
        flex: 0 0 auto;
    }

    .room-info-btn:hover {
        background: #cbd5e1;
    }

    .chat-header h2 {
        margin: 0;
        font-size: 1.05rem;
        font-weight: 800;
        color: #111827;
    }

    .message-list {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 18px;
        background: #f8fafc;
    }

    .message-row {
        display: flex;
        margin-bottom: 10px;
    }

    .message-row.mine {
        justify-content: flex-end;
    }

    .message-bubble {
        max-width: min(430px, 76%);
        padding: 9px 12px;
        border-radius: 16px;
        background: #fff;
        color: #111827;
        border: 1px solid #e5e7eb;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
    }

    .message-row.mine .message-bubble {
        background: #2563eb;
        color: #fff;
        border-color: #2563eb;
    }

    .message-meta {
        font-size: .72rem;
        margin-top: 4px;
        color: #94a3b8;
    }

    .message-row.mine .message-meta {
        color: rgba(255,255,255,.78);
        text-align: right;
    }

    .message-composer {
        display: flex;
        gap: 10px;
        padding: 12px;
        border-top: 1px solid #e5e7eb;
        background: #fff;
    }

    .message-composer input {
        flex: 1;
        height: 42px;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 0 16px;
        outline: 0;
    }

    .message-composer button {
        width: 42px;
        height: 42px;
        border: 0;
        border-radius: 50%;
        background: #2563eb;
        color: #fff;
    }

    .message-composer button:disabled,
    .message-composer input:disabled {
        opacity: .55;
    }

    .empty-state,
    .empty-chat {
        color: #64748b;
        text-align: center;
        padding: 24px;
    }

    .empty-chat {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .empty-chat i {
        font-size: 3rem;
        color: #cbd5e1;
    }

    .customer-info-modal-body {
        display: grid;
        gap: 10px;
    }

    .customer-info-row {
        display: grid;
        gap: 4px;
        padding: 10px 12px;
        border-radius: 8px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .customer-info-label {
        font-size: .78rem;
        color: #64748b;
        font-weight: 700;
    }

    @@media (max-width: 992px) {
        .messenger-admin {
            grid-template-columns: 1fr;
            height: min(720px, calc(100vh - 120px));
        }

        .conversation-list {
            max-height: 360px;
            border-right: 0;
            border-bottom: 1px solid #e5e7eb;
        }

        .chat-panel {
            min-height: 560px;
        }
    }
</style>

@section Scripts {
    <script>
        $(function () {
            let rooms = [];
            let activeRoomId = null;
            let activeRoomInfo = null;
            let messageTimer = null;

            const $roomList = $('#roomList');
            const $messageList = $('#messageList');
            const $messageInput = $('#messageInput');
            const $sendButton = $('#sendButton');

            function initials(name) {
                return (name || '?').trim().charAt(0).toUpperCase();
            }

            function escapeHtml(value) {
                return String(value || '').replace(/[&<>"']/g, function (ch) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
                });
            }

            function formatTime(value) {
                if (!value) return '';
                return new Date(value).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
            }

            function escapeTooltip(value) {
                return escapeHtml(value).replace(/"/g, '&quot;');
            }

            function getRoomById(roomId) {
                return rooms.find(r => String(r.id) === String(roomId)) || null;
            }

            function normalizeRank(value) {
                return String(value || '').toLowerCase();
            }

            function getRankClass(rank) {
                const text = normalizeRank(rank);
                if (text.includes('kim')) return 'rank-kimcuong';
                if (text.includes('vang')) return 'rank-vang';
                if (text.includes('bac')) return 'rank-bac';
                if (text.includes('dong')) return 'rank-dong';
                return 'rank-default';
            }

            function getRankIcon(rank) {
                const text = normalizeRank(rank);
                if (text.includes('kim')) return '💎';
                if (text.includes('vang')) return '🥇';
                if (text.includes('bac')) return '🥈';
                if (text.includes('dong')) return '🥉';
                return '⭐';
            }

            function buildCustomerTooltip(room) {
                const rank = room.customerRank || 'Chưa xếp hạng';
                const phone = room.customerPhone || 'Không có SĐT';
                const address = room.customerAddress || 'Chưa có địa chỉ';
                const points = Number(room.customerPoints || 0);
                return `
                    <div><strong>${escapeTooltip(room.customerName || 'Khách hàng')}</strong></div>
                    <div>SĐT: ${escapeTooltip(phone)}</div>
                    <div>Hạng: ${escapeTooltip(rank)}</div>
                    <div>Điểm: ${points}</div>
                    <div>Địa chỉ: ${escapeTooltip(address)}</div>
                `;
            }

            function showCustomerInfoModal(room) {
                if (!room) return;
                $('#customerInfoName').text(room.customerName || 'Khách hàng');
                $('#customerInfoPhone').text(room.customerPhone || 'Không có SĐT');
                $('#customerInfoRank').text(room.customerRank || 'Chưa xếp hạng');
                $('#customerInfoPoints').text(Number(room.customerPoints || 0));
                $('#customerInfoAddress').text(room.customerAddress || 'Chưa có địa chỉ');
                $('#customerInfoModal').modal('show');
            }

            function refreshRoomTooltips() {
                $('.conversation-item').tooltip('dispose');
                $('.conversation-item').each(function () {
                    const room = getRoomById($(this).data('id'));
                    if (!room) return;
                    $(this).tooltip({
                        container: 'body',
                        trigger: 'hover',
                        placement: 'right',
                        html: true,
                        title: buildCustomerTooltip(room)
                    });
                });
            }

            function renderRooms() {
                const keyword = ($('#roomSearch').val() || '').toLowerCase().trim();
                const filtered = rooms
                    .filter(r => !keyword || (r.customerName || '').toLowerCase().includes(keyword) || (r.customerPhone || '').includes(keyword))
                    .sort((a, b) => {
                        const rankDiff = Number(b.rankPriority ?? -1) - Number(a.rankPriority ?? -1);
                        if (rankDiff !== 0) return rankDiff;
                        return new Date(b.updatedAt || 0) - new Date(a.updatedAt || 0);
                    });

                if (!filtered.length) {
                    $roomList.html('<div class="empty-state">Chưa có hội thoại phù hợp.</div>');
                    return;
                }

                $roomList.html(filtered.map(r => `
                    <div class="conversation-item ${r.id === activeRoomId ? 'active' : ''}" data-id="${r.id}">
                        <div class="avatar">${escapeHtml(initials(r.customerName))}</div>
                        <div>
                            <div class="conversation-name">
                                <div class="d-inline-flex align-items-center" style="gap:6px; min-width:0;">
                                    <span class="text-truncate">${escapeHtml(r.customerName)}</span>
                                    <span class="rank-badge ${getRankClass(r.customerRank)}">${getRankIcon(r.customerRank)} ${escapeHtml(r.customerRank || 'Chưa xếp hạng')}</span>
                                </div>
                                <div class="d-inline-flex align-items-center" style="gap:6px;">
                                    <small class="conversation-time">${formatTime(r.updatedAt)}</small>
                                    <button type="button" class="room-info-btn" data-id="${r.id}" title="Xem chi tiết khách hàng">
                                        <i class="fas fa-info"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="conversation-preview">${escapeHtml(r.lastMessage || r.customerPhone || 'Chưa có tin nhắn')}</div>
                        </div>
                    </div>
                `).join(''));
                refreshRoomTooltips();
            }

            function loadRooms(selectFirst) {
                $.get('@Url.Action("Rooms", "Chat", new { area = "Admin" })')
                    .done(function (res) {
                        rooms = res && res.success ? res.data || [] : [];
                        if (!activeRoomId && selectFirst && rooms.length) {
                            activeRoomId = rooms[0].id;
                            loadMessages();
                        }
                        if (activeRoomId) {
                            activeRoomInfo = getRoomById(activeRoomId);
                            $('#openCustomerInfo').prop('disabled', !activeRoomInfo);
                        }
                        renderRooms();
                    });
            }

            function loadMessages() {
                if (!activeRoomId) return;
                $.get('@Url.Action("Messages", "Chat", new { area = "Admin" })', { id: activeRoomId })
                    .done(function (res) {
                        if (!res || !res.success) return;
                        activeRoomInfo = $.extend({}, getRoomById(activeRoomId) || {}, res.room || {});
                        $('#roomTitle').text(res.room.customerName);
                        $('#roomSubtitle').text((res.room.customerPhone || 'Không có SĐT') + ' · Hạng: ' + (res.room.customerRank || 'Chưa xếp hạng') + ' · Phụ trách: ' + res.room.staffName);
                        $('#roomAvatar').text(initials(res.room.customerName));
                        $('#openCustomerInfo').prop('disabled', !activeRoomInfo);
                        $messageInput.prop('disabled', false);
                        $sendButton.prop('disabled', false);

                        const messages = res.data || [];
                        if (!messages.length) {
                            $messageList.html('<div class="empty-chat"><i class="fas fa-comment-dots"></i><p>Chưa có tin nhắn trong hội thoại này.</p></div>');
                            return;
                        }

                        $messageList.html(messages.map(m => `
                            <div class="message-row ${m.senderType === 'admin' ? 'mine' : ''}">
                                <div class="message-bubble">
                                    <div>${escapeHtml(m.content)}</div>
                                    <div class="message-meta">${escapeHtml(m.senderName)} · ${formatTime(m.createdAt)}</div>
                                </div>
                            </div>
                        `).join(''));
                        markRoomSeen(activeRoomId, messages);
                        $messageList.scrollTop($messageList[0].scrollHeight);
                    });
            }

            function markRoomSeen(roomId, messages) {
                if (!roomId || !messages || !messages.length) return;
                const lastMessage = messages[messages.length - 1];
                if (!lastMessage || !lastMessage.id) return;
                localStorage.setItem(`gz-chat-seen-${roomId}`, String(lastMessage.id));
                if (typeof window.refreshAdminChatNotifications === 'function') {
                    window.refreshAdminChatNotifications();
                }
            }

            $(document).on('click', '.conversation-item', function () {
                activeRoomId = $(this).data('id');
                activeRoomInfo = getRoomById(activeRoomId);
                renderRooms();
                loadMessages();
                clearInterval(messageTimer);
                messageTimer = setInterval(loadMessages, 5000);
            });

            $(document).on('click', '.room-info-btn', function (e) {
                e.preventDefault();
                e.stopPropagation();
                const room = getRoomById($(this).data('id'));
                showCustomerInfoModal(room);
            });

            $('#openCustomerInfo').on('click', function () {
                showCustomerInfoModal(activeRoomInfo);
            });

            $('#roomSearch').on('input', renderRooms);
            $('#reloadRooms').on('click', function () { loadRooms(false); });

            $('#sendForm').on('submit', function (e) {
                e.preventDefault();
                const content = $messageInput.val().trim();
                if (!activeRoomId || !content) return;
                $sendButton.prop('disabled', true);
                $.post('@Url.Action("Send", "Chat", new { area = "Admin" })', { id: activeRoomId, content: content })
                    .done(function () {
                        $messageInput.val('');
                        loadMessages();
                        loadRooms(false);
                    })
                    .always(function () {
                        $sendButton.prop('disabled', false);
                    });
            });

            loadRooms(true);
            setInterval(function () { loadRooms(false); }, 10000);
        });
    </script>
}
