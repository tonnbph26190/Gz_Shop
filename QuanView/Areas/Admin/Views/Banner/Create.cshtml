@model QuanView.Areas.Admin.Models.BannerFormVm
@{
    ViewData["Title"] = "Thêm Banner Mới";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-secondary small d-inline-flex align-items-center gap-1">
                    <i class="fa fa-chevron-left"></i> Trở về danh sách
                </a>
            </div>

            <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header bg-success text-white py-4 text-center" style="border-radius: 20px 20px 0 0;">
                    <i class="fa fa-plus-circle fa-3x mb-3"></i>
                    <h3 class="fw-bold mb-1">Tạo Banner Mới</h3>
                    <p class="mb-0 opacity-75">Vui lòng điền đầy đủ thông tin bên dưới</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div class="row g-4">
                            <!-- Left Column: Image + Title -->
                            <div class="col-md-5">
                                <div class="mb-4 text-center">
                                    <label class="fw-bold text-secondary mb-3 d-block">Hình ảnh Banner</label>
                                    
                                    <div id="imagePreviewContainer" class="d-none mb-3">
                                        <img id="preview" src="#" 
                                             class="img-fluid rounded-3 shadow-sm border" 
                                             style="max-height: 220px; width: 100%; object-fit: cover;" />
                                    </div>

                                    <div class="custom-file-input-wrapper border-2 border-dashed rounded-3 p-4 text-center bg-light" id="drop-area">
                                        <i class="fa fa-cloud-upload-alt fa-3x text-muted mb-3"></i>
                                        <p class="mb-2 fw-medium text-dark">Click hoặc kéo thả ảnh vào đây</p>
                                        <input type="file" name="ImageFile" id="ImageFile" 
                                               class="d-none" accept="image/jpeg,image/png,image/webp" 
                                               onchange="previewImage(event)" required />
                                        <label for="ImageFile" class="btn btn-success btn-sm px-4">
                                            Chọn hình ảnh
                                        </label>
                                        <small class="text-muted d-block mt-3">
                                            JPG, PNG, WebP • Tối đa 5MB
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Form Fields -->
                            <div class="col-md-7">
                                <div class="mb-4">
                                    <label asp-for="Title" class="form-label fw-bold text-dark">
                                        Tiêu đề Banner <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="fa fa-tag text-success"></i></span>
                                        <input asp-for="Title" class="form-control border-2 shadow-none" 
                                               placeholder="Ví dụ: Khuyến mãi mùa hè 2024" required />
                                    </div>
                                    <span asp-validation-for="Title" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-dark">Link banner</label>
                                    <input class="form-control border-2 bg-light" 
                                           value="Tự sinh sau khi lưu banner" readonly />
                                    <small class="text-muted">Link sẽ được tạo tự động sau khi lưu.</small>
                                </div>

                                <!-- Products with Toggle Switches -->
                                <div class="mb-5">
                                    <label class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                                        Sản phẩm gán cho banner
                                        <span class="badge bg-success rounded-pill">@(Model.AvailableProducts?.Count ?? 0)</span>
                                    </label>

                                    <div class="border rounded-3 bg-white p-2" 
                                         style="max-height: 360px; overflow-y: auto;">
                                        @if (Model.AvailableProducts == null || !Model.AvailableProducts.Any())
                                        {
                                            <div class="text-center text-muted py-5">
                                                Không có sản phẩm nào để chọn.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var p in Model.AvailableProducts)
                                            {
                                                <div class="product-item d-flex align-items-center justify-content-between py-3 px-3 border-bottom last:border-0">
                                                    <div class="d-flex align-items-center gap-3 flex-grow-1">
                                                        <span class="fw-medium">
                                                            [@p.ProductCode] @p.ProductName
                                                        </span>
                                                        @if (!p.IsActive)
                                                        {
                                                            <span class="badge bg-secondary ms-auto">Ngưng bán</span>
                                                        }
                                                    </div>

                                                    <!-- Modern Toggle Switch -->
                                                    <label class="toggle-switch">
                                                        <input type="checkbox" 
                                                               name="SelectedProductIds" 
                                                               value="@p.ProductId" />
                                                        <span class="slider"></span>
                                                    </label>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                                    <button type="reset" class="btn btn-link text-muted px-4">Reset</button>
                                    <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm" style="border-radius: 12px;">
                                        <i class="fa fa-check-circle me-2"></i> Hoàn tất và Lưu
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f0f2f5;
    }

    .card {
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1) !important;
    }

    .border-dashed {
        border: 2px dashed #ced4da !important;
        transition: all 0.3s ease;
    }

    .border-dashed:hover {
        border-color: #198754 !important;
        background-color: #f8fff9 !important;
    }

    .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.3rem rgba(25, 135, 84, 0.12);
    }

    /* Modern Toggle Switch */
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 52px;
        height: 28px;
        flex-shrink: 0;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #e9ecef;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 50px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 22px;
        width: 22px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 50%;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }

    input:checked + .slider {
        background-color: #198754;
    }

    input:checked + .slider:before {
        transform: translateX(24px);
    }

    .product-item {
        transition: background-color 0.2s ease;
    }

    .product-item:hover {
        background-color: #f8f9fa;
    }

    .product-item:last-child {
        border-bottom: none !important;
    }

    /* Scrollbar */
    .border.rounded-3::-webkit-scrollbar {
        width: 6px;
    }
    
    .border.rounded-3::-webkit-scrollbar-thumb {
        background: #adb5bd;
        border-radius: 20px;
    }
</style>

<script>
    function previewImage(event) {
        var reader = new FileReader();
        reader.onload = function () {
            var container = document.getElementById('imagePreviewContainer');
            var output = document.getElementById('preview');
            output.src = reader.result;
            container.classList.remove('d-none');
        };
        reader.readAsDataURL(event.target.files[0]);
    }
</script>