@model QuanView.Areas.Admin.Models.BannerFormVm
@{
    ViewData["Title"] = "Thêm Banner Mới";
}

<h2>Thêm Banner</h2>
<form asp-action="Create" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="form-group">
        <label>Link banner</label>
        <input class="form-control" value="Tự sinh sau khi lưu banner" readonly />
        <small class="form-text text-muted">Link cố định theo banner. Chọn sản phẩm ngay bên dưới khi tạo mới.</small>
    </div>
    <div class="form-group">
        <label>Chọn hình ảnh</label>
        <input type="file" name="ImageFile" class="form-control" />
    </div>
    <div class="form-group mt-3">
        <label class="fw-bold">Chọn sản phẩm gán cho banner</label>
        <div class="border rounded p-2" style="max-height: 320px; overflow-y: auto;">
            @if (Model.AvailableProducts == null || !Model.AvailableProducts.Any())
            {
                <div class="text-muted">Không có sản phẩm để chọn.</div>
            }
            else
            {
                @foreach (var p in Model.AvailableProducts)
                {
                    <label class="d-flex align-items-center gap-2 py-1 border-bottom">
                        <input type="checkbox" name="SelectedProductIds" value="@p.ProductId" />
                        <span>[@p.ProductCode] @p.ProductName</span>
                        @if (!p.IsActive)
                        {
                            <span class="badge bg-secondary ms-2">Ngưng bán</span>
                        }
                    </label>
                }
            }
        </div>
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
</form>
