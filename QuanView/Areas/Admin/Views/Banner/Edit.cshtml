@model QuanView.Areas.Admin.Models.BannerFormVm
@{
    ViewData["Title"] = "Edit Banner";
    var productLink = Model.ProductLink ?? (Url.Action("SanPhamTheoLink", "Banner", new { area = "", id = Model.Id }) ?? "");
}

<h1>Edit Banner</h1>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label for="imageFile">Upload new image:</label>
                <input type="file" name="imageFile" class="form-control" />
            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="form-group">
                    <label>Current Image:</label>
                    <img src="@Model.ImageUrl" width="300" class="img-thumbnail" />
                </div>
            }

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
            </div>

            <div class="form-group">
                <label class="control-label">Link banner</label>
                <input class="form-control" value="@productLink" readonly />
                <small class="form-text text-muted">Link này luôn dẫn tới danh sách sản phẩm đã gán và không thể sửa tay.</small>
            </div>

            <div class="form-group mt-3">
                <label class="fw-bold">Sản phẩm gán cho banner</label>
                <div class="border rounded p-2" style="max-height: 320px; overflow-y: auto;">
                    @if (Model.AvailableProducts == null || !Model.AvailableProducts.Any())
                    {
                        <div class="text-muted">Không có sản phẩm để chọn.</div>
                    }
                    else
                    {
                        @foreach (var p in Model.AvailableProducts)
                        {
                            var isChecked = Model.SelectedProductIds?.Contains(p.ProductId) == true;
                            <label class="d-flex align-items-center gap-2 py-1 border-bottom">
                                <input type="checkbox"
                                       name="SelectedProductIds"
                                       value="@p.ProductId"
                                       @(isChecked ? "checked" : null) />
                                <span>[@p.ProductCode] @p.ProductName</span>
                                @if (!p.IsActive)
                                {
                                    <span class="badge bg-secondary ms-2">Ngưng bán</span>
                                }
                            </label>
                        }
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
    </div>
</div>
