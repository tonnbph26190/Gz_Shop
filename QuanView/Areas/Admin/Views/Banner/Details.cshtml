@model QuanApi.Data.Banner

@{
    ViewData["Title"] = "Chi tiết Banner";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-end mb-4">
                <div>
                    <h2 class="fw-bold text-dark mb-0">Thông tin Banner</h2>
                </div>
                <div class="btn-group shadow-sm">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                        <i class="fa fa-edit me-2"></i> Chỉnh sửa
                    </a>
                    <a asp-action="Index" class="btn btn-light border px-4">
                        <i class="fa fa-list me-2"></i> Danh sách
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 20px; overflow: hidden;">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h5 class="card-title mb-0 fw-bold text-primary"><i class="fa fa-info-circle me-2"></i> Dữ liệu hệ thống</h5>
                </div>
                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-5 bg-light d-flex align-items-center justify-content-center p-4">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="text-center">
                                    <p class="small text-muted mb-2 text-uppercase fw-bold">Xem trước hình ảnh</p>
                                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow" style="max-height: 250px; object-fit: contain;" />
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted">
                                    <i class="fa fa-image fa-4x mb-3 opacity-25"></i>
                                    <p>Không có hình ảnh</p>
                                </div>
                            }
                        </div>

                        <div class="col-md-7 p-4 p-md-5">
                            <div class="mb-4">
                                <label class="text-uppercase small fw-bold text-secondary mb-1 d-block">Mã số (#@Model.Id)</label>
                            </div>

                            <div class="mb-4">
                                <label class="text-uppercase small fw-bold text-secondary mb-1 d-block">Tiêu đề hiển thị</label>
                                <h4 class="text-dark fw-bold">@Model.Title</h4>
                            </div>

                            <div class="mb-4">
                                <label class="text-uppercase small fw-bold text-secondary mb-1 d-block">Đường dẫn đích (Link)</label>
                                <div class="p-3 bg-light rounded border-start border-primary border-4">
                                    <a href="@Model.Link" target="_blank" class="text-break text-decoration-none">
                                        @Model.Link <i class="fa fa-external-link-alt ms-1 small"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 text-center">
                <p class="text-muted small">
                    <i class="fa fa-clock me-1"></i> Dữ liệu này được hiển thị trực tiếp từ cơ sở dữ liệu.
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }
    .card {
        transition: transform 0.2s ease;
    }
    .breadcrumb-item + .breadcrumb-item::before {
        content: "›";
        font-size: 1.2rem;
        line-height: 1;
    }
</style>