        $(document).on('click', '.btn-delete-image', function () {
            const imageId = $(this).data('id');

            if (!confirm('Xóa ảnh này?')) return;

            $.ajax({
                url: '/Admin/SanPham/DeleteImage?imageId=' + imageId,
                type: 'POST',
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Xóa ảnh thất bại');
                    }
                },
                error: function () {
                    alert('Lỗi xóa ảnh');
                }
            });
        });

        $(document).on('click', '.btn-set-main-image', function () {
            const imageId = $(this).data('id');

            $.ajax({
                url: '/Admin/SanPham/SetMainImage?imageId=' + imageId,
                type: 'POST',
                success: function (res) {
                    if (res.success) {
                        location.reload();
                    } else {
                        alert(res.message || 'Đặt ảnh chính thất bại');
                    }
                },
                error: function () {
                    alert('Lỗi đặt ảnh chính');
                }
            });
        });
