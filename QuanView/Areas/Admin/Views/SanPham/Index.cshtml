<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ====================== GLOBAL MODAL HELPERS ======================
        let confirmCallback = null;

        function showAlert(message, title = "Thông báo") {
            document.getElementById('alertModalLabel').textContent = title;
            document.getElementById('alertMessage').innerHTML = message;
            const modal = new bootstrap.Modal(document.getElementById('alertModal'));
            modal.show();
        }

        function showConfirm(message, callback, title = "Xác nhận") {
            document.getElementById('confirmModalLabel').textContent = title;
            document.getElementById('confirmMessage').innerHTML = message;
            confirmCallback = callback;

            const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
            modal.show();
        }

        // ====================== MODAL EVENT HANDLERS ======================
        document.addEventListener('DOMContentLoaded', function () {

            const confirmYesBtn = document.getElementById('confirmYes');
            const confirmCancelBtn = document.getElementById('confirmCancel');
            const confirmModalEl = document.getElementById('confirmModal');

            if (confirmYesBtn) {
                confirmYesBtn.addEventListener('click', function () {
                    const modal = bootstrap.Modal.getInstance(confirmModalEl);

                    if (modal) {
                        modal.hide();
                    }

                    if (typeof confirmCallback === 'function') {
                        confirmCallback(true);
                    }

                    confirmCallback = null;
                });
            }

            if (confirmCancelBtn) {
                confirmCancelBtn.addEventListener('click', function () {
                    const modal = bootstrap.Modal.getInstance(confirmModalEl);

                    if (modal) {
                        modal.hide();
                    }

                    if (typeof confirmCallback === 'function') {
                        confirmCallback(false);
                    }

                    confirmCallback = null;
                });
            }
        });
        // ====================== PRODUCT STATUS TOGGLE ======================
        document.addEventListener('DOMContentLoaded', function () {
            const toggles = document.querySelectorAll('.product-status-toggle');
            
            toggles.forEach(toggle => {
                toggle.addEventListener('change', async function (e) {
                    const id = this.getAttribute('data-id');
                    const newStatus = this.checked;
                    const originalStatus = this.getAttribute('data-current') === 'true';

                    // Optional: Confirmation when turning OFF
                    if (!newStatus) {
                        if (!confirm('Bạn có chắc muốn NGƯNG HOẠT ĐỘNG sản phẩm này?')) {
                            this.checked = true; // revert
                            return;
                        }
                    }

                    try {
                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                        const response = await fetch(`/Admin/SanPham/ToggleStatus/${id}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token || ''
                            },
                            body: JSON.stringify({ trangThai: newStatus })
                        });

                        const data = await response.json();

                        if (data.success) {
                            showNotification(
                                newStatus ? '✅ Sản phẩm đã hoạt động trở lại!' : '⛔ Sản phẩm đã ngưng hoạt động!', 
                                'success'
                            );
                            
                            // Update data attribute
                            this.setAttribute('data-current', newStatus.toString());
                        } else {
                            showAlert('Lỗi: ' + (data.message || 'Không thể thay đổi trạng thái'));
                            this.checked = originalStatus; // revert
                        }
                    } catch (err) {
                        showAlert('Lỗi kết nối server!');
                        this.checked = originalStatus;
                    }
                });
            });
        });

        // ====================== MAIN PAGE LOGIC ======================
        document.addEventListener('DOMContentLoaded', () => {
            const setupReservationPopups = () => {
                document.querySelectorAll('.reservation-info-wrapper').forEach(wrapper => {
                    wrapper.addEventListener('mouseenter', () => {
                        wrapper.classList.remove('open-left');
                        const popup = wrapper.querySelector('.reservation-popup');
                        if (!popup) return;

                        const estimatedWidth = popup.offsetWidth || 320;
                        const rect = wrapper.getBoundingClientRect();
                        const spaceRight = window.innerWidth - rect.right;
                        const spaceLeft = rect.left;

                        if (spaceRight < estimatedWidth + 20 && spaceLeft > estimatedWidth + 20) {
                            wrapper.classList.add('open-left');
                        }
                    });
                });
            };

            setupReservationPopups();

            // Whole row clickable for collapse
            document.querySelectorAll('.product-main-row').forEach(row => {
                row.addEventListener('click', function(e) {
                    if (e.target.closest('a') || 
                        e.target.closest('button') || 
                        e.target.closest('.form-check-input') ||
                        e.target.closest('.variant-count-badge') ||
                        e.target.closest('.reservation-info-wrapper')) {
                        return;
                    }

                    const toggleBtn = row.querySelector('[data-bs-toggle="collapse"]');
                    if (toggleBtn) {
                        toggleBtn.click();
                    }
                });
            });

            // Auto submit filter when status changes
            document.getElementById('trangThai')?.addEventListener('change', function () {
                this.form.submit();
            });

            // Toggle ngưng bán / bật lại sản phẩm
            document.querySelectorAll('.product-status-toggle').forEach(toggle => {
                toggle.addEventListener('change', function (e) {
                    e.stopPropagation();
                    const input = this;
                    const id = input.dataset.id;
                    const wasActive = input.dataset.current === 'true';
                    const willBeActive = input.checked;

                    input.checked = wasActive;

                    const proceedToggle = () => {
                        fetch(`/Admin/SanPham/ToggleStatus?id=${id}`, { method: 'POST' })
                            .then(r => r.json())
                            .then(data => {
                                if (data.success) {
                                    input.checked = data.trangThai;
                                    input.dataset.current = data.trangThai ? 'true' : 'false';
                                    const label = input.nextElementSibling;
                                    if (label) label.textContent = data.trangThai ? 'Hoạt động' : 'Ngưng';
                                    input.title = data.trangThai ? 'Đang bán' : 'Ngưng bán';
                                    showNotification(data.trangThai ? 'Đã bật bán sản phẩm.' : 'Đã ngưng bán sản phẩm.', 'success');
                                    if (!data.trangThai) setTimeout(() => location.reload(), 800);
                                } else {
                                    showAlert('Lỗi: ' + (data.message || 'Không thể đổi trạng thái'));
                                }
                            })
                            .catch(() => showAlert('Có lỗi xảy ra khi đổi trạng thái sản phẩm.'));
                    };

                    if (!willBeActive) {
                        fetch(`/Admin/SanPham/ActiveOrdersCount?id=${id}`)
                            .then(r => r.json())
                            .then(data => {
                                const count = data.count ?? 0;
                                const orderNote = count > 0
                                    ? `<p>Sản phẩm có <strong>${count}</strong> đơn đang xử lý.</p>`
                                    : '';
                                showConfirm(
                                    `${orderNote}<p>Khi ngưng bán: sản phẩm bị ẩn khỏi catalog, khách không thể đặt mới. <strong>Các đơn đã đặt vẫn được giao bình thường.</strong></p><p>Bạn có chắc muốn ngưng bán?</p>`,
                                    confirmed => { if (confirmed) proceedToggle(); },
                                    'Xác nhận ngưng bán'
                                );
                            })
                            .catch(() => {
                                showConfirm(
                                    '<p>Khi ngưng bán: sản phẩm bị ẩn khỏi catalog, khách không thể đặt mới. Các đơn đã đặt vẫn được giao bình thường.</p><p>Bạn có chắc?</p>',
                                    confirmed => { if (confirmed) proceedToggle(); },
                                    'Xác nhận ngưng bán'
                                );
                            });
                    } else {
                        showConfirm(
                            '<p>Bật lại sản phẩm trên catalog. Các biến thể đã ngưng trước đó vẫn giữ trạng thái ngưng — cần bật từng biến thể nếu muốn bán lại.</p><p>Bạn có chắc?</p>',
                            confirmed => { if (confirmed) proceedToggle(); },
                            'Xác nhận bật bán'
                        );
                    }
                });
            });
        });

        // ====================== IMAGE FUNCTIONS ======================
        function validateImageFiles(input) {
            const allowedExt = ['jpg', 'jpeg', 'png', 'webp'];
            for (let file of input.files) {
                const ext = file.name.split('.').pop().toLowerCase();
                if (!allowedExt.includes(ext)) {
                    showAlert('Chỉ được chọn file ảnh: <strong>JPG, JPEG, PNG, WEBP</strong>');
                    input.value = '';
                    return false;
                }
            }
            return true;
        }

        function previewImageFile() {
            const fileInput = document.getElementById('imageFile');
            const previewDiv = document.getElementById('imagePreview');

            previewDiv.innerHTML = '';
            if (!fileInput.files || fileInput.files.length === 0) {
                previewDiv.style.display = 'none';
                return;
            }

            previewDiv.style.display = 'flex';
            previewDiv.style.flexWrap = 'wrap';
            previewDiv.style.gap = '10px';

            Array.from(fileInput.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.maxWidth = '100px';
                    img.style.maxHeight = '100px';
                    img.style.objectFit = 'cover';
                    img.style.border = '1px solid #ddd';
                    img.style.borderRadius = '6px';
                    previewDiv.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        }

        function addImage() {
            const sanPhamChiTietId = document.getElementById('sanPhamChiTietId').value;
            const fileInput = document.getElementById('imageFile');
            const isMainImage = document.getElementById('isMainImage').checked;
            const addButton = document.querySelector('#addImageModal .btn-primary');

            if (!fileInput.files || !fileInput.files[0]) {
                showAlert('Vui lòng chọn ít nhất một ảnh!');
                return;
            }

            const originalText = addButton.innerHTML;
            addButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang thêm...';
            addButton.disabled = true;

            const formData = new FormData();
            for (let i = 0; i < fileInput.files.length; i++) {
                formData.append('files', fileInput.files[i]);
            }
            formData.append('sanPhamChiTietId', sanPhamChiTietId);
            formData.append('laAnhChinh', isMainImage);

            fetch('/Admin/AnhSanPham/AddImage', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('Thêm ảnh thành công!', 'success');
                    $('#addImageModal').modal('hide');
                    if (data.urls && data.urls.length > 0) {
                        data.urls.forEach((url, index) => {
                            updateProductImageDisplay(sanPhamChiTietId, url, index === 0 && isMainImage);
                        });
                    }
                } else {
                    showAlert('Lỗi: ' + (data.message || 'Không thể thêm ảnh'));
                }
            })
            .catch(error => {
                showAlert('Có lỗi xảy ra: ' + error.message);
            })
            .finally(() => {
                addButton.innerHTML = originalText;
                addButton.disabled = false;
            });
        }

        function setMainImage(imageId) {
            showConfirm('Bạn có chắc muốn đặt ảnh này làm ảnh chính?', (confirmed) => {
                if (!confirmed) return;

                fetch(`/Admin/AnhSanPham/SetMainImage?imageId=${imageId}`, { method: 'PUT' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showNotification('Đã đặt ảnh làm ảnh chính!', 'success');
                            setTimeout(() => location.reload(), 800);
                        } else {
                            showAlert('Lỗi: ' + (data.message || 'Không thể đặt ảnh chính'));
                        }
                    })
                    .catch(() => showAlert('Có lỗi xảy ra khi đặt ảnh chính'));
            });
        }

        function deleteImage(imageId) {
            showConfirm('Bạn có chắc muốn xóa ảnh này không?', (confirmed) => {
                if (!confirmed) return;

                fetch(`/Admin/AnhSanPham/DeleteImage?imageId=${imageId}`, { method: 'DELETE' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showNotification('Đã xóa ảnh thành công!', 'success');
                            setTimeout(() => location.reload(), 800);
                        } else {
                            showAlert('Lỗi: ' + (data.message || 'Không thể xóa ảnh'));
                        }
                    })
                    .catch(() => showAlert('Có lỗi xảy ra khi xóa ảnh'));
            });
        }

        function showNotification(message, type = 'success') {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';

            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 320px;';
            notification.innerHTML = `
                <i class="${icon}"></i> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 5000);
        }

        function previewImage(url) {
            document.getElementById("previewImage").src = url;
            const modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
            modal.show();
        }

        // jQuery handlers for image buttons
        $(document).on('click', '.btn-delete-image', function () {
            const imageId = $(this).data('id');
            deleteImage(imageId);
        });

        $(document).on('click', '.btn-set-main-image', function () {
            const imageId = $(this).data('id');
            setMainImage(imageId);
        });

        // Bootstrap Tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}

<!-- Import Modal -->
<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importModalLabel">
                    <span id="modalStepTitle">Bước 1/3 - Tải dữ liệu</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="importAntiForgeryToken" class="d-none">
                    @Html.AntiForgeryToken()
                </div>
                <!-- Step 1: Upload Data -->
                <div id="importStep1" class="import-step">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        Tải lên file CSV hoặc dán dữ liệu vào ô bên dưới. Nếu chưa có file, hãy tải template mẫu.
                    </div>
                    
                    <div class="mb-3">
                        <label for="importCsvFile" class="form-label fw-bold">
                            <i class="fas fa-file-upload"></i> Chọn file CSV
                        </label>
                        <input type="file" class="form-control" id="importCsvFile" accept=".csv">
                    </div>

                    <div class="mb-3">
                        <label for="importCsvContent" class="form-label fw-bold">
                            <i class="fas fa-paste"></i> Hoặc dán dữ liệu CSV
                        </label>
                        <textarea class="form-control font-monospace" id="importCsvContent" rows="10" 
                                  placeholder="MaSanPham,TenSanPham,TenDanhMuc,TenThuongHieu,..."></textarea>
                    </div>

                    <div class="d-flex gap-2 justify-content-between">
                        <div>
                            <a asp-area="Admin" asp-controller="SanPham" asp-action="DownloadTemplate" 
                               class="btn btn-outline-success btn-sm" target="_blank">
                                <i class="fas fa-download"></i> Tải Template CSV
                            </a>
                            <a asp-area="Admin" asp-controller="SanPham" asp-action="DownloadReferenceData" 
                               class="btn btn-outline-primary btn-sm" target="_blank">
                                <i class="fas fa-download"></i> Tải dữ liệu tham chiếu
                            </a>
                        </div>
                        <button type="button" class="btn btn-primary" id="btnNextStep1">
                            Tiếp tục <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <!-- Step 2: Preview & Validate -->
                <div id="importStep2" class="import-step d-none">
                    <div class="alert alert-success" id="validationSuccess" style="display:none;">
                        <i class="fas fa-check-circle"></i>
                        <span id="validationSummary"></span>
                    </div>
                    
                    <div class="alert alert-warning" id="validationWarnings" style="display:none;">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Cảnh báo:</strong>
                        <ul id="warningList" class="mb-0 mt-2"></ul>
                    </div>

                    <div class="table-responsive border rounded" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-bordered mb-0" id="previewTable">
                            <thead class="table-light sticky-top"></thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="d-flex gap-2 justify-content-between mt-3">
                        <button type="button" class="btn btn-secondary" id="btnBackStep2">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </button>
                        <button type="button" class="btn btn-success" id="btnConfirmImport">
                            <i class="fas fa-check"></i> Xác nhận Import
                        </button>
                    </div>
                </div>

                <!-- Step 3: Import Results -->
                <div id="importStep3" class="import-step d-none">
                    <div class="text-center mb-3" id="importProgress">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Đang import...</span>
                        </div>
                        <p class="mt-2">Đang import dữ liệu, vui lòng đợi...</p>
                    </div>

                    <div id="importResults" style="display:none;">
                        <div class="alert alert-success" id="successSection" style="display:none;">
                            <h6><i class="fas fa-check-circle"></i> Thành công (<span id="successCount">0</span>)</h6>
                            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th>Dòng</th><th>Nội dung</th></tr></thead>
                                    <tbody id="successList"></tbody>
                                </table>
                            </div>
                        </div>

                        <div class="alert alert-danger" id="errorSection" style="display:none;">
                            <h6><i class="fas fa-exclamation-circle"></i> Lỗi (<span id="errorCount">0</span>)</h6>
                            <div class="table-responsive" style="max-height: 200px; overflow-y: auto;">
                                <table class="table table-sm mb-0">
                                    <thead><tr><th>Dòng</th><th>Lý do</th><th>Preview</th></tr></thead>
                                    <tbody id="errorList"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-3" id="resultActions" style="display:none;">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Đóng
                        </button>
                        <button type="button" class="btn btn-primary" id="btnImportMore">
                            <i class="fas fa-upload"></i> Import tiếp
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/admin/sanpham-import.js"></script>
