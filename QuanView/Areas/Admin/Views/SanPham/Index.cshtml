<h2 class="mb-4">Danh sách sản phẩm</h2>

<p class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <a asp-area="Admin" asp-controller="SanPham" asp-action="Create" class="btn btn-success">+ Thêm sản phẩm mới</a>
    <a asp-area="Admin" asp-controller="SanPham" asp-action="ExportCsv"
       asp-route-keyword="@Model.Keyword"
       asp-route-trangThai="@Model.TrangThai"
       asp-route-priceFrom="@Model.PriceFrom"
       asp-route-priceTo="@Model.PriceTo"
       asp-route-qtyFrom="@Model.QtyFrom"
       asp-route-qtyTo="@Model.QtyTo"
       asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")"
       asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")"
       class="btn btn-outline-secondary">
        <i class="fas fa-download"></i> Export CSV
    </a>
    <a asp-area="Admin" asp-controller="SanPham" asp-action="ImportCsv" class="btn btn-outline-primary">
        <i class="fas fa-upload"></i> Import CSV
    </a>
</p>

<!-- Bộ lọc -->
<div class="card mb-4 filter-card">
    <div class="card-header">
        <h5 class="mb-0"><i class="fas fa-filter"></i> Bộ lọc sản phẩm</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-area="Admin" asp-controller="SanPham" asp-action="Index" class="row g-3 filter-form">
            <!-- Từ khóa tìm kiếm -->
            <div class="col-md-3">
                <label for="keyword" class="form-label">Tìm kiếm: </label>
                <input type="text" class="form-control" id="keyword" name="keyword" value="@Model.Keyword" placeholder="Tên sản phẩm, mã sản phẩm...">
            </div>
            
            <!-- Trạng thái -->
            <div class="col-md-3">
                <label for="trangThai" class="form-label">Trạng thái</label><br>
                <select class="form-control" id="trangThai" name="trangThai">
                    @foreach (var option in Model.TrangThaiOptions)
                    {
                        <option value="@option.Value" selected="@(option.Value == Model.TrangThai)">@option.Text</option>
                    }
                </select>
            </div>
            
            <!-- Khoảng giá -->
            <div class="col-md-2">
                <label for="priceFrom" class="form-label">Giá từ</label>
                <input type="number" class="form-control" id="priceFrom" name="priceFrom" value="@Model.PriceFrom" placeholder="0" min="0">
            </div>
            
            <div class="col-md-2">
                <label for="priceTo" class="form-label">Giá đến</label>
                <input type="number" class="form-control" id="priceTo" name="priceTo" value="@Model.PriceTo" placeholder="999999999" min="0">
            </div>
            
            <!-- Khoảng số lượng -->
            <div class="col-md-1">
                <label for="qtyFrom" class="form-label">SL từ</label>
                <input type="number" class="form-control" id="qtyFrom" name="qtyFrom" value="@Model.QtyFrom" placeholder="0" min="0">
            </div>
            
            <div class="col-md-1">
                <label for="qtyTo" class="form-label">SL đến</label>
                <input type="number" class="form-control" id="qtyTo" name="qtyTo" value="@Model.QtyTo" placeholder="9999" min="0">
            </div>
            
            <!-- Khoảng ngày -->
            <div class="col-md-2">
                <label for="dateFrom" class="form-label">Ngày từ</label>
                <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")">
            </div>
            
            <div class="col-md-2">
                <label for="dateTo" class="form-label">Ngày đến</label>
                <input type="date" class="form-control" id="dateTo" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")">
            </div>
            
            <!-- Nút tìm kiếm -->
            <div class="col-md-3 pt-4 mt-2">
                <button type="submit" class="btn btn-primary me-2 btn-filter">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
                &nbsp;
                &nbsp;
                <a asp-area="Admin" asp-controller="SanPham" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-refresh"></i> Làm mới
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Thông tin kết quả -->
<div class="result-info">
    <div class="row">
        <div class="col-md-6">
            <p class="mb-0">
                <i class="fas fa-info-circle"></i>
                Hiển thị <strong>@((Model.CurrentPage - 1) * Model.PageSize + 1)</strong> - 
                <strong>@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)</strong> 
                trong tổng số <strong>@Model.TotalItems</strong> sản phẩm
            </p>
        </div>
        <div class="col-md-6 text-end">
            <p class="mb-0">
                <i class="fas fa-file-alt"></i>
                Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong>
            </p>
        </div>
    </div>
</div>

    @if (!Model.SanPhams.Any())
    {
        <div class="alert alert-info">
            Không có sản phẩm nào được tìm thấy.
        </div>
    }
    else
    {
        @foreach (var item in Model.SanPhams)
        {
            <div class="product-group">
                <!-- Sản phẩm chính -->
                <table class="table table-bordered mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 70px;">Ảnh</th>
                            <th style="width: 110px;">Mã SP</th>
                            <th style="min-width: 200px;">Tên SP</th>
                            <th style="width: 90px;">Chất liệu</th>
                            <th style="width: 90px;">Danh mục</th>
                            <th style="width: 100px;">Thương hiệu</th>
                            <th style="width: 85px;">Loại ống</th>
                            <th style="width: 90px;">Kiểu dáng</th>
                            <th style="width: 90px;">Lưng quần</th>
                            <th style="width: 70px;">Xếp ly</th>
                            <th style="width: 70px;">Co giãn</th>
                            <th style="width: 110px;">Trạng thái</th>
                            <th style="width: 90px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="product-main-row">
                            <td class="product-image-cell">
                                <img src="@(item.AnhChinh ?? "/img/default-product.jpg")" style="max-width:60px;max-height:60px" />
                            </td>
                            <td><strong>@item.MaSanPham</strong></td>
                            <td>
                                <div class="d-flex align-items-center justify-content-between">
                                    <strong class="me-2">@item.TenSanPham</strong>
                                    @if (item.ChiTietSanPhams != null && item.ChiTietSanPhams.Any())
                                    {
                                        <span class="variant-count-badge flex-shrink-0">
                                            <i class="fas fa-layer-group"></i> @item.ChiTietSanPhams.Count
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>@item.TenChatLieu</td>
                            <td>@item.TenDanhMuc</td>
                            <td>@item.TenThuongHieu</td>
                            <td>@item.TenLoaiOng</td>
                            <td>@item.TenKieuDang</td>
                            <td>@item.TenLungQuan</td>
                            <td class="text-center">
                                @if (item.CoXepLy)
                                {
                                    <span class="badge bg-success">Có</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Không</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.CoGian)
                                {
                                    <span class="badge bg-success">Có</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Không</span>
                                }
                            </td>
                            <td>
                                <div class="form-check form-switch" title="@(item.TrangThai ? "Đang bán" : "Ngưng bán")">
                                    <input class="form-check-input product-status-toggle" type="checkbox" role="switch"
                                           data-id="@item.IDSanPham" data-current="@item.TrangThai.ToString().ToLowerInvariant()"
                                           @(item.TrangThai ? "checked" : "") />
                                    <label class="form-check-label small">@(item.TrangThai ? "Hoạt động" : "Ngưng")</label>
                                </div>
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="SanPham" asp-action="Edit" asp-route-id="@item.IDSanPham" 
                                   class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit"></i> Sửa
                                </a>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <!-- Biến thể của sản phẩm -->
                @if (item.ChiTietSanPhams != null && item.ChiTietSanPhams.Any())
                {
                    <div class="variant-section">
                        <table class="table table-sm table-bordered mb-0">
                            <thead>
                                <tr class="variant-header">
                                    <th style="width: 100px;"><i class="fas fa-ruler"></i> Kích cỡ</th>
                                    <th style="width: 120px;"><i class="fas fa-palette"></i> Màu sắc</th>
                                    <th style="width: 120px;"><i class="fas fa-paint-brush"></i> Họa tiết</th>
                                    <th style="width: 100px;"><i class="fas fa-boxes"></i> Số lượng</th>
                                    <th style="width: 150px;"><i class="fas fa-tag"></i> Giá bán</th>
                                    <th style="width: 100px;"><i class="fas fa-image"></i> Ảnh SP</th>
                                    <th style="width: 150px;"><i class="fas fa-cog"></i> Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ct in item.ChiTietSanPhams)
                                {
                                    <tr class="variant-row">
                                        <td><span class="badge bg-info">@ct.TenKichCo</span></td>
                                        <td><span class="badge bg-primary">@ct.TenMauSac</span></td>
                                        <td>@(ct.TenHoaTiet ?? "-")</td>
                                        <td class="text-center">
                                            <strong class="text-primary">@ct.SoLuong</strong>
                                        </td>
                                        <td>
                                            @if (ct.originalPrice > ct.price)
                                            {
                                                <div>
                                                    <span style="color:#888;text-decoration:line-through;font-size:0.9em;">
                                                        @ct.originalPrice.ToString("N0") đ
                                                    </span>
                                                </div>
                                                <div>
                                                    <span style="color:#d32f2f;font-weight:bold;font-size:1.05em">
                                                        @ct.price.ToString("N0") đ
                                                    </span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="font-weight:bold;color:#28a745">
                                                    @ct.price.ToString("N0") đ
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="product-images-container" data-sanchitiet-id="@ct.IdSanPhamChiTiet">
                                                <div class="images-preview">
                                                    @if (!string.IsNullOrEmpty(ct.AnhDaiDien))
                                                    {
                                                        <img src="@ct.AnhDaiDien" class="img-thumbnail" 
                                                             style="max-width:50px;max-height:50px;border-radius:4px;" alt="Ảnh chính" />

                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small"><i class="fas fa-image"></i> Chưa có ảnh</span>
                                                    }
                                                </div>
                                                <div class="images-list" style="display:none;"></div>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-success"
                                                    onclick="showAddImageModal('@ct.IdSanPhamChiTiet')">
                                                <i class="fas fa-plus-circle"></i> Thêm ảnh
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }
        
        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Phân trang sản phẩm" class="mt-4">
                <ul class="pagination justify-content-center">
                    <!-- Nút Trang đầu -->
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { 
                                page = 1, 
                                keyword = Model.Keyword,
                                trangThai = Model.TrangThai,
                                priceFrom = Model.PriceFrom,
                                priceTo = Model.PriceTo,
                                qtyFrom = Model.QtyFrom,
                                qtyTo = Model.QtyTo,
                                dateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"),
                                dateTo = Model.DateTo?.ToString("yyyy-MM-dd")
                            })">
                                <i class="fas fa-angle-double-left"></i>
                            </a>
                        </li>
                    }
                    
                    <!-- Nút Trang trước -->
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { 
                                page = Model.CurrentPage - 1, 
                                keyword = Model.Keyword,
                                trangThai = Model.TrangThai,
                                priceFrom = Model.PriceFrom,
                                priceTo = Model.PriceTo,
                                qtyFrom = Model.QtyFrom,
                                qtyTo = Model.QtyTo,
                                dateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"),
                                dateTo = Model.DateTo?.ToString("yyyy-MM-dd")
                            })">
                                <i class="fas fa-angle-left"></i>
                            </a>
                        </li>
                    }
                    
                    <!-- Các trang số -->
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }
                    
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { 
                                page = i, 
                                keyword = Model.Keyword,
                                trangThai = Model.TrangThai,
                                priceFrom = Model.PriceFrom,
                                priceTo = Model.PriceTo,
                                qtyFrom = Model.QtyFrom,
                                qtyTo = Model.QtyTo,
                                dateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"),
                                dateTo = Model.DateTo?.ToString("yyyy-MM-dd")
                            })">@i</a>
                        </li>
                    }
                    
                    <!-- Nút Trang sau -->
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { 
                                page = Model.CurrentPage + 1, 
                                keyword = Model.Keyword,
                                trangThai = Model.TrangThai,
                                priceFrom = Model.PriceFrom,
                                priceTo = Model.PriceTo,
                                qtyFrom = Model.QtyFrom,
                                qtyTo = Model.QtyTo,
                                dateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"),
                                dateTo = Model.DateTo?.ToString("yyyy-MM-dd")
                            })">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </li>
                    }
                    
                    <!-- Nút Trang cuối -->
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { 
                                page = Model.TotalPages, 
                                keyword = Model.Keyword,
                                trangThai = Model.TrangThai,
                                priceFrom = Model.PriceFrom,
                                priceTo = Model.PriceTo,
                                qtyFrom = Model.QtyFrom,
                                qtyTo = Model.QtyTo,
                                dateFrom = Model.DateFrom?.ToString("yyyy-MM-dd"),
                                dateTo = Model.DateTo?.ToString("yyyy-MM-dd")
                            })">
                                <i class="fas fa-angle-double-right"></i>
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }

<!-- Modal thêm ảnh -->
<div class="modal fade" id="addImageModal" tabindex="-1" aria-labelledby="addImageModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addImageModalLabel">Thêm ảnh sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addImageForm" enctype="multipart/form-data">
                    <input type="hidden" id="sanPhamChiTietId" />
                    <div class="mb-3">
                        <label for="imageFile" class="form-label">Chọn ảnh từ máy</label>
                        <input type="file" class="form-control" id="imageFile" accept="image/*" required onchange="previewImageFile()">
                        <div id="imagePreview" class="image-upload-preview" style="display:none;">
                            <img id="previewImg" src="" alt="Preview" style="max-width:100px;max-height:100px;">
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isMainImage">
                        <label class="form-check-label" for="isMainImage">Đặt làm ảnh chính</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="addImage()">Thêm ảnh</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Whole row clickable → triggers the button
            document.querySelectorAll('.product-main-row').forEach(row => {
                row.addEventListener('click', function(e) {
                    // Don't interfere with real buttons/links/switches
                    if (e.target.closest('a') || 
                        e.target.closest('button') || 
                        e.target.closest('.form-check-input') ||
                        e.target.closest('.variant-count-badge')) {
                        return;
                    }

                    const toggleBtn = row.querySelector('[data-bs-toggle="collapse"]');
                    if (toggleBtn) {
                        toggleBtn.click();  // This uses Bootstrap 5's JS
                    }
                });
            });

            // Keep aria-expanded in sync (for screen readers & your CSS)
            document.querySelectorAll('.collapse').forEach(collapse => {
                const triggerRow = document.querySelector(`[aria-controls="${collapse.id}"]`)?.closest('tr');
                if (!triggerRow) return;

                collapse.addEventListener('show.bs.collapse', () => {
                    triggerRow.setAttribute('aria-expanded', 'true');
                });

                collapse.addEventListener('hide.bs.collapse', () => {
                    triggerRow.setAttribute('aria-expanded', 'false');
                });
            });
        });
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.main-row').forEach(row => {
                row.addEventListener('click', function (e) {
                    if (e.target.closest('a') || 
                        e.target.closest('button:not([data-toggle="collapse"])') || 
                        e.target.closest('.form-check-input')) {
                        return;
                    }
                    const toggleBtn = row.querySelector('button[data-toggle="collapse"]');
                    if (toggleBtn) {
                        toggleBtn.click();
                    }
                });
            });
        });
        // Tự động submit form khi thay đổi trạng thái bộ lọc
        document.getElementById('trangThai')?.addEventListener('change', function () {
            this.form.submit();
        });

        // Đổi trạng thái sản phẩm (Hoạt động / Ngưng) và lưu
        document.querySelectorAll('.product-status-toggle').forEach(function (el) {
            el.addEventListener('change', function () {
                var id = this.getAttribute('data-id');
                var row = this.closest('tr');
                var label = row.querySelector('.form-check-label');
                var checked = this.checked;
                var newStatus = checked;

                fetch('/Admin/SanPham/ToggleStatus?id=' + encodeURIComponent(id), { method: 'POST' })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.success) {
                            label.textContent = data.trangThai ? 'Hoạt động' : 'Ngưng';
                            if (typeof showNotification === 'function') showNotification('Đã lưu trạng thái.', 'success');
                        } else {
                            this.checked = !checked;
                            label.textContent = this.checked ? 'Hoạt động' : 'Ngưng';
                            if (typeof showNotification === 'function') showNotification('Lỗi: ' + (data.message || 'Không lưu được.'), 'error');
                        }
                    }.bind(this))
                    .catch(function (err) {
                        this.checked = !checked;
                        label.textContent = this.checked ? 'Hoạt động' : 'Ngưng';
                        if (typeof showNotification === 'function') showNotification('Lỗi: ' + err.message, 'error');
                    }.bind(this));
            });
        });
        // Hiển thị modal thêm ảnh
        function showAddImageModal(sanPhamChiTietId) {
            document.getElementById('sanPhamChiTietId').value = sanPhamChiTietId;
            document.getElementById('imageFile').value = ''; // Clear file input
            document.getElementById('isMainImage').checked = false;
            document.getElementById('imagePreview').style.display = 'none';
            const modalElement = document.getElementById('addImageModal');
            if (modalElement) {
                // Bootstrap 4
                $(modalElement).modal('show');
            }
        }

        // Preview ảnh khi chọn file
        function previewImageFile() {
            const fileInput = document.getElementById('imageFile');
            const previewDiv = document.getElementById('imagePreview');
            const previewImg = document.getElementById('previewImg');

            if (fileInput.files && fileInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImg.src = e.target.result;
                    previewDiv.style.display = 'block';
               
                };

                reader.readAsDataURL(fileInput.files[0]);
                
            } else {
                previewDiv.style.display = 'none';
            }
        }
        // Thêm ảnh mới
        function addImage() {
            const sanPhamChiTietId = document.getElementById('sanPhamChiTietId').value;
            const fileInput = document.getElementById('imageFile');
            const isMainImage = document.getElementById('isMainImage').checked;
            const addButton = document.querySelector('#addImageModal .btn-primary');

            if (!fileInput.files || !fileInput.files[0]) {
                alert('Vui lòng chọn ảnh!');
                return;
            }

            // Hiển thị loading
            
            const originalText = addButton.innerHTML;
            addButton.innerHTML = '<span class="loading-spinner"></span> Đang thêm...';
            addButton.disabled = true;

            // Tạo FormData để upload file
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('sanPhamChiTietId', sanPhamChiTietId);
            formData.append('laAnhChinh', isMainImage);

            fetch('/Admin/AnhSanPham/UploadImage', {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                    showNotification('Thêm ảnh thành công!', 'success');
                    
                   
                    $('#addImageModal').modal('hide');

                        updateProductImageDisplay(sanPhamChiTietId, data.urlAnh, isMainImage);
                } else {
                        showNotification('Lỗi: ' + (data.message || 'Không thể thêm ảnh'), 'error');
                }
            })
            .catch(error => {
               
                showNotification('Có lỗi xảy ra khi thêm ảnh: ' + error.message, 'error');
            })
            .finally(() => {
               
                addButton.innerHTML = originalText;
                addButton.disabled = false;
            });
        }

        // Hiển thị thông báo

        function showNotification(message, type) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'fas fa-check-circle' : 'fas fa-exclamation-circle';
           
            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
            notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; min-width: 300px;';
            notification.innerHTML = `
                         <i class="${icon}"></i> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;
            
            document.body.appendChild(notification);
            
            // Tự động ẩn sau 5 giây
            setTimeout(() => {
                if (notification.parentNode) {
                    notification.remove();
                }
            }, 5000);
        }

        // Đặt ảnh làm ảnh chính
        function setMainImage(imageId) {
            if (!confirm('Bạn có chắc muốn đặt ảnh này làm ảnh chính?')) {
                return;
            }

            fetch(`/Admin/AnhSanPham/SetMainImage?imageId=${imageId}`, {
                method: 'PUT'
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.text().then(text => {
                        try {
                            return JSON.parse(text);
                        } catch (e) {
                            console.error('Invalid JSON response:', text);
                            throw new Error('Server returned invalid JSON: ' + text.substring(0, 100));
                        }
                    });
                })
                .then(data => {
                    if (data.success) {
                        showNotification('Đã đặt ảnh làm ảnh chính!', 'success');
                        // Reload danh sách ảnh
                        const container = document.querySelector(`[data-sanchitiet-id="${sanPhamChiTietId}"]`);
                        const sanPhamChiTietId = container.dataset.sanPhamChiTietId;

                        // Cập nhật giao diện chính - cần lấy URL của ảnh vừa đặt làm chính
                        // Tạm thời reload lại toàn bộ để đảm bảo hiển thị đúng
                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    } else {
                        showNotification('Lỗi: ' + (data.message || 'Không thể đặt ảnh chính'), 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Có lỗi xảy ra khi đặt ảnh chính: ' + error.message, 'error');
                });
        }

        // Xóa ảnh
        function deleteImage(imageId) {
            if (!confirm('Bạn có chắc muốn xóa ảnh này?')) {
                return;
            }

            fetch(`/Admin/AnhSanPham/DeleteImage?imageId=${imageId}`, {
                method: 'DELETE'
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.text().then(text => {
                        try {
                            return JSON.parse(text);
                        } catch (e) {
                            console.error('Invalid JSON response:', text);
                            throw new Error('Server returned invalid JSON: ' + text.substring(0, 100));
                        }
                    });
                })
                .then(data => {
                    if (data.success) {
                        showNotification('Đã xóa ảnh thành công!', 'success');
                        // Reload danh sách ảnh
                        const container = document.querySelector(`[data-sanchitiet-id="${sanPhamChiTietId}"]`);
                        const sanPhamChiTietId = container.dataset.sanPhamChiTietId;

                        // Cập nhật giao diện chính nếu xóa ảnh chính
                        // Tạm thời reload lại toàn bộ để đảm bảo hiển thị đúng
                        setTimeout(() => {
                            location.reload();
                        }, 1000);
                    } else {
                        showNotification('Lỗi: ' + (data.message || 'Không thể xóa ảnh'), 'error');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Có lỗi xảy ra khi xóa ảnh: ' + error.message, 'error');
                });
        }

        // Cập nhật hiển thị ảnh trong bảng chính
        function updateProductImageDisplay(sanPhamChiTietId, imageUrl, isMainImage) {
            // Tìm container ảnh sản phẩm trong bảng
            const container = document.querySelector(`[data-sanchitiet-id="${sanPhamChiTietId}"]`);
            if (!container) {
                console.warn('Không tìm thấy container cho sanPhamChiTietId:', sanPhamChiTietId);
                return;
            }

            const previewDiv = container.querySelector('.images-preview');
            if (!previewDiv) {
                console.warn('Không tìm thấy preview div');
                return;
            }

            // Nếu là ảnh chính hoặc chưa có ảnh nào, cập nhật hiển thị
            if (isMainImage || previewDiv.querySelector('span.text-muted')) {
                previewDiv.innerHTML = `
                            <img src="${imageUrl}" class="img-thumbnail" style="max-width:50px;max-height:50px" alt="Ảnh chính" />
                        `;
            }
        }

        // Cập nhật hiển thị ảnh sau khi đặt ảnh chính
        function updateMainImageDisplay(sanPhamChiTietId, mainImageUrl) {
            const container = document.querySelector(`[data-sanchitiet-id="${sanPhamChiTietId}"]`);
            if (!container) return;

            const previewDiv = container.querySelector('.images-preview');
            if (!previewDiv) return;

            if (mainImageUrl) {
                previewDiv.innerHTML = `
                            <img src="${mainImageUrl}" class="img-thumbnail" style="max-width:50px;max-height:50px" alt="Ảnh chính" />
                        `;
            } else {
                previewDiv.innerHTML = '<span class="text-muted small">Chưa có ảnh</span>';
            }
        }

    </script>
}
