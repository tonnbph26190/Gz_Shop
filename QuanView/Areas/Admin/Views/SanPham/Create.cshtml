@model QuanView.Areas.Admin.Models.SanPhamDto

@{
    ViewData["Title"] = "Thêm sản phẩm";
    @using System.Web
}

<style>
    /* Slider animation for the variant selection checkboxes */
    .variant-selector .form-check {
        display: flex;
        align-items: center;
        padding-left: 0;
        margin-bottom: 8px;
    }

    .variant-selector .form-check-input {
        width: 2.5rem;
        height: 1.25rem;
        margin-left: 0;
        margin-right: 10px;
        cursor: pointer;
        float: none; /* Reset bootstrap float */
    }

    .variant-selector .form-check-label {
        cursor: pointer;
        user-select: none;
    }

    /* Input styling */
    .is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
    }
    
    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    input[type="number"] { -moz-appearance: textfield; }

    .add-btn {
        width: 42px;
        height: 100%;                    
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #0d6efd;
        color: white;
        border: 1px solid #0d6efd;
        border-top-right-radius: 6px;
        border-bottom-right-radius: 6px;
        font-size: 18px;
        cursor: pointer;
        transition: all 0.2s ease;
        margin-left: -1px;             
        flex-shrink: 0;
        padding: 2.5% 0%;
    }

    .add-btn:hover {
        background-color: #0b5ed7;
        border-color: #0b5ed7;
    }

    .add-btn:active {
        background-color: #0a58ca;
    }

    /* Container for label + button */
    .d-flex.align-items-center.gap-2 {
        margin-bottom: 6px;
    }

    /* Layout for label + button */
    .field-with-add {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .field-with-add .form-label {
        margin-bottom: 0;
        flex-grow: 1;
    }

    @@media (max-width: 768px) {
        .add-btn {
            width: 38px;
            font-size: 16px;
        }
    }
</style>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Thêm sản phẩm</h5>
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p class="mb-0">@error.ErrorMessage</p>
                }
            </div>
        }

        <form asp-area="Admin" asp-controller="SanPham" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6 col-lg-4">
                            <label class="fw-bold mb-2" for="sanPhamDaCo">
                                <i class="fas fa-search me-1"></i> Sản phẩm gốc:
                            </label>
                            <select id="sanPhamDaCo" name="SanPhamDaCoId" class="form-select border-primary">
                                <option value="">-- Tạo sản phẩm mới --</option>
                                @if (ViewBag.SanPhams != null)
                                {
                                    foreach (var sp in ViewBag.SanPhams as List<SelectListItem>)
                                    {
                                        <option value="@sp.Value">@sp.Text</option>
                                    }
                                }
                            </select>
                            <div class="form-text text-muted small">Chọn sản phẩm có sẵn để kế thừa thông tin.</div>
                        </div>
                    </div>

                    <hr class="my-4 text-secondary opacity-25">

                    <div id="thongTinSanPhamMoi">
                        <h6 class="mb-3 text-primary fw-bold">Thông tin chi tiết sản phẩm</h6>
                        <div class="row g-3">
                            <div class="col-md-6 col-lg-3">
                                <label asp-for="MaSanPham" class="form-label fw-bold">Mã Sản Phẩm</label>
                                <div class="input-group">
                                    <input asp-for="MaSanPham" class="form-control bg-light" readonly />
                                    <button type="button" class="btn btn-outline-secondary" onclick="generateProductCode()">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-6 col-lg-9">
                                <label asp-for="TenSanPham" class="form-label fw-bold">Tên Sản Phẩm</label>
                                <input asp-for="TenSanPham" class="form-control" placeholder="Nhập tên sản phẩm..." />
                                <span asp-validation-for="TenSanPham" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4 col-lg-3">
                                <label asp-for="IDDanhMuc" class="form-label fw-bold mb-1">Danh mục</label>
                                <div class="input-group">
                                    <select asp-for="IDDanhMuc" class="form-select" asp-items="ViewBag.DanhMucs">
                                        <option value="">-- Chọn danh mục --</option>
                                    </select>
                                    <button type="button" class="add-btn" id="btnAddDanhMuc" title="Thêm danh mục mới">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4 col-lg-3">
                                <label asp-for="IDThuongHieu" class="form-label fw-bold mb-1">Thương hiệu</label>
                                <div class="input-group">
                                    <select asp-for="IDThuongHieu" class="form-select" asp-items="ViewBag.ThuongHieus">
                                        <option value="">-- Chọn thương hiệu --</option>
                                    </select>
                                    <button type="button" class="add-btn" id="btnAddThuongHieu" title="Thêm thương hiệu mới">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4 col-lg-3">
                                <label asp-for="IDChatLieu" class="form-label fw-bold mb-1">Chất liệu</label>
                                <div class="input-group">
                                    <select asp-for="IDChatLieu" class="form-select" asp-items="ViewBag.ChatLieus">
                                        <option value="">-- Chọn chất liệu --</option>
                                    </select>
                                    <button type="button" class="add-btn" id="btnAddChatLieu" title="Thêm chất liệu mới">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4 col-lg-3">
                                <label asp-for="IDLoaiOng" class="form-label fw-bold mb-1">Loại ống</label>
                                <div class="input-group">
                                    <select asp-for="IDLoaiOng" class="form-select" asp-items="ViewBag.LoaiOngs">
                                        <option value="">-- Chọn loại ống --</option>
                                    </select>
                                    <button type="button" class="add-btn" id="btnAddLoaiOng" title="Thêm loại ống mới">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4 col-lg-3">
                                <label asp-for="IDKieuDang" class="form-label fw-bold mb-1">Kiểu dáng</label>
                                <div class="input-group">
                                    <select asp-for="IDKieuDang" class="form-select" asp-items="ViewBag.KieuDangs">
                                        <option value="">-- Chọn kiểu dáng --</option>
                                    </select>
                                    <button type="button" class="add-btn" id="btnAddKieuDang" title="Thêm kiểu dáng mới">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="col-md-4 col-lg-3">
                                <label asp-for="IDLungQuan" class="form-label fw-bold mb-1">Lưng quần</label>
                                <div class="input-group">
                                    <select asp-for="IDLungQuan" class="form-select" asp-items="ViewBag.LungQuans">
                                        <option value="">-- Chọn lưng quần --</option>
                                    </select>
                                    <button type="button" class="add-btn" id="btnAddLungQuan" title="Thêm lưng quần mới">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr />
            <div class="mb-4">
                <div class="d-flex align-items-center mb-3">
                    <h5 class="text-primary mb-0"><i class="fas fa-cog me-2"></i>Cấu hình chung</h5>
                    <div class="flex-grow-1 ms-3"><hr class="my-0 opacity-25"></div>
                </div>
                
                <div class="row g-3">
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="p-3 border rounded bg-white shadow-sm h-100">
                            <div class="form-check form-switch m-0">
                                <input asp-for="CoXepLy" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="CoXepLy" class="form-check-label fw-bold">Có xếp ly</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="p-3 border rounded bg-white shadow-sm h-100">
                            <div class="form-check form-switch m-0">
                                <input asp-for="CoGian" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="CoGian" class="form-check-label fw-bold">Co giãn</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-4 col-lg-3">
                        <div class="p-3 border border-success rounded bg-white shadow-sm h-100">
                            <div class="form-check form-switch m-0">
                                <input asp-for="TrangThai" class="form-check-input" type="checkbox" role="switch" checked>
                                <label asp-for="TrangThai" class="form-check-label fw-bold text-success">Đang kinh doanh</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="fas fa-tags me-2 text-primary"></i>Phân loại biến thể</h5>
                </div>
                <div class="card-body bg-light row g-3 variant-selector">
                    <div class="col-md-4">
                        <div class="bg-white p-3 border rounded h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="fw-bold mb-0">
                                    Kích cỡ <i class="fas fa-ruler ms-1 text-muted"></i>
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" id="btnAddKichCo" style="width: 28px; height: 28px; padding: 0;" title="Thêm kích cỡ">
                                    <i class="fas fa-plus small"></i>
                                </button>
                            </div>
                            <div id="kichCoSelect" style="max-height: 200px; overflow-y: auto;" class="pe-2">
                                @if (ViewBag.KichCos != null) {
                                    foreach (var item in ViewBag.KichCos as List<SelectListItem>) {
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input kichCoCheckbox" type="checkbox" role="switch" value="@item.Value" id="kc_@item.Value">
                                            <label class="form-check-label" for="kc_@item.Value">@item.Text</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="bg-white p-3 border rounded h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="fw-bold mb-0">
                                    Màu sắc <i class="fas fa-palette ms-1 text-muted"></i>
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" id="btnAddMauSac" style="width: 28px; height: 28px; padding: 0;" title="Thêm màu sắc">
                                    <i class="fas fa-plus small"></i>
                                </button>
                            </div>
                            <div id="mauSacSelect" style="max-height: 200px; overflow-y: auto;" class="pe-2">
                                @if (ViewBag.MauSacs != null) {
                                    foreach (var item in ViewBag.MauSacs as List<SelectListItem>) {
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input mauSacCheckbox" type="checkbox" role="switch" value="@item.Value" id="ms_@item.Value">
                                            <label class="form-check-label" for="ms_@item.Value">@item.Text</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="bg-white p-3 border rounded h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="fw-bold mb-0">
                                    Họa tiết <i class="fas fa-cut ms-1 text-muted"></i>
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" id="btnAddHoaTiet" style="width: 28px; height: 28px; padding: 0;" title="Thêm họa tiết">
                                    <i class="fas fa-plus small"></i>
                                </button>
                            </div>
                            <div id="hoaTietSelect" style="max-height: 200px; overflow-y: auto;" class="pe-2">
                                @if (ViewBag.HoaTiets != null) {
                                    foreach (var item in ViewBag.HoaTiets as List<SelectListItem>) {
                                        <div class="form-check form-switch mb-2">
                                            <input class="form-check-input hoaTietCheckbox" type="checkbox" role="switch" value="@item.Value" id="ht_@item.Value">
                                            <label class="form-check-label" for="ht_@item.Value">@item.Text</label>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="button" class="btn btn-primary btn-lg px-4" onclick="generateVariants()">
                            <i class="fas fa-layer-group me-2"></i>Tạo bảng biến thể
                        </button>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="variantTable">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Kích cỡ</th>
                                <th>Màu sắc</th>
                                <th>Họa tiết</th>
                                <th style="width: 150px;">Số lượng</th>
                                <th style="width: 220px;">Giá bán (VNĐ)</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="mt-4 text-end">
                <a asp-action="Index" class="btn btn-secondary px-4 me-2">Quay lại</a>
                <button type="submit" class="btn btn-success px-5">Lưu sản phẩm</button>
            </div> 
        </form>
    </div>
</div>

<input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken()

<!-- Modal Thêm mới -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="createModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body" id="createModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" id="saveCreateBtn">Thêm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).on('click', '[data-bs-dismiss="modal"]', function() {
            const modalElement = document.getElementById('createModal');
            const modalInstance = bootstrap.Modal.getInstance(modalElement);
            if (modalInstance) {
                modalInstance.hide();
            }
        });
        const elements = {
            sanPhamDaCo: document.getElementById("sanPhamDaCo"),
            thongTinMoi: document.getElementById("thongTinSanPhamMoi"),
            tbody: document.querySelector("#variantTable tbody"),
            form: document.querySelector('form')
        };

        // --- Initialization & Visibility ---
        function toggleProductInfo() {
            const isNew = !elements.sanPhamDaCo.value;
            elements.thongTinMoi.style.display = isNew ? "block" : "none";
            if (isNew) generateProductCode();
        }

        elements.sanPhamDaCo.addEventListener("change", toggleProductInfo);
        window.addEventListener("DOMContentLoaded", toggleProductInfo);

        // --- Product Code Generation ---
        function generateProductCode() {
            const now = new Date();
            const year = now.getFullYear().toString().slice(-2);
            const ts = now.getTime().toString().slice(-8); // Using timestamp for uniqueness
            const input = document.querySelector('input[name="MaSanPham"]');
            if (input) input.value = `SP${year}${ts}`;
        }

        // --- Variant Generation Logic ---
        function generateVariants() {
            const getChecked = (cls) => [...document.querySelectorAll(cls + ":checked")].map(x => ({
                id: x.value,
                text: x.nextElementSibling.innerText
            }));

            const kichCos = getChecked(".kichCoCheckbox");
            const mauSacs = getChecked(".mauSacCheckbox");
            let hoaTiets = getChecked(".hoaTietCheckbox");

            if (!kichCos.length || !mauSacs.length) {
                alert("Vui lòng chọn ít nhất 1 kích cỡ và 1 màu sắc!");
                return;
            }

            if (hoaTiets.length === 0) hoaTiets = [{ id: "", text: "Không" }];

            // Store existing data to prevent loss on refresh
            const existingData = {};
            elements.tbody.querySelectorAll('tr').forEach(row => {
                const key = `${row.dataset.kc}-${row.dataset.ms}-${row.dataset.ht}`;
                existingData[key] = {
                    qty: row.querySelector('.quantity-input').value,
                    price: row.querySelector('.price-input').value
                };
            });

            elements.tbody.innerHTML = "";
            let index = 0;

            kichCos.forEach(kc => {
                mauSacs.forEach(ms => {
                    hoaTiets.forEach(ht => {
                        const key = `${kc.id}-${ms.id}-${ht.id}`;
                        const old = existingData[key] || { qty: 0, price: 0 };
                        
                        const row = `
                            <tr data-kc="${kc.id}" data-ms="${ms.id}" data-ht="${ht.id}">
                                <td><input type="hidden" name="ChiTietSanPhams[${index}].IdKichCo" value="${kc.id}" />${kc.text}</td>
                                <td><input type="hidden" name="ChiTietSanPhams[${index}].IdMauSac" value="${ms.id}" />${ms.text}</td>
                                <td><input type="hidden" name="ChiTietSanPhams[${index}].IdHoaTiet" value="${ht.id}" />${ht.text}</td>
                                <td><input name="ChiTietSanPhams[${index}].SoLuong" type="number" class="form-control quantity-input" min="0" value="${old.qty}" /></td>
                                <td><input name="ChiTietSanPhams[${index}].GiaBan" type="number" class="form-control price-input" min="0" value="${old.price}" /></td>
                            </tr>`;
                        elements.tbody.insertAdjacentHTML("beforeend", row);
                        index++;
                    });
                });
            });
        }

        // --- Validation Logic ---
        elements.form.addEventListener('submit', function(e) {
            let isValid = true;
            this.querySelectorAll('.price-input, .quantity-input').forEach(input => {
                const val = parseFloat(input.value);
                if (val < 0 || (input.classList.contains('price-input') && val <= 0)) {
                    input.classList.add('is-invalid');
                    isValid = false;
                } else {
                    input.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                e.preventDefault();
                alert('Vui lòng kiểm tra lại: Giá bán > 0 và Số lượng >= 0');
            }
        });

        function savePageState() {
            const selectIds = ['IDDanhMuc', 'IDThuongHieu', 'IDChatLieu', 'IDLoaiOng', 'IDKieuDang', 'IDLungQuan'];
            const selectedValues = {};
            selectIds.forEach(id => {
                const el = document.getElementById(id);
                if (el) selectedValues[id] = el.value;
            });

            const state = {
                kichCo: [...document.querySelectorAll('.kichCoCheckbox:checked')].map(x => x.value),
                mauSac: [...document.querySelectorAll('.mauSacCheckbox:checked')].map(x => x.value),
                hoaTiet: [...document.querySelectorAll('.hoaTietCheckbox:checked')].map(x => x.value),
                tenSanPham: document.querySelector('[name="TenSanPham"]')?.value || '',
                maSanPham: document.querySelector('[name="MaSanPham"]')?.value || '',
                selectedValues: selectedValues,
                // CAPTURE TOGGLE STATUSES
                statuses: [...document.querySelectorAll('.toggle-status')].map(x => ({
                    id: x.dataset.id,
                    checked: x.checked
                }))
            };
            sessionStorage.setItem('sanPhamState', JSON.stringify(state));
        }

        function restorePageState() {
            const saved = sessionStorage.getItem('sanPhamState');
            if (!saved) return;
            const state = JSON.parse(saved);

            // Restore Checkboxes
            if (state.kichCo) state.kichCo.forEach(v => { const el = document.getElementById('kc_' + v); if (el) el.checked = true; });
            if (state.mauSac) state.mauSac.forEach(v => { const el = document.getElementById('ms_' + v); if (el) el.checked = true; });
            if (state.hoaTiet) state.hoaTiet.forEach(v => { const el = document.getElementById('ht_' + v); if (el) el.checked = true; });

            // Restore Text Inputs
            const ten = document.querySelector('[name="TenSanPham"]');
            if (ten && state.tenSanPham) ten.value = state.tenSanPham;
            const ma = document.querySelector('[name="MaSanPham"]');
            if (ma && state.maSanPham) ma.value = state.maSanPham;

            // Restore Dropdowns
            if (state.selectedValues) {
                Object.entries(state.selectedValues).forEach(([id, val]) => {
                    const el = document.getElementById(id);
                    if (el && val) el.value = val;
                });
            }

            // RESTORE TOGGLE STATUSES (The Active/Deactive state)
            if (state.statuses) {
                state.statuses.forEach(s => {
                    const el = document.querySelector(`.toggle-status[data-id="${s.id}"]`);
                    if (el) {
                        el.checked = s.checked;
                        const label = el.parentNode.querySelector('span');
                        if (label) {
                            label.textContent = s.checked ? 'Kích hoạt' : 'Ẩn';
                            label.className = s.checked ? 'status-active' : 'status-inactive';
                        }
                    }
                });
            }

            // Only remove after restoring is finished
            sessionStorage.removeItem('sanPhamState');
        }

        $(document).ready(function () {
            try {
                restorePageState();

                // Clear modal body when closed
                $('#createModal').on('hidden.bs.modal', function () {
                    $('#createModalBody').html('');
                    $('#saveCreateBtn').prop('disabled', false).text('Thêm');
                });

                const attributeConfigs = {
                    'btnAddDanhMuc':    { title: 'Thêm Danh Mục',    url: '@Url.Action("Create", "ProductManage", new { area = "Admin" })', selectId: 'IDDanhMuc' },
                    'btnAddThuongHieu': { title: 'Thêm Thương Hiệu', url: '@Url.Action("Create", "ThuongHieu",    new { area = "Admin" })', selectId: 'IDThuongHieu' },
                    'btnAddChatLieu':   { title: 'Thêm Chất Liệu',   url: '@Url.Action("Create", "ChatLieu",     new { area = "Admin" })', selectId: 'IDChatLieu' },
                    'btnAddLoaiOng':    { title: 'Thêm Loại Ống',    url: '@Url.Action("Create", "LoaiOng",      new { area = "Admin" })', selectId: 'IDLoaiOng' },
                    'btnAddKieuDang':   { title: 'Thêm Kiểu Dáng',   url: '@Url.Action("Create", "KieuDang",     new { area = "Admin" })', selectId: 'IDKieuDang' },
                    'btnAddLungQuan':   { title: 'Thêm Lưng Quần',   url: '@Url.Action("Create", "LungQuan",     new { area = "Admin" })', selectId: 'IDLungQuan' },
                    'btnAddKichCo':     { title: 'Thêm Kích Cỡ',     url: '@Url.Action("Create", "KichCo",       new { area = "Admin" })', containerId: 'kichCoSelect' },
                    'btnAddMauSac':     { title: 'Thêm Màu Sắc',     url: '@Url.Action("Create", "MauSac",       new { area = "Admin" })', containerId: 'mauSacSelect' },
                    'btnAddHoaTiet':    { title: 'Thêm Họa Tiết',    url: '@Url.Action("Create", "HoaTiet",      new { area = "Admin" })', containerId: 'hoaTietSelect' }
                };

                let currentConfig = null;

                // Load form when modal is about to show — same pattern as ProductManage
                $('#createModal').on('show.bs.modal', function () {
                    if (!currentConfig) return;
                    $('#createModalBody').html('<div class="text-center"><span class="spinner"></span> Đang tải...</div>');
                    $.get(currentConfig.url, function (data) {
                        $('#createModalBody').html(data);
                        if ($('#createForm').length > 0) {
                            $.validator.unobtrusive.parse('#createForm');
                        }
                    }).fail(function (xhr) {
                        console.log('GET failed:', xhr.status, currentConfig.url);
                        $('#createModalBody').html('<div class="text-danger">Không thể tải form (' + xhr.status + ')</div>');
                    });
                });

                // Set config and open modal on button click
                // Replace this in your button click handler:
                $('[id^="btnAdd"]').click(function () {
                    const btnId = $(this).attr('id');
                    currentConfig = attributeConfigs[btnId];
                    if (!currentConfig) return;
                    $('#createModalLabel').text(currentConfig.title);
                    
                    // Store instance so we can close it later
                    window.currentModal = new bootstrap.Modal(document.getElementById('createModal'));
                    window.currentModal.show();
                });

                // Save
                $('#saveCreateBtn').click(function () {
                    const form = $('#createForm');
                    if (!form.length || !form.valid()) return;
                    
                    savePageState();

                    var formData = form.serializeArray();
                    formData.push({
                        name: 'NguoiTao',
                        value: '@Html.Raw(HttpUtility.JavaScriptStringEncode(User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "unknown"))'
                    });

                    $.ajax({
                        url: currentConfig.url,
                        type: 'POST',
                        data: $.param(formData),
                        beforeSend: function () {
                            $('#saveCreateBtn').prop('disabled', true).html('<span class="spinner"></span> Đang xử lý...');
                        },
                        success: function () {
                            $('#createModalBody').html('<div class="text-center text-success py-3"><i class="fas fa-check-circle fa-2x mb-2"></i><p class="fw-bold mb-0">Thêm thành công!</p></div>');
                            setTimeout(function () {
                                if (window.currentModal) window.currentModal.hide();
                                savePageState();
                                window.location.href = window.location.pathname + '?_=' + Date.now();
                            }, 800);
                        },
                        error: function (xhr) {
                            if (xhr.status === 0 || xhr.status === 302) {
                                $('#createModalBody').html('<div class="text-center text-success py-3"><i class="fas fa-check-circle fa-2x mb-2"></i><p class="fw-bold mb-0">Thêm thành công!</p></div>');
                                setTimeout(function () {
                                    if (window.currentModal) window.currentModal.hide();
                                    savePageState();
                                    window.location.href = window.location.pathname + '?_=' + Date.now();
                                }, 800);
                                return;
                            }
                            alert("Lỗi hệ thống khi lưu dữ liệu: " + xhr.status);
                        },
                        complete: function () {
                            if ($('#createForm').length > 0) {
                                $('#saveCreateBtn').prop('disabled', false).text('Thêm');
                            }
                        }
                    });
                });

            } catch(e) {
                console.error('INIT ERROR:', e.message, e.stack);
            }
        });
    </script>

    <style>
    .spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        vertical-align: text-bottom;
        border: 0.25em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
    }

    @@keyframes spinner-border {
        to { transform: rotate(360deg); }
    }

    /* Custom Modal Header Styling */
    .modal-header.bg-primary {
        background-color: #0d6efd !important;
        color: white;
    }
        .is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }

        .validation-error {
            margin-top: 5px;
        }

        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type="number"] {
            -moz-appearance: textfield;
        }
        /* Container: ensure flex and remove default Bootstrap padding */
        .variant-selector .form-check.form-switch {
            display: flex;
            align-items: center;
            padding-left: 0; 
            margin-bottom: 12px;
        }

        /* The Slider: remove absolute positioning and fixed margins */
        .variant-selector .form-switch .form-check-input {
            position: static; /* This is the "magic" line that prevents overlapping */
            width: 2.5rem;   
            height: 1.25rem;
            margin-top: 0;    /* Resets Bootstrap's alignment offset */
            margin-left: 0;
            margin-right: 12px;
            flex-shrink: 0;   /* Prevents the slider from squishing if text is long */
            cursor: pointer;
        }

        /* The Label: ensure it sits nicely next to the slider */
        .variant-selector .form-check-label {
            margin-bottom: 0;
            cursor: pointer;
            user-select: none;
            line-height: 1.25rem; /* Matches the height of the slider for perfect centering */
        }
    </style>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}
