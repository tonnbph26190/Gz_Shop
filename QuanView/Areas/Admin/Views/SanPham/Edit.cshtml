@model QuanView.Areas.Admin.Models.SanPhamDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Sửa sản phẩm";
}
<div class="card">
    <div class="card-header bg-warning text-dark">
        Sửa sản phẩm
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var entry in ViewData.ModelState)
                {
                    if (entry.Value.Errors.Any())
                    {
                        <p><strong>@entry.Key:</strong> @string.Join(", ", entry.Value.Errors.Select(e => e.ErrorMessage))</p>
                    }
                }
            </div>
        }

        <form asp-area="Admin" asp-controller="SanPham" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div class="row">
                <input type="hidden" asp-for="IDSanPham" class="col-3"/>

                <div class="form-group col-3">
                    <label asp-for="MaSanPham">Mã sản phẩm</label>
                    <div class="input-group">
                        <input asp-for="MaSanPham" class="form-control" readonly />
                        @* <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" onclick="generateProductCode()">
                                <i class="fas fa-sync-alt"></i> Tạo mã mới
                            </button>
                        </div> *@
                    </div>
                    <small class="form-text text-muted">Mã sản phẩm hiện tại hoặc tạo mã mới</small>
                    <span asp-validation-for="MaSanPham" class="text-danger"></span>
                </div>

                <div class="form-group col-3">
                    <label asp-for="TenSanPham">Tên sản phẩm</label>
                    <input asp-for="TenSanPham" class="form-control" />
                    <span asp-validation-for="TenSanPham" class="text-danger"></span>
                </div>

                <!-- Dropdowns -->
                <div class="form-group col-3">
                    <label asp-for="IDDanhMuc">Danh mục</label>
                    <select asp-for="IDDanhMuc" class="form-control" asp-items="ViewBag.DanhMucs"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDThuongHieu">Thương hiệu</label>
                    <select asp-for="IDThuongHieu" class="form-control" asp-items="ViewBag.ThuongHieus"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDChatLieu">Chất liệu</label>
                    <select asp-for="IDChatLieu" class="form-control" asp-items="ViewBag.ChatLieus"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDLoaiOng">Loại ống</label>
                    <select asp-for="IDLoaiOng" class="form-control" asp-items="ViewBag.LoaiOngs"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDKieuDang">Kiểu dáng</label>
                    <select asp-for="IDKieuDang" class="form-control" asp-items="ViewBag.KieuDangs"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDLungQuan">Lưng quần</label>
                    <select asp-for="IDLungQuan" class="form-control" asp-items="ViewBag.LungQuans"></select>
                </div>
                <div class="col-3">
                    <div class="form-group form-check">
                        <input asp-for="CoXepLy" class="form-check-input" />
                        <label asp-for="CoXepLy" class="form-check-label">Có xếp ly</label>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="CoGian" class="form-check-input" />
                        <label asp-for="CoGian" class="form-check-label">Co giãn</label>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="TrangThai" class="form-check-input" />
                        <label asp-for="TrangThai" class="form-check-label">
                            Hoạt động</label>
                    </div>
                </div>
            </div>
            <!-- Biến thể sản phẩm: luôn hiển thị, có số lượng và cho phép xóa/sửa/thêm -->
            @{
                var variantList = Model.ChiTietSanPhams ?? new List<QuanView.Areas.Admin.Models.SanPhamChiTietDto>();
                var variantCount = variantList.Count;
                var activeVariantCount = variantList.Count(x => x.TrangThai);
                var inactiveVariantCount = variantList.Count(x => !x.TrangThai);
                var newVariantIndex = variantCount;
            }
            
        
            <div class="mt-4">
                <h4 class="mb-2">Biến thể sản phẩm <span class="badge bg-secondary text-light">@variantCount</span></h4>
                <p class="text-muted small mb-2">Sửa số lượng, giá bán, bật/tắt trạng thái và tạo QR cho từng biến thể. Bấm <strong>Xóa</strong> để xóa mềm (ngưng bán). Với biến thể mới, QR sẽ khả dụng sau khi lưu.</p>
                <div class="mb-2">
                    <button type="button" class="btn btn-outline-success btn-sm" id="btnAddNewVariantRow">
                        <i class="fas fa-plus"></i> Thêm dòng biến thể
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm ms-2" id="btnGenerateSelectedQrs">
                        <i class="fas fa-qrcode"></i> Tạo QR cho biến thể đã chọn
                    </button>
                    <button type="button" class="btn btn-outline-dark btn-sm ms-2" id="btnExportSelectedQrs">
                        <i class="fas fa-download"></i> Export QR đã chọn
                    </button>
                </div>
                <ul class="nav nav-tabs mb-3" id="variantStatusTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link active variant-status-tab" data-variant-status="active">
                            Đang hoạt động <span class="badge bg-success ms-1" id="activeVariantCountBadge">@activeVariantCount</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button type="button" class="nav-link variant-status-tab" data-variant-status="inactive">
                            Ngưng hoạt động <span class="badge bg-secondary ms-1" id="inactiveVariantCountBadge">@inactiveVariantCount</span>
                        </button>
                    </li>
                </ul>
                <div class="alert alert-light border py-2 px-3 d-none" id="variantEmptyState"></div>
                <table class="table table-bordered table-hover text-center" id="variantTable">
                    <thead class="table-light">
                    <tr>
                        <th style="width: 6%;">
                            <input type="checkbox" id="selectAllVariantQr" title="Chọn tất cả biến thể đã lưu" />
                        </th>
                        <th style="width: 10%;">Kích cỡ</th>
                        <th style="width: 20%;">Màu sắc</th>
                        <th style="width: 20%;">Họa tiết</th>
                        <th style="width: 10%;">Số lượng</th>
                        <th style="width: 10%;">Giá bán</th>
                        <th style="width: 10%;">Trạng thái</th>
                        <th style="width: 15%;">Mã QR</th>
                        <th style="width: 9%;">Xóa</th>
                    </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < variantList.Count; i++)
                        {
                            var variant = variantList[i];
                            <tr class="variant-row" data-variant-index="@i" data-status="@(variant.TrangThai ? "active" : "inactive")">
                                <td class="align-middle">
                                    <input type="checkbox"
                                           class="variant-qr-selector"
                                           value="@variant.IdSanPhamChiTiet"
                                           data-variant-id="@variant.IdSanPhamChiTiet" />
                                </td>
                                <td>
                                    <input type="hidden" name="ChiTietSanPhams.Index" value="@i" />
                                    <input type="hidden" asp-for="ChiTietSanPhams[i].IdSanPhamChiTiet" />
                                    <input type="hidden" asp-for="ChiTietSanPhams[i].IdSanPham" />
                                    
                                    @* Change this from <strong> to <select> *@
                                    <select asp-for="ChiTietSanPhams[i].IdKichCo" class="form-control form-control-sm" asp-items="ViewBag.KichCos">
                                        <option value="">-- Chọn --</option>
                                    </select>
                                    <span asp-validation-for="ChiTietSanPhams[i].IdKichCo" class="text-danger"></span>
                                </td>
                                <td>
                                    <select asp-for="ChiTietSanPhams[i].IdMauSac" class="form-control form-control-sm" asp-items="ViewBag.MauSacs">
                                        <option value="">-- Chọn --</option>
                                    </select>
                                    <small class="text-muted d-block">Hiện tại: @variant.TenMauSac</small>
                                </td>
                                <td>
                                    <select asp-for="ChiTietSanPhams[i].IdHoaTiet" class="form-control form-control-sm" asp-items="ViewBag.HoaTiets">
                                        <option value="">-- Không --</option>
                                    </select>
                                    <small class="text-muted d-block">Hiện tại: @(variant.TenHoaTiet ?? "Không")</small>
                                </td>
                                <td>
                                    <input asp-for="ChiTietSanPhams[i].SoLuong" class="form-control form-control-sm quantity-input" type="number" min="0" />
                                </td>
                                <td>
                                    <input asp-for="ChiTietSanPhams[i].GiaBan" class="form-control form-control-sm price-input" type="number" min="0" step="any" />
                                </td>
                                <td class="text-center align-middle">
                                    <div class="form-check form-switch d-inline-flex align-items-center">
                                        <input name="ChiTietSanPhams[@i].TrangThai" 
                                            class="form-check-input custom-slider" 
                                            type="checkbox" 
                                            role="switch" 
                                            value="true"
                                            @(variant.TrangThai ? "checked" : "") >
                                        <input type="hidden" name="ChiTietSanPhams[@i].TrangThai" value="false" />&nbsp; Hoạt động
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <input type="hidden" asp-for="ChiTietSanPhams[i].MaSPChiTiet" class="variant-code-input" />
                                    <input type="hidden" asp-for="ChiTietSanPhams[i].QrCode" class="variant-qr-input" />
                                    <div class="small text-muted mb-2 variant-code-label">
                                        @(string.IsNullOrWhiteSpace(variant.MaSPChiTiet) ? "Chưa có mã biến thể" : variant.MaSPChiTiet)
                                    </div>
                                    <div class="qr-preview mb-2" data-qr-value="@variant.QrCode"></div>
                                    <small class="text-muted">Chọn biến thể và bấm nút tạo QR phía trên</small>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-remove-variant">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }

                        <tr class="variant-row new-variant-row" id="newVariantTemplateRow" data-index="@newVariantIndex" data-status="active" style="display: none;">
                            <td class="align-middle">
                                <input type="checkbox" disabled />
                            </td>
                            <td>
                                <input type="hidden" name="ChiTietSanPhams.Index" value="@newVariantIndex" disabled/>
                                <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].IdSanPhamChiTiet" value="00000000-0000-0000-0000-000000000000" />
                                <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].IdSanPham" value="@Model.IDSanPham" />
                                <select name="ChiTietSanPhams[@newVariantIndex].IdKichCo" class="form-control form-control-sm" asp-items="ViewBag.KichCos">
                                    <option value="">-- Chọn --</option>
                                </select>
                            </td>
                            <td>
                                <select name="ChiTietSanPhams[@newVariantIndex].IdMauSac" class="form-control form-control-sm" asp-items="@((IEnumerable<SelectListItem>)ViewBag.MauSacs)">
                                    <option value="">-- Chọn --</option>
                                </select>
                            </td>
                            <td>
                                <select name="ChiTietSanPhams[@newVariantIndex].IdHoaTiet" class="form-control form-control-sm" asp-items="@((IEnumerable<SelectListItem>)ViewBag.HoaTiets)">
                                    <option value="00000000-0000-0000-0000-000000000000">-- Không --</option>
                                </select>
                            </td>
                            <td>
                                <input name="ChiTietSanPhams[@newVariantIndex].SoLuong" class="form-control form-control-sm quantity-input" type="number" min="0" value="0" />
                            </td>
                            <td>
                                <input name="ChiTietSanPhams[@newVariantIndex].GiaBan" class="form-control form-control-sm price-input" type="number" min="0" value="0" />
                            </td>
                            <td>
                                <div class="form-check form-switch d-inline-flex align-items-center">
                                    <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].TrangThai" value="false" />
                                    
                                    <input name="ChiTietSanPhams[@newVariantIndex].TrangThai" 
                                        class="form-check-input custom-slider" 
                                        type="checkbox" 
                                        role="switch" 
                                        value="true"
                                        checked>
                                    <span class="badge bg-info ms-2">Mới</span>
                                </div>
                            </td>
                            <td class="align-middle">
                                <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].MaSPChiTiet" value="" class="variant-code-input" />
                                <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].QrCode" value="" class="variant-qr-input" />
                                <div class="small text-muted mb-2 variant-code-label">Lưu biến thể để tạo QR</div>
                                <div class="qr-preview mb-2"></div>
                                <small class="text-muted">Biến thể mới cần lưu trước</small>
                            </td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-area="Admin" asp-controller="SanPham" asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
    <script>
        // === Validation functions (kept as you had) ===
        function addValidationToInput(input, fieldType) {
            const fieldName = fieldType === 'quantity' ? 'Số lượng' : 'Giá bán';

            function isInTemplateRow(element) {
                const row = element.closest('tr');
                return row && row.id === 'newVariantTemplateRow';
            }

            input.addEventListener('keydown', e => {
                if (e.key === '-' || e.key === 'Minus') e.preventDefault();
            });

            input.addEventListener('input', function() {
                if (isInTemplateRow(this)) { clearError(this); return; }
                const value = parseFloat(this.value);
                if (value < 0) {
                    this.value = 0;
                    showError(this, `${fieldName} không được là số âm!`);
                } else {
                    clearError(this);
                }
            });

            input.addEventListener('blur', function() {
                if (isInTemplateRow(this)) return;
                if (!this.value.trim() || isNaN(parseFloat(this.value))) {
                    this.value = "0";
                    clearError(this);
                    return;
                }
                const value = parseFloat(this.value);
                if (value < 0) {
                    this.value = "0";
                    showError(this, `${fieldName} không được là số âm!`);
                } else if (fieldType === 'price' && value <= 0) {
                    showError(this, `Giá bán phải lớn hơn 0!`);
                } else {
                    clearError(this);
                }
            });
        }

        function showError(input, message) {
            clearError(input);
            const errorDiv = document.createElement('div');
            errorDiv.className = 'text-danger validation-error';
            errorDiv.style.fontSize = '0.875em';
            errorDiv.textContent = message;
            errorDiv.id = input.name + '_error';
            input.parentNode.appendChild(errorDiv);
            input.classList.add('is-invalid');
            setTimeout(() => clearError(input), 3000);
        }

        function clearError(input) {
            const error = document.getElementById(input.name + '_error');
            if (error) error.remove();
            input.classList.remove('is-invalid');
        }

        function renderQrPreview(container, value) {
            if (!container) return;

            container.innerHTML = '';
            if (!value) {
                container.innerHTML = '<span class="text-muted small">Chưa tạo QR</span>';
                return;
            }

            new QRCode(container, {
                text: value,
                width: 72,
                height: 72,
                correctLevel: QRCode.CorrectLevel.M
            });
        }

        // === DOM Ready ===
        document.addEventListener('DOMContentLoaded', function() {
            const antiForgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const generateSelectedQrsUrl = '@Url.Action("GenerateSelectedVariantQrs", "SanPham", new { area = "Admin" })';
            const selectAllCheckbox = document.getElementById('selectAllVariantQr');
            const generateSelectedButton = document.getElementById('btnGenerateSelectedQrs');
            const exportSelectedButton = document.getElementById('btnExportSelectedQrs');
            const variantStatusTabs = document.querySelectorAll('.variant-status-tab');
            const variantEmptyState = document.getElementById('variantEmptyState');
            const activeVariantCountBadge = document.getElementById('activeVariantCountBadge');
            const inactiveVariantCountBadge = document.getElementById('inactiveVariantCountBadge');
            let currentVariantStatus = 'active';

            // Apply validation
            document.querySelectorAll('.quantity-input, .price-input').forEach(input => {
                const row = input.closest('tr');
                if (row && row.id !== 'newVariantTemplateRow') {
                    const type = input.classList.contains('quantity-input') ? 'quantity' : 'price';
                    addValidationToInput(input, type);
                }
            });

            document.querySelectorAll('.qr-preview').forEach(preview => {
                renderQrPreview(preview, preview.dataset.qrValue || '');
            });

            function getManagedVariantRows() {
                return Array.from(document.querySelectorAll('#variantTable tbody tr.variant-row'))
                    .filter(row => row.id !== 'newVariantTemplateRow' && !row.classList.contains('deleted-row'));
            }

            function updateVariantCounts() {
                const rows = getManagedVariantRows();
                const activeCount = rows.filter(row => (row.dataset.status || 'active') === 'active').length;
                const inactiveCount = rows.filter(row => (row.dataset.status || 'active') === 'inactive').length;

                if (activeVariantCountBadge) activeVariantCountBadge.textContent = activeCount;
                if (inactiveVariantCountBadge) inactiveVariantCountBadge.textContent = inactiveCount;
            }

            function updateVariantEmptyState() {
                if (!variantEmptyState) return;

                const visibleRows = getManagedVariantRows()
                    .filter(row => !row.classList.contains('variant-filter-hidden'));

                if (visibleRows.length > 0) {
                    variantEmptyState.classList.add('d-none');
                    variantEmptyState.textContent = '';
                    return;
                }

                variantEmptyState.classList.remove('d-none');
                variantEmptyState.textContent = currentVariantStatus === 'active'
                    ? 'Không có biến thể đang hoạt động.'
                    : 'Không có biến thể ngưng hoạt động.';
            }

            function applyVariantTabFilter(status) {
                currentVariantStatus = status;

                variantStatusTabs.forEach(tab => {
                    tab.classList.toggle('active', tab.dataset.variantStatus === status);
                });

                document.querySelectorAll('#variantTable tbody tr.variant-row').forEach(row => {
                    if (row.id === 'newVariantTemplateRow' || row.classList.contains('deleted-row')) return;

                    const rowStatus = row.dataset.status || 'active';
                    row.classList.toggle('variant-filter-hidden', rowStatus !== status);
                });

                updateVariantCounts();
                updateVariantEmptyState();
                syncSelectAllState();
            }

            // ==================== DELETE ====================
            document.getElementById('variantTable').addEventListener('click', function(e) {
                if (e.target.closest('.btn-remove-variant')) {
                    const row = e.target.closest('tr.variant-row');
                    if (row && !row.classList.contains('new-variant-row') && row.id !== 'newVariantTemplateRow') {
                        if (confirm('Xóa biến thể này khỏi sản phẩm?')) {
                            let delInput = row.querySelector('input[name$=".IsDeleted"]');
                            if (!delInput) {
                                delInput = document.createElement('input');
                                delInput.type = 'hidden';
                                delInput.name = `ChiTietSanPhams[${row.dataset.variantIndex}].IsDeleted`;
                                row.appendChild(delInput);
                            }
                            delInput.value = 'true';

                            row.style.display = 'none';           // Hide visually
                            row.classList.add('deleted-row');
                            row.querySelectorAll('input, select, textarea, button').forEach(control => {
                                if (!control.name || control === delInput) return;
                                if (control.name === 'ChiTietSanPhams.Index' ||
                                    control.name.endsWith('.IdSanPhamChiTiet') ||
                                    control.name.endsWith('.IdSanPham')) {
                                    return;
                                }

                                control.disabled = true;
                            });
                            updateVariantCounts();
                            updateVariantEmptyState();
                            syncSelectAllState();
                        }
                    }
                }

                if (e.target.closest('.btn-remove-new-row')) {
                    const row = e.target.closest('tr');
                    if (row) {
                        row.remove();
                        updateVariantCounts();
                        updateVariantEmptyState();
                        syncSelectAllState();
                    }
                }
            });

            function getSelectableQrCheckboxes() {
                return Array.from(document.querySelectorAll('.variant-qr-selector'))
                    .filter(checkbox => {
                        const row = checkbox.closest('tr.variant-row');
                        return row && row.style.display !== 'none' && !row.classList.contains('variant-filter-hidden');
                    });
            }

            function syncSelectAllState() {
                if (!selectAllCheckbox) return;

                const checkboxes = getSelectableQrCheckboxes();
                const checkedBoxes = checkboxes.filter(x => x.checked);

                selectAllCheckbox.checked = checkboxes.length > 0 && checkedBoxes.length === checkboxes.length;
                selectAllCheckbox.indeterminate = checkedBoxes.length > 0 && checkedBoxes.length < checkboxes.length;
            }

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener('change', function() {
                    getSelectableQrCheckboxes().forEach(checkbox => {
                        checkbox.checked = this.checked;
                    });
                    syncSelectAllState();
                });
            }

            document.getElementById('variantTable').addEventListener('change', function(e) {
                if (e.target.classList.contains('variant-qr-selector')) {
                    syncSelectAllState();
                }

                if (e.target.matches('input[type="checkbox"][name*=".TrangThai"]')) {
                    const row = e.target.closest('tr.variant-row');
                    if (row && row.id !== 'newVariantTemplateRow' && !row.classList.contains('deleted-row')) {
                        row.dataset.status = e.target.checked ? 'active' : 'inactive';
                        applyVariantTabFilter(currentVariantStatus);
                    }
                }
            });

            variantStatusTabs.forEach(tab => {
                tab.addEventListener('click', function() {
                    applyVariantTabFilter(this.dataset.variantStatus || 'active');
                });
            });

            if (generateSelectedButton) {
                generateSelectedButton.addEventListener('click', generateSelectedVariantQrs);
            }

            if (exportSelectedButton) {
                exportSelectedButton.addEventListener('click', exportSelectedVariantQrs);
            }

            async function generateSelectedVariantQrs() {
                const selectedCheckboxes = getSelectableQrCheckboxes().filter(x => x.checked);
                if (!selectedCheckboxes.length) {
                    alert('Vui lòng chọn ít nhất một biến thể để tạo QR.');
                    return;
                }

                generateSelectedButton.disabled = true;
                const originalText = generateSelectedButton.textContent;
                generateSelectedButton.textContent = 'Đang tạo QR...';

                try {
                    const formData = new URLSearchParams();
                    selectedCheckboxes.forEach(checkbox => {
                        formData.append('selectedVariantIds', checkbox.value);
                    });

                    const response = await fetch(generateSelectedQrsUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                            'RequestVerificationToken': antiForgeryToken
                        },
                        body: formData
                    });

                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        throw new Error(data.message || 'Không thể tạo mã QR.');
                    }

                    (data.results || []).forEach(item => {
                        const row = document.querySelector(`.variant-qr-selector[data-variant-id="${item.id}"]`)?.closest('tr.variant-row');
                        if (!row) return;

                        const qrInput = row.querySelector('.variant-qr-input');
                        const codeInput = row.querySelector('.variant-code-input');
                        const codeLabel = row.querySelector('.variant-code-label');
                        const preview = row.querySelector('.qr-preview');

                        if (qrInput) qrInput.value = item.qrCode || '';
                        if (codeInput && item.maSPChiTiet) codeInput.value = item.maSPChiTiet;
                        if (codeLabel) codeLabel.textContent = item.maSPChiTiet || codeInput?.value || 'Chưa có mã biến thể';
                        renderQrPreview(preview, item.qrCode || '');
                    });

                    alert(`Đã tạo QR cho ${data.count || selectedCheckboxes.length} biến thể.`);
                } catch (error) {
                    alert(error.message || 'Không thể tạo mã QR.');
                } finally {
                    generateSelectedButton.disabled = false;
                    generateSelectedButton.textContent = originalText;
                    syncSelectAllState();
                }
            }

            function slugifyFileName(value) {
                return (value || 'qr-code')
                    .toString()
                    .trim()
                    .replace(/[\\/:*?"<>|]/g, '-')
                    .replace(/\s+/g, '-');
            }

            function getCanvasFromRow(row) {
                return row?.querySelector('.qr-preview canvas');
            }

            function downloadBlob(blob, fileName) {
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = fileName;
                document.body.appendChild(link);
                link.click();
                link.remove();
                URL.revokeObjectURL(url);
            }

            async function exportSelectedVariantQrs() {
                const selectedCheckboxes = getSelectableQrCheckboxes().filter(x => x.checked);
                if (!selectedCheckboxes.length) {
                    alert('Vui lòng chọn ít nhất một biến thể để export QR.');
                    return;
                }

                const rowsToExport = [];
                const missingQrCodes = [];

                selectedCheckboxes.forEach(checkbox => {
                    const row = checkbox.closest('tr.variant-row');
                    const qrInput = row?.querySelector('.variant-qr-input');
                    const codeInput = row?.querySelector('.variant-code-input');
                    const codeLabel = row?.querySelector('.variant-code-label');
                    const qrValue = qrInput?.value?.trim();
                    const variantCode = codeInput?.value?.trim() || codeLabel?.textContent?.trim() || checkbox.value;

                    if (!qrValue) {
                        missingQrCodes.push(variantCode);
                        return;
                    }

                    rowsToExport.push({
                        row,
                        variantCode,
                        qrValue
                    });
                });

                if (missingQrCodes.length) {
                    alert(`Một số biến thể chưa có QR: ${missingQrCodes.join(', ')}. Vui lòng tạo QR trước khi export.`);
                    return;
                }

                exportSelectedButton.disabled = true;
                const originalText = exportSelectedButton.textContent;
                exportSelectedButton.textContent = 'Đang export...';

                try {
                    const zip = new JSZip();

                    rowsToExport.forEach(item => {
                        const preview = item.row.querySelector('.qr-preview');
                        if (preview && !getCanvasFromRow(item.row)) {
                            renderQrPreview(preview, item.qrValue);
                        }

                        const canvas = getCanvasFromRow(item.row);
                        if (!canvas) {
                            throw new Error(`Không thể tạo ảnh QR cho biến thể ${item.variantCode}.`);
                        }

                        const base64 = canvas.toDataURL('image/png').split(',')[1];
                        zip.file(`${slugifyFileName(item.variantCode)}.png`, base64, { base64: true });
                    });

                    const zipBlob = await zip.generateAsync({ type: 'blob' });
                    const productCode = slugifyFileName(document.querySelector('input[name="MaSanPham"]')?.value || 'san-pham');
                    downloadBlob(zipBlob, `${productCode}-qr-codes.zip`);
                } catch (error) {
                    alert(error.message || 'Không thể export QR.');
                } finally {
                    exportSelectedButton.disabled = false;
                    exportSelectedButton.textContent = originalText;
                }
            }

            // ==================== ADD NEW ROW ====================
            (function() {
                const templateRow = document.getElementById('newVariantTemplateRow');
                if (!templateRow) return;
                let nextNewIndex = parseInt(templateRow.getAttribute('data-index'), 10);

                document.getElementById('btnAddNewVariantRow').addEventListener('click', function() {
                    const clone = templateRow.cloneNode(true);
                    clone.id = '';
                    clone.classList.remove('new-variant-row');
                    clone.classList.add('new-variant-clone');
                    clone.dataset.status = 'active';
                    clone.style.display = '';

                    const oldPrefix = `ChiTietSanPhams[${templateRow.getAttribute('data-index')}]`;
                    const newPrefix = `ChiTietSanPhams[${nextNewIndex}]`;

                    clone.querySelectorAll('[name]').forEach(el => {
                        if (el.name) el.name = el.name.replace(oldPrefix, newPrefix);
                    });

                    clone.querySelectorAll('input[name="ChiTietSanPhams.Index"]').forEach(el => {
                        el.value = nextNewIndex;
                        el.disabled = false;
                    });

                    const actionTd = clone.querySelector('td:last-child');
                    if (actionTd) actionTd.innerHTML = `<button type="button" class="btn btn-outline-danger btn-sm btn-remove-new-row"><i class="fas fa-times"></i></button>`;

                    templateRow.parentNode.insertBefore(clone, templateRow.parentNode.firstChild);
                    applyVariantTabFilter('active');
                    nextNewIndex++;
                });
            })();

            applyVariantTabFilter(currentVariantStatus);

            // ==================== SUBMIT ====================
            document.querySelector('form').addEventListener('submit', function(e) {
                let hasError = false;

                // Validation
                document.querySelectorAll('#variantTable tbody tr.variant-row').forEach(row => {
                    if (row.style.display === 'none' || row.id === 'newVariantTemplateRow') return;

                    const isNewRow = row.classList.contains('new-variant-clone');
                    const kichCo = row.querySelector('select[name*="IdKichCo"]');
                    const mauSac = row.querySelector('select[name*="IdMauSac"]');

                    if (isNewRow && (!kichCo?.value || !mauSac?.value)) return;

                    const qty = row.querySelector('.quantity-input');
                    const price = row.querySelector('.price-input');

                    if (qty) {
                        const q = parseInt(qty.value, 10);
                        if (isNaN(q) || q < 0) {
                            showError(qty, 'Số lượng không được âm!');
                            hasError = true;
                        }
                    }
                    if (price) {
                        const p = parseFloat(price.value);
                        if (isNaN(p) || p <= 0) {
                            showError(price, 'Giá bán phải lớn hơn 0!');
                            hasError = true;
                        }
                    }
                });

                if (hasError) {
                    e.preventDefault();
                    alert('Vui lòng kiểm tra lại: Số lượng không được âm và Giá bán phải lớn hơn 0.');
                    return;
                }

                // Remove template row
                const template = document.getElementById('newVariantTemplateRow');
                if (template) template.remove();
            });
        });
    </script>

