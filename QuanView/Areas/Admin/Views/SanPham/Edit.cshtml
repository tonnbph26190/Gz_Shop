@model QuanView.Areas.Admin.Models.SanPhamDto
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Sửa sản phẩm";
}
<div class="card">
    <div class="card-header bg-warning text-dark">
        Sửa sản phẩm
    </div>
    <div class="card-body">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var entry in ViewData.ModelState)
                {
                    if (entry.Value.Errors.Any())
                    {
                        <p><strong>@entry.Key:</strong> @string.Join(", ", entry.Value.Errors.Select(e => e.ErrorMessage))</p>
                    }
                }
            </div>
        }

        <form asp-area="Admin" asp-controller="SanPham" asp-action="Edit" method="post">
            <div class="row">
                <input type="hidden" asp-for="IDSanPham" class="col-3"/>

                <div class="form-group col-3">
                    <label asp-for="MaSanPham">Mã sản phẩm</label>
                    <div class="input-group">
                        <input asp-for="MaSanPham" class="form-control" readonly />
                        @* <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary" onclick="generateProductCode()">
                                <i class="fas fa-sync-alt"></i> Tạo mã mới
                            </button>
                        </div> *@
                    </div>
                    <small class="form-text text-muted">Mã sản phẩm hiện tại hoặc tạo mã mới</small>
                    <span asp-validation-for="MaSanPham" class="text-danger"></span>
                </div>

                <div class="form-group col-3">
                    <label asp-for="TenSanPham">Tên sản phẩm</label>
                    <input asp-for="TenSanPham" class="form-control" />
                    <span asp-validation-for="TenSanPham" class="text-danger"></span>
                </div>

                <!-- Dropdowns -->
                <div class="form-group col-3">
                    <label asp-for="IDDanhMuc">Danh mục</label>
                    <select asp-for="IDDanhMuc" class="form-control" asp-items="ViewBag.DanhMucs"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDThuongHieu">Thương hiệu</label>
                    <select asp-for="IDThuongHieu" class="form-control" asp-items="ViewBag.ThuongHieus"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDChatLieu">Chất liệu</label>
                    <select asp-for="IDChatLieu" class="form-control" asp-items="ViewBag.ChatLieus"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDLoaiOng">Loại ống</label>
                    <select asp-for="IDLoaiOng" class="form-control" asp-items="ViewBag.LoaiOngs"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDKieuDang">Kiểu dáng</label>
                    <select asp-for="IDKieuDang" class="form-control" asp-items="ViewBag.KieuDangs"></select>
                </div>

                <div class="form-group col-3">
                    <label asp-for="IDLungQuan">Lưng quần</label>
                    <select asp-for="IDLungQuan" class="form-control" asp-items="ViewBag.LungQuans"></select>
                </div>
                <div class="col-3">
                    <div class="form-group form-check">
                        <input asp-for="CoXepLy" class="form-check-input" />
                        <label asp-for="CoXepLy" class="form-check-label">Có xếp ly</label>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="CoGian" class="form-check-input" />
                        <label asp-for="CoGian" class="form-check-label">Co giãn</label>
                    </div>

                    <div class="form-group form-check">
                        <input asp-for="TrangThai" class="form-check-input" />
                        <label asp-for="TrangThai" class="form-check-label">
                            Hoạt động</label>
                    </div>
                </div>
            </div>
            <!-- Biến thể sản phẩm: luôn hiển thị, có số lượng và cho phép xóa/sửa/thêm -->
            @{
                var variantList = Model.ChiTietSanPhams ?? new List<QuanView.Areas.Admin.Models.SanPhamChiTietDto>();
                var variantCount = variantList.Count;
                var newVariantIndex = variantCount;
            }
            
        
            <div class="mt-4">
                <h4 class="mb-2">Biến thể sản phẩm <span class="badge bg-secondary text-light">@variantCount</span></h4>
                <p class="text-muted small mb-2">Sửa số lượng, giá bán, bật/tắt trạng thái. Bấm <strong>Xóa</strong> để xóa mềm (ngưng bán). Dòng trống: thêm biến thể mới — có thể thêm nhiều dòng rồi bấm <strong>Cập nhật</strong> một lần.</p>
                <div class="mb-2">
                    <button type="button" class="btn btn-outline-success btn-sm" id="btnAddNewVariantRow">
                        <i class="fas fa-plus"></i> Thêm dòng biến thể
                    </button>
                </div>
                <table class="table table-bordered table-hover text-center" id="variantTable">
                    <thead class="table-light">
                    <tr>
                        <th style="width: 10%;">Kích cỡ</th>
                        <th style="width: 25%;">Màu sắc</th>
                        <th style="width: 25%;">Họa tiết</th>
                        <th style="width: 10%;">Số lượng</th>
                        <th style="width: 10%;">Giá bán</th>
                        <th style="width: 10%;">Trạng thái</th> 
                        <th style="width: 10%;">Xóa</th>
                    </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < variantList.Count; i++)
                        {
                            var variant = variantList[i];
                            <tr class="variant-row" data-variant-index="@i">
                                <td>
                                    <input type="hidden" name="ChiTietSanPhams.Index" value="@i" />
                                    <input type="hidden" asp-for="ChiTietSanPhams[i].IdSanPhamChiTiet" />
                                    <input type="hidden" asp-for="ChiTietSanPhams[i].IdSanPham" />
                                    
                                    @* Change this from <strong> to <select> *@
                                    <select asp-for="ChiTietSanPhams[i].IdKichCo" class="form-control form-control-sm" asp-items="ViewBag.KichCos">
                                        <option value="">-- Chọn --</option>
                                    </select>
                                    <span asp-validation-for="ChiTietSanPhams[i].IdKichCo" class="text-danger"></span>
                                </td>
                                <td>
                                    <select asp-for="ChiTietSanPhams[i].IdMauSac" class="form-control form-control-sm" asp-items="ViewBag.MauSacs">
                                        <option value="">-- Chọn --</option>
                                    </select>
                                    <small class="text-muted d-block">Hiện tại: @variant.TenMauSac</small>
                                </td>
                                <td>
                                    <select asp-for="ChiTietSanPhams[i].IdHoaTiet" class="form-control form-control-sm" asp-items="ViewBag.HoaTiets">
                                        <option value="">-- Không --</option>
                                    </select>
                                    <small class="text-muted d-block">Hiện tại: @(variant.TenHoaTiet ?? "Không")</small>
                                </td>
                                <td>
                                    <input asp-for="ChiTietSanPhams[i].SoLuong" class="form-control form-control-sm quantity-input" type="number" min="0" />
                                </td>
                                <td>
                                    <input asp-for="ChiTietSanPhams[i].GiaBan" class="form-control form-control-sm price-input" type="number" min="0" step="any" />
                                </td>
                                <td class="text-center align-middle">
                                    <div class="form-check form-switch d-inline-flex align-items-center">
                                        <input name="ChiTietSanPhams[@i].TrangThai" 
                                            class="form-check-input custom-slider" 
                                            type="checkbox" 
                                            role="switch" 
                                            value="true"
                                            @(variant.TrangThai ? "checked" : "") >
                                        <input type="hidden" name="ChiTietSanPhams[@i].TrangThai" value="false" />&nbsp; Hoạt động
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-remove-variant">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }

                        <tr class="variant-row new-variant-row" id="newVariantTemplateRow" data-index="@newVariantIndex" style="display: none;">
                            <td>
                                <input type="hidden" name="ChiTietSanPhams.Index" value="@newVariantIndex" disabled/>
                                <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].IdSanPhamChiTiet" value="00000000-0000-0000-0000-000000000000" />
                                <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].IdSanPham" value="@Model.IDSanPham" />
                                <select name="ChiTietSanPhams[@newVariantIndex].IdKichCo" class="form-control form-control-sm" asp-items="ViewBag.KichCos">
                                    <option value="">-- Chọn --</option>
                                </select>
                            </td>
                            <td>
                                <select name="ChiTietSanPhams[@newVariantIndex].IdMauSac" class="form-control form-control-sm" asp-items="@((IEnumerable<SelectListItem>)ViewBag.MauSacs)">
                                    <option value="">-- Chọn --</option>
                                </select>
                            </td>
                            <td>
                                <select name="ChiTietSanPhams[@newVariantIndex].IdHoaTiet" class="form-control form-control-sm" asp-items="@((IEnumerable<SelectListItem>)ViewBag.HoaTiets)">
                                    <option value="00000000-0000-0000-0000-000000000000">-- Không --</option>
                                </select>
                            </td>
                            <td>
                                <input name="ChiTietSanPhams[@newVariantIndex].SoLuong" class="form-control form-control-sm quantity-input" type="number" min="0" value="0" />
                            </td>
                            <td>
                                <input name="ChiTietSanPhams[@newVariantIndex].GiaBan" class="form-control form-control-sm price-input" type="number" min="0" value="0" />
                            </td>
                            <td>
                                <div class="form-check form-switch d-inline-flex align-items-center">
                                    <input type="hidden" name="ChiTietSanPhams[@newVariantIndex].TrangThai" value="false" />
                                    
                                    <input name="ChiTietSanPhams[@newVariantIndex].TrangThai" 
                                        class="form-check-input custom-slider" 
                                        type="checkbox" 
                                        role="switch" 
                                        value="true"
                                        checked>
                                    <span class="badge bg-info ms-2">Mới</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <button type="submit" class="btn btn-primary">Cập nhật</button>
            <a asp-area="Admin" asp-controller="SanPham" asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
@section Scripts {
    <script>
        // === Validation functions (kept as you had) ===
        function addValidationToInput(input, fieldType) {
            const fieldName = fieldType === 'quantity' ? 'Số lượng' : 'Giá bán';

            function isInTemplateRow(element) {
                const row = element.closest('tr');
                return row && row.id === 'newVariantTemplateRow';
            }

            input.addEventListener('keydown', e => {
                if (e.key === '-' || e.key === 'Minus') e.preventDefault();
            });

            input.addEventListener('input', function() {
                if (isInTemplateRow(this)) { clearError(this); return; }
                const value = parseFloat(this.value);
                if (value < 0) {
                    this.value = 0;
                    showError(this, `${fieldName} không được là số âm!`);
                } else {
                    clearError(this);
                }
            });

            input.addEventListener('blur', function() {
                if (isInTemplateRow(this)) return;
                if (!this.value.trim() || isNaN(parseFloat(this.value))) {
                    this.value = "0";
                    clearError(this);
                    return;
                }
                const value = parseFloat(this.value);
                if (value < 0) {
                    this.value = "0";
                    showError(this, `${fieldName} không được là số âm!`);
                } else if (fieldType === 'price' && value <= 0) {
                    showError(this, `Giá bán phải lớn hơn 0!`);
                } else {
                    clearError(this);
                }
            });
        }

        function showError(input, message) {
            clearError(input);
            const errorDiv = document.createElement('div');
            errorDiv.className = 'text-danger validation-error';
            errorDiv.style.fontSize = '0.875em';
            errorDiv.textContent = message;
            errorDiv.id = input.name + '_error';
            input.parentNode.appendChild(errorDiv);
            input.classList.add('is-invalid');
            setTimeout(() => clearError(input), 3000);
        }

        function clearError(input) {
            const error = document.getElementById(input.name + '_error');
            if (error) error.remove();
            input.classList.remove('is-invalid');
        }

        // === DOM Ready ===
        document.addEventListener('DOMContentLoaded', function() {

            // Apply validation
            document.querySelectorAll('.quantity-input, .price-input').forEach(input => {
                const row = input.closest('tr');
                if (row && row.id !== 'newVariantTemplateRow') {
                    const type = input.classList.contains('quantity-input') ? 'quantity' : 'price';
                    addValidationToInput(input, type);
                }
            });

            // ==================== DELETE ====================
            document.getElementById('variantTable').addEventListener('click', function(e) {
                if (e.target.closest('.btn-remove-variant')) {
                    const row = e.target.closest('tr.variant-row');
                    if (row && !row.classList.contains('new-variant-row') && row.id !== 'newVariantTemplateRow') {
                        if (confirm('Xóa biến thể này khỏi sản phẩm?')) {
                            // Mark as deleted
                            const delInput = document.createElement('input');
                            delInput.type = 'hidden';
                            delInput.name = `ChiTietSanPhams[${row.dataset.variantIndex}].IsDeleted`;
                            delInput.value = 'true';
                            row.appendChild(delInput);

                            row.style.display = 'none';           // Hide visually
                            row.classList.add('deleted-row');
                        }
                    }
                }

                if (e.target.closest('.btn-remove-new-row')) {
                    const row = e.target.closest('tr');
                    if (row) row.remove();
                }
            });

            // ==================== ADD NEW ROW ====================
            (function() {
                const templateRow = document.getElementById('newVariantTemplateRow');
                if (!templateRow) return;
                let nextNewIndex = parseInt(templateRow.getAttribute('data-index'), 10);

                document.getElementById('btnAddNewVariantRow').addEventListener('click', function() {
                    const clone = templateRow.cloneNode(true);
                    clone.id = '';
                    clone.classList.remove('new-variant-row');
                    clone.classList.add('new-variant-clone');
                    clone.style.display = '';

                    const oldPrefix = `ChiTietSanPhams[${templateRow.getAttribute('data-index')}]`;
                    const newPrefix = `ChiTietSanPhams[${nextNewIndex}]`;

                    clone.querySelectorAll('[name]').forEach(el => {
                        if (el.name) el.name = el.name.replace(oldPrefix, newPrefix);
                    });

                    clone.querySelectorAll('input[name="ChiTietSanPhams.Index"]').forEach(el => {
                        el.value = nextNewIndex;
                        el.disabled = false;
                    });

                    const actionTd = clone.querySelector('td:last-child');
                    if (actionTd) actionTd.innerHTML = `<button type="button" class="btn btn-outline-danger btn-sm btn-remove-new-row"><i class="fas fa-times"></i></button>`;

                    templateRow.parentNode.insertBefore(clone, templateRow.parentNode.firstChild);
                    nextNewIndex++;
                });
            })();

            // ==================== SUBMIT - REINDEX + FILTER ====================
            document.querySelector('form').addEventListener('submit', function(e) {
                let hasError = false;

                // Validation
                document.querySelectorAll('#variantTable tbody tr.variant-row').forEach(row => {
                    if (row.style.display === 'none' || row.id === 'newVariantTemplateRow') return;

                    const isNewRow = row.classList.contains('new-variant-clone');
                    const kichCo = row.querySelector('select[name*="IdKichCo"]');
                    const mauSac = row.querySelector('select[name*="IdMauSac"]');

                    if (isNewRow && (!kichCo?.value || !mauSac?.value)) return;

                    const qty = row.querySelector('.quantity-input');
                    const price = row.querySelector('.price-input');

                    if (qty) {
                        const q = parseInt(qty.value, 10);
                        if (isNaN(q) || q < 0) {
                            showError(qty, 'Số lượng không được âm!');
                            hasError = true;
                        }
                    }
                    if (price) {
                        const p = parseFloat(price.value);
                        if (isNaN(p) || p <= 0) {
                            showError(price, 'Giá bán phải lớn hơn 0!');
                            hasError = true;
                        }
                    }
                });

                if (hasError) {
                    e.preventDefault();
                    alert('Vui lòng kiểm tra lại: Số lượng không được âm và Giá bán phải lớn hơn 0.');
                    return;
                }

                // Re-index only visible rows
                const visibleRows = Array.from(document.querySelectorAll('#variantTable tbody tr.variant-row'))
                    .filter(r => r.style.display !== 'none' && r.id !== 'newVariantTemplateRow');

                visibleRows.forEach((row, newIndex) => {
                    row.querySelectorAll('[name^="ChiTietSanPhams["]').forEach(input => {
                        input.name = input.name.replace(/ChiTietSanPhams\[\d+\]/, `ChiTietSanPhams[${newIndex}]`);
                    });

                    const idxInput = row.querySelector('input[name*="ChiTietSanPhams.Index"]');
                    if (idxInput) idxInput.value = newIndex;
                    row.dataset.variantIndex = newIndex;
                });

                // Remove template row
                const template = document.getElementById('newVariantTemplateRow');
                if (template) template.remove();
            });
        });
    </script>

    <!-- Bootstrap & styles (kept your original) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Your existing styles here - copy them from your previous code */
        .is-invalid { border-color: #dc3545; box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25); }
        .validation-error { margin-top: 5px; }
        /* ... paste the rest of your .variant-row, .form-switch, custom-slider styles ... */
    </style>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        .is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }
        .validation-error {
            margin-top: 5px;
        }
        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        input[type="number"] {
            -moz-appearance: textfield;
        }
        .variant-row td {
            text-align: center;
            vertical-align: middle;
        }
        .variant-row .form-control, 
        .variant-row .form-select {
            text-align: center;
        }
        .variant-row .form-check {
            display: flex;
            justify-content: center;
            align-items: center;
        }
        /* Your custom switch styles */
        .form-switch {
            padding-left: 2.5em; 
            min-height: 1.5rem;
        }
        .form-check-input.custom-slider {
            width: 2.5em;
            height: 1.25em;
            margin-left: -7.5em;
            cursor: pointer;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='rgba(0, 0, 0, 0.25)'/%3e%3c/svg%3e");
            background-position: left center;
            border-radius: 2em;
            transition: background-position 0.2s ease-in-out, background-color 0.2s ease-in-out;
        }
        .form-check-input.custom-slider:checked {
            background-position: right center;
            background-color: #0d6efd;
            border-color: #0d6efd;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%23fff'/%3e%3c/svg%3e");
        }
        @@keyframes highlight-fade {
            from { background-color: #fff3cd; }
            to { background-color: transparent; }
        }
        .new-variant-clone {
            animation: highlight-fade 2s ease-out;
        }
    </style>

    @await Html.PartialAsync("_ValidationScriptsPartial")
}