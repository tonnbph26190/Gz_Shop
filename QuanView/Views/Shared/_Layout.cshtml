@using Microsoft.AspNetCore.Mvc.Rendering
@inject BanQuanAu1.Web.Data.BanQuanAu1DbContext DbContext
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var tenDangNhap = User.Identity?.Name;
    var avatarUrl = "/img/avatar-default.png";

    if (User.Identity?.IsAuthenticated == true)
    {
        var kh = DbContext.KhachHang.FirstOrDefault(x =>
            x.TenKhachHang == tenDangNhap ||
            x.Email == tenDangNhap ||
            x.MaKhachHang == tenDangNhap);

        if (kh != null && !string.IsNullOrEmpty(kh.AnhDaiDien))
        {
            avatarUrl = kh.AnhDaiDien;
        }
    }

    string IsActive(string ctrl, string act = "Index") =>
        (currentController == ctrl && currentAction == act) ? "active text-danger fw-bold" : "text-dark";

    var isCustomerLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanView</title>
    <style>
        #toast-container > .toast-success {
            background-color: #28a745 !important;
            opacity: 1 !important;
            color: #fff !important;
        }

        #toast-container > .toast-error {
            background-color: #dc3545 !important;
            opacity: 1 !important;
            color: #fff !important;
        }

        #toast-container > div {
            opacity: 1 !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.25) !important;
        }

        .toast-title {
            font-weight: 700 !important;
            color: #fff !important;
        }

        .toast-message {
            color: #fff !important;
        }
        .user-profile {
            cursor: pointer;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #ddd;
        }

        .profile-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 45px;
            width: 220px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.15);
            z-index: 9999;
            overflow: hidden;
        }

            .profile-menu a {
                display: block;
                padding: 11px 15px;
                color: #333;
                text-decoration: none;
                font-size: 14px;
            }

                .profile-menu a:hover {
                    background: #f8f9fa;
                    color: #dc3545;
                }
        /* Target both html and body to be safe */
        html, body {
            -ms-overflow-style: none !important;  /* IE and Edge */
            scrollbar-width: none !important;     /* Firefox */
        }

        /* For Chrome, Safari and Opera */
        html::-webkit-scrollbar, 
        body::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        /* Ensure the nav container is the reference point */
        #navMenu {
            position: relative;
        }

        /* The red underline bar */
        .nav-underline-bar {
            position: absolute;
            bottom: 0;
            height: 3px;
            background-color: #dc3545; /* Bootstrap danger color */
            transition: all 0.3s ease-in-out;
            border-radius: 2px;
            pointer-events: none; /* Don't block clicks */
        }

        /* Optional: remove the text-danger from your C# IsActive helper 
        if you only want the red bar to signify the active state */
        .nav-link.active {
            color: #dc3545 !important;
            /* Force the navbar to have zero top padding */
        }
        .navbar {
            padding-top: 0 !important;
        }

        /* Remove default margin-bottom that Bootstrap <ul> has */
        .navbar-nav {
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }

        /* Ensure the logo doesn't have internal padding pushing the header up */
        .navbar-brand {
            padding-top: 0 !important;
            margin-top: 0 !important;
            display: flex;
            align-items: center;
            height: 50px; /* Adjust this height to your liking to control the total header thickness */
        }

        .cart-count-badge {
            position: absolute;
            top: 2px;
            right: -10px;
            background: #dc3545;
            color: white;
            font-size: 11px;
            font-weight: bold;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 999px;
            display: none;
            text-align: center;
            line-height: 18px;
            z-index: 999;
        }
        .gz-chat-badge {
            align-items: center;
            background: #dc3545;
            border: 2px solid #fff;
            border-radius: 999px;
            color: #fff;
            display: none;
            font-size: 11px;
            font-weight: 900;
            height: 20px;
            justify-content: center;
            min-width: 20px;
            padding: 0 6px;
            position: absolute;
            right: -6px;
            top: -5px;
        }

        .gz-chat-corner {
            align-items: center;
            background: #2563eb;
            border: 0;
            border-radius: 50%;
            bottom: 26px;
            box-shadow: 0 16px 38px rgba(37, 99, 235, .28);
            color: #fff;
            display: inline-flex;
            height: 48px;
            justify-content: center;
            right: 24px;
            position: fixed;
            text-decoration: none;
            width: 48px;
            z-index: 1040;
        }

        .gz-chat-corner:hover {
            background: #dc3545;
            color: #fff;
            transform: translateY(-2px);
        }

        .gz-chat-corner .gz-chat-badge {
            right: -5px;
            top: -6px;
        }

        .gz-chat-popup {
            background: #fff;
            border: 1px solid rgba(15,23,42,.12);
            border-radius: 16px;
            bottom: 86px;
            box-shadow: 0 26px 80px rgba(15,23,42,.26);
            display: none;
            flex-direction: column;
            height: min(620px, calc(100vh - 130px));
            overflow: hidden;
            position: fixed;
            right: 24px;
            width: min(390px, calc(100vw - 32px));
            z-index: 1050;
        }

        .gz-chat-popup.open {
            display: flex;
        }

        .gz-chat-popup-head {
            align-items: center;
            background: #0f172a;
            color: #fff;
            display: flex;
            gap: 10px;
            justify-content: space-between;
            padding: 12px 14px;
        }

        .gz-chat-popup-title {
            font-weight: 800;
            line-height: 1.2;
        }

        .gz-chat-popup-close {
            background: rgba(255,255,255,.12);
            border: 0;
            border-radius: 50%;
            color: #fff;
            height: 30px;
            width: 30px;
        }

        .gz-chat-popup-messages {
            background: #f8fafc;
            flex: 1;
            overflow: auto;
            padding: 14px;
        }

        .gz-popup-row {
            display: flex;
            margin-bottom: 9px;
        }

        .gz-popup-row.mine {
            justify-content: flex-end;
        }

        .gz-popup-bubble {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            box-shadow: 0 6px 16px rgba(15,23,42,.06);
            color: #111827;
            max-width: 78%;
            padding: 9px 11px;
        }

        .gz-popup-row.mine .gz-popup-bubble {
            background: #2563eb;
            border-color: #2563eb;
            color: #fff;
        }

        .gz-popup-meta {
            color: #94a3b8;
            font-size: 11px;
            margin-top: 4px;
        }

        .gz-popup-row.mine .gz-popup-meta {
            color: rgba(255,255,255,.78);
        }

        .gz-chat-popup-form {
            align-items: center;
            background: #fff;
            border-top: 1px solid #e5e7eb;
            display: flex;
            gap: 8px;
            padding: 10px;
        }

        .gz-chat-popup-form input {
            border: 1px solid #e5e7eb;
            border-radius: 999px;
            flex: 1;
            height: 40px;
            outline: 0;
            padding: 0 14px;
        }

        .gz-chat-popup-form button {
            background: #2563eb;
            border: 0;
            border-radius: 50%;
            color: #fff;
            height: 40px;
            width: 40px;
        }

        .cart-icon-wrap {
            position: relative;
            display: inline-block;
        }

        .cart-count-badge {
            position: absolute;
            top: -9px;
            right: -8px;
            background: #dc3545;
            color: #fff;
            font-size: 10px;
            font-weight: bold;
            min-width: 16px;
            height: 16px;
            padding: 0 4px;
            border-radius: 999px;
            display: none;
            text-align: center;
            line-height: 16px;
            z-index: 999;
        }

        .cart-icon-wrap.cart-pulse {
            animation: cartPulse .55s ease;
        }

        .add-to-cart-flyer {
            border-radius: 10px;
            box-shadow: 0 14px 34px rgba(0,0,0,.22);
            object-fit: cover;
            pointer-events: none;
            position: fixed;
            z-index: 3000;
            transition:
                left .72s cubic-bezier(.2,.8,.2,1),
                top .72s cubic-bezier(.2,.8,.2,1),
                opacity .72s ease,
                transform .72s ease;
        }

        @keyframes cartPulse {
            0% { transform: scale(1); }
            45% { transform: scale(1.22); }
            100% { transform: scale(1); }
        }
    </style>
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" 
    crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Custom -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="font-family:'Nunito Sans', sans-serif">

    <!-- Header -->
    <header class="border-bottom shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-0">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-4 text-dark pt-0 mb-0">
                    GZ Shop<span class="text-danger">.</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto my-0 position-relative" id="navMenu">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(IsActive("Home"))">
                                <i class="fas fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="SanPhamNguoiDung" asp-action="Index" class="nav-link @(IsActive("SanPhamNguoiDung"))">
                                <i class="fas fa-boxes-stacked me-1"></i> Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="GioHang"
                               asp-action="Index"
                               class="nav-link @(IsActive("GioHang"))">

                                <span class="cart-icon-wrap">
                                    <i class="fas fa-cart-shopping me-1"></i>
                                    <span id="cartCountBadge" class="cart-count-badge">0</span>
                                </span>

                                Giỏ hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="DonHang" asp-action="Index" class="nav-link @(IsActive("DonHang"))">
                                <i class="fas fa-file-invoice me-1"></i> Đơn mua
                            </a>
                        </li>
                        <div class="nav-underline-bar"></div>
                    </ul>

                    <!-- User & Cart -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="user-profile position-relative">
                                <div class="profile-toggle d-flex align-items-center gap-2" onclick="toggleProfileMenu()">
                                    <span class="text-muted small">
                                        Xin chào, <b>@User.Identity.Name</b>
                                    </span>

                                    <img src="@avatarUrl"
                                         class="user-avatar"
                                         alt="Avatar" />
                                </div>

                                <div id="profileMenu" class="profile-menu">
                                    <a asp-controller="User" asp-action="Profile">
                                        <i class="fa fa-user me-2"></i> Thông tin tài khoản
                                    </a>

                                 @*    <a asp-controller="User" asp-action="ChangeAvatar">
                                        <i class="fa fa-image me-2"></i> Đổi ảnh đại diện
                                    </a> *@

                                    <a asp-controller="User" asp-action="ChangePassword">
                                        <i class="fa fa-lock me-2"></i> Đổi mật khẩu
                                    </a>

                                    <hr class="my-1" />

                                    <a asp-controller="Login" asp-action="Logout" class="text-danger">
                                        <i class="fa fa-sign-out-alt me-2"></i> Đăng xuất
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn btn-sm btn-outline-dark">Đăng nhập</a>
                            <a asp-controller="Login" asp-action="Register" class="btn btn-sm btn-dark text-white">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main -->
    <main class="flex-fill">
        @RenderBody()
    </main>

    <button type="button" class="gz-chat-corner" id="gzChatToggle" aria-label="Mở tin nhắn" title="Tin nhắn">
        <i class="fas fa-comments"></i>
        <span class="gz-chat-badge" data-chat-badge></span>
    </button>

    <div class="gz-chat-popup" id="gzChatPopup" aria-label="Cửa sổ tin nhắn">
        <div class="gz-chat-popup-head">
            <div>
                <div class="gz-chat-popup-title">GZ Shop</div>
                <small id="gzChatStaff">Hỗ trợ khách hàng</small>
            </div>
            <button type="button" class="gz-chat-popup-close" id="gzChatClose" aria-label="Đóng tin nhắn">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="gz-chat-popup-messages" id="gzChatMessages">
            <div class="text-muted text-center small py-4">Đang tải tin nhắn...</div>
        </div>
        <form class="gz-chat-popup-form" id="gzChatForm">
            <input id="gzChatInput" autocomplete="off" placeholder="Nhập tin nhắn..." />
            <button type="submit" aria-label="Gửi"><i class="fas fa-paper-plane"></i></button>
        </form>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-auto pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
                <!-- About -->
                <div class="col-md-4">
                    <span class="fw-bold text-light h5">GZ Shop</span><span class="text-danger">.</span>
                    <p class="small text-secondary">Thời trang đẳng cấp – phong cách – tinh tế. Khách hàng là trọng tâm trong hành trình của chúng tôi.</p>
                </div>
                <!-- Links -->
                <div class="col-md-4">
                    <h6 class="fw-bold text-light">Liên kết</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="SanPhamNguoiDung" asp-action="Index" class="text-decoration-none text-light">Sản phẩm</a></li>
                        <li><a asp-controller="GioHang" asp-action="Index" class="text-decoration-none text-light">Giỏ hàng</a></li>
                        <li><a asp-controller="DonHang" asp-action="Index" class="text-decoration-none text-light">Đơn mua của tôi</a></li>
                    </ul>
                </div>
                <!-- Newsletter -->
                <div class="col-md-4">
                    <h6 class="fw-bold text-light">Nhập Email để nhận tin mới nhát</h6>
                    <form class="d-flex mt-2">
                        <input type="email" class="form-control form-control-sm me-2" placeholder="Email của bạn">
                        <button class="btn btn-sm btn-danger" type="submit">Gửi</button>
                    </form>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small text-secondary">
                &copy; @DateTime.Now.Year GZ Shop. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const nav = document.querySelector("#navMenu");
            const underline = document.querySelector(".nav-underline-bar");
            const activeLink = nav.querySelector(".nav-link.active");

            function moveUnderline(element) {
                if (element) {
                    underline.style.left = element.offsetLeft + "px";
                    underline.style.width = element.offsetWidth + "px";
                }
            }

            // Initial position on page load
            if (activeLink) {
                moveUnderline(activeLink);
            } else {
                underline.style.width = "0"; // Hide if no active link
            }

            // Optional: Hover effect (moves bar when mouse enters, returns when mouse leaves)
            const links = nav.querySelectorAll(".nav-link");
            links.forEach(link => {
                link.addEventListener("mouseenter", () => moveUnderline(link));
            });

            nav.addEventListener("mouseleave", () => {
                if (activeLink) moveUnderline(activeLink);
                else underline.style.width = "0";
            });
        });

        function toggleProfileMenu() {
            const menu = document.getElementById("profileMenu");
            menu.style.display = menu.style.display === "block" ? "none" : "block";
        }

        document.addEventListener("click", function (e) {
            const profile = document.querySelector(".user-profile");
            const menu = document.getElementById("profileMenu");

            if (profile && menu && !profile.contains(e.target)) {
                menu.style.display = "none";
            }
        });

        async function refreshChatNotifications() {
            try {
                const response = await fetch('/Chat/UnreadSummary', { cache: 'no-store' });
                if (!response.ok) return;
                const result = await response.json();
                const unreadRooms = (result.data || []).filter(room => {
                    const roomId = room.roomId || room.RoomId;
                    const messageId = room.id || room.Id;
                    return roomId && messageId && localStorage.getItem(`gz-chat-seen-${roomId}`) !== String(messageId);
                });
                const count = unreadRooms.length;
                document.querySelectorAll('[data-chat-badge]').forEach(badge => {
                    badge.textContent = count > 99 ? '99+' : String(count);
                    badge.style.display = count > 0 ? 'inline-flex' : 'none';
                });
            } catch {
            }
        }

        window.refreshChatNotifications = refreshChatNotifications;
        document.addEventListener('DOMContentLoaded', () => {
            refreshChatNotifications();
            setInterval(refreshChatNotifications, 15000);
        });

        const gzChatPopup = document.getElementById('gzChatPopup');
        const gzChatToggle = document.getElementById('gzChatToggle');
        const gzChatClose = document.getElementById('gzChatClose');
        const gzChatMessages = document.getElementById('gzChatMessages');
        const gzChatForm = document.getElementById('gzChatForm');
        const gzChatInput = document.getElementById('gzChatInput');
        const gzChatIsLoggedIn = @(isCustomerLoggedIn.ToString().ToLowerInvariant());
        const gzChatLoginUrl = '@Url.Action("Index", "Login")';
        let gzChatTimer = null;

        function gzEscape(value) {
            return String(value || '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
        }

        function gzChatTime(value) {
            return value ? new Date(value).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' }) : '';
        }

        async function loadPopupChat() {
            if (!gzChatMessages) return;
            const response = await fetch('/Chat/Messages', { cache: 'no-store' });
            if (!response.ok) {
                window.location.href = gzChatLoginUrl;
                return;
            }
            const result = await response.json();
            if (!result.success) return;
            document.getElementById('gzChatStaff').textContent = result.room?.staffName || 'Hỗ trợ khách hàng';
            const messages = result.data || [];
            if (!messages.length) {
                gzChatMessages.innerHTML = '<div class="text-muted text-center small py-4">Shop có thể hỗ trợ gì cho bạn?</div>';
                return;
            }
            gzChatMessages.innerHTML = messages.map(m => `
                <div class="gz-popup-row ${m.senderType === 'customer' ? 'mine' : ''}">
                    <div class="gz-popup-bubble">
                        <div>${gzEscape(m.content)}</div>
                        <div class="gz-popup-meta">${gzEscape(m.senderName)} · ${gzChatTime(m.createdAt)}</div>
                    </div>
                </div>`).join('');
            gzChatMessages.scrollTop = gzChatMessages.scrollHeight;
            const last = messages[messages.length - 1];
            if (result.room?.id && last?.id) {
                localStorage.setItem(`gz-chat-seen-${result.room.id}`, String(last.id));
                refreshChatNotifications();
            }
        }

        gzChatToggle?.addEventListener('click', async () => {
            if (!gzChatIsLoggedIn) {
                window.location.href = gzChatLoginUrl;
                return;
            }

            gzChatPopup?.classList.toggle('open');
            if (gzChatPopup?.classList.contains('open')) {
                await loadPopupChat();
                clearInterval(gzChatTimer);
                gzChatTimer = setInterval(loadPopupChat, 5000);
                gzChatInput?.focus();
            } else {
                clearInterval(gzChatTimer);
            }
        });

        gzChatClose?.addEventListener('click', () => {
            gzChatPopup?.classList.remove('open');
            clearInterval(gzChatTimer);
        });

        gzChatForm?.addEventListener('submit', async event => {
            event.preventDefault();
            const content = gzChatInput.value.trim();
            if (!content) return;
            gzChatInput.value = '';
            const response = await fetch('/Chat/Send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ content })
            });
            if (response.status === 401 || response.redirected) {
                window.location.href = gzChatLoginUrl;
                return;
            }
            if (response.ok) await loadPopupChat();
        });
        window.loadCartCount = async function () {

            try {

                const response = await fetch('/GioHang/Count');

                const data = await response.json();

                const badge = document.getElementById('cartCountBadge');

                if (!badge) return;

                if (data.count > 0) {

                    badge.innerText = data.count;

                    badge.style.display = 'inline-block';

                } else {

                    badge.style.display = 'none';
                }

            } catch {

            }
        }

        document.addEventListener('DOMContentLoaded', function () {

            loadCartCount();
        });

        window.animateAddToCart = function (sourceElement) {
            const cartIcon = document.querySelector('.cart-icon-wrap');
            const source = sourceElement || document.querySelector('.product-detail-img-main') || document.querySelector('.product-img');

            if (!cartIcon || !source) return Promise.resolve();

            const sourceRect = source.getBoundingClientRect();
            const cartRect = cartIcon.getBoundingClientRect();
            const flyer = source.cloneNode(true);
            const size = Math.min(96, Math.max(56, sourceRect.width * 0.28));

            flyer.classList.add('add-to-cart-flyer');
            flyer.style.left = `${sourceRect.left + sourceRect.width / 2 - size / 2}px`;
            flyer.style.top = `${sourceRect.top + sourceRect.height / 2 - size / 2}px`;
            flyer.style.width = `${size}px`;
            flyer.style.height = `${size}px`;
            flyer.style.transform = 'scale(1)';
            flyer.style.opacity = '1';
            document.body.appendChild(flyer);

            requestAnimationFrame(() => {
                flyer.style.left = `${cartRect.left + cartRect.width / 2 - size / 2}px`;
                flyer.style.top = `${cartRect.top + cartRect.height / 2 - size / 2}px`;
                flyer.style.transform = 'scale(.28) rotate(10deg)';
                flyer.style.opacity = '.15';
            });

            return new Promise(resolve => {
                setTimeout(() => {
                    flyer.remove();
                    cartIcon.classList.add('cart-pulse');
                    setTimeout(() => cartIcon.classList.remove('cart-pulse'), 560);
                    resolve();
                }, 740);
            });
        };
    </script>
</body>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "3000"
    };

</script>

@if (TempData["Success"] != null)
{
    <script>
        toastr.success('@TempData["Success"]', 'Thành công');
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        toastr.error('@TempData["Error"]', 'Lỗi');
    </script>
}
</html>
