@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var lang = Context.Request.Cookies["UserLanguage"] ?? "vi"; 
    
    string IsActive(string ctrl, string act = "Index") =>
        (currentController == ctrl && currentAction == act) ? "active text-danger fw-bold" : "text-dark";
}

<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GZ Shop</title>

    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="font-family:'Nunito Sans', sans-serif">

    <header class="border-bottom shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light bg-white">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-4 text-dark">
                    GZ Shop<span class="text-danger">.</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(IsActive("Home"))">
                                @(lang == "vi" ? "Trang chủ" : "Home")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="SanPhamNguoiDung" asp-action="Index" class="nav-link @(IsActive("SanPhamNguoiDung"))">
                                @(lang == "vi" ? "Sản phẩm" : "Products")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="GioHang" asp-action="Index" class="nav-link @(IsActive("GioHang"))">
                                @(lang == "vi" ? "Giỏ hàng" : "Cart")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="DonHang" asp-action="Index" class="nav-link @(IsActive("DonHang"))">
                                @(lang == "vi" ? "Đơn hàng" : "My Orders")
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <span class="text-muted small">
                                @(lang == "vi" ? "Xin chào" : "Hello"), <b>@User.Identity.Name</b>
                            </span>
                            <a asp-controller="Login" asp-action="Logout" class="btn btn-sm btn-outline-secondary">
                                @(lang == "vi" ? "Đăng xuất" : "Logout")
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn btn-sm btn-outline-dark">
                                @(lang == "vi" ? "Đăng nhập" : "Login")
                            </a>
                            <a asp-controller="Login" asp-action="Register" class="btn btn-sm btn-dark text-white">
                                @(lang == "vi" ? "Đăng ký" : "Register")
                            </a>
                        }

                        <div class="btn-group">
                            <a href="@Url.Action("SetLanguage", "Home", new { culture = "vi" })" 
                               class="btn btn-sm @(lang == "vi" ? "btn-secondary" : "btn-outline-secondary")">VN</a>
                            <a href="@Url.Action("SetLanguage", "Home", new { culture = "en" })" 
                               class="btn btn-sm @(lang == "en" ? "btn-secondary" : "btn-outline-secondary")">EN</a>
                        </div>

                        <a asp-controller="GioHang" asp-action="Index" class="position-relative text-dark ms-2">
                            <i class="fa fa-shopping-cart fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"></span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="dynamic-body" class="flex-fill" style="transition: background 0.5s ease;">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-auto pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <span class="fw-bold text-light h5">GZ Shop</span><span class="text-danger">.</span>
                    <p class="small text-secondary">
                        @if (lang == "vi") {
                            @:Thời trang quần âu hiện đại – lịch lãm – đẳng cấp. Khách hàng là trọng tâm trong hành trình của chúng tôi.
                        } else {
                            @:Modern trousers – Elegant – Classy. Customers are the heart of our journey.
                        }
                    </p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold">@(lang == "vi" ? "Liên kết" : "Quick Links")</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="SanPhamNguoiDung" asp-action="Index" class="text-decoration-none text-light">@(lang == "vi" ? "Sản phẩm" : "Products")</a></li>
                        <li><a asp-controller="GioHang" asp-action="Index" class="text-decoration-none text-light">@(lang == "vi" ? "Giỏ hàng" : "Cart")</a></li>
                        <li><a asp-controller="DonHang" asp-action="Index" class="text-decoration-none text-light">@(lang == "vi" ? "Đơn mua" : "Orders")</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-light">@(lang == "vi" ? "Hỗ trợ qua Email" : "Email Support")</h6>
                    <form class="d-flex mt-2">
                        <input type="email" class="form-control form-control-sm me-2" placeholder="@(lang == "vi" ? "Email của bạn" : "Your email")">
                        <button class="btn btn-sm btn-danger" type="submit">@(lang == "vi" ? "Gửi" : "Send")</button>
                    </form>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small text-secondary">
                &copy; @DateTime.Now.Year GZ Shop. @(lang == "vi" ? "Tất cả quyền được bảo lưu." : "All rights reserved.")
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        function updateDynamicBackground() {
            const mainContent = document.getElementById('dynamic-body');
            // Looks for the first image in the rendered body
            const firstImage = mainContent.querySelector('img');

            if (firstImage) {
                const img = new Image();
                img.crossOrigin = "Anonymous"; 
                img.src = firstImage.src;

                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    canvas.width = 1;
                    canvas.height = 1;

                    ctx.drawImage(img, 0, 0, 1, 1);
                    const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;

                    mainContent.style.background = `linear-gradient(180deg, rgba(${r},${g},${b}, 0.15) 0%, rgba(255,255,255,1) 100%)`;
                };
            }
        }

        window.addEventListener('load', updateDynamicBackground);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
