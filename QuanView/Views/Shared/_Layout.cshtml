@using Microsoft.AspNetCore.Mvc.Rendering
@inject BanQuanAu1.Web.Data.BanQuanAu1DbContext DbContext
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var tenDangNhap = User.Identity?.Name;
    var avatarUrl = "/img/avatar-default.png";

    if (User.Identity?.IsAuthenticated == true)
    {
        var kh = DbContext.KhachHang.FirstOrDefault(x =>
            x.TenKhachHang == tenDangNhap ||
            x.Email == tenDangNhap ||
            x.MaKhachHang == tenDangNhap);

        if (kh != null && !string.IsNullOrEmpty(kh.AnhDaiDien))
        {
            avatarUrl = kh.AnhDaiDien;
        }
    }

    string IsActive(string ctrl, string act = "Index") =>
        (currentController == ctrl && currentAction == act) ? "active text-danger fw-bold" : "text-dark";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuanView</title>
    <style>
        #toast-container > .toast-success {
            background-color: #28a745 !important;
            opacity: 1 !important;
            color: #fff !important;
        }

        #toast-container > .toast-error {
            background-color: #dc3545 !important;
            opacity: 1 !important;
            color: #fff !important;
        }

        #toast-container > div {
            opacity: 1 !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.25) !important;
        }

        .toast-title {
            font-weight: 700 !important;
            color: #fff !important;
        }

        .toast-message {
            color: #fff !important;
        }
        .user-profile {
            cursor: pointer;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #ddd;
        }

        .profile-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 45px;
            width: 220px;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 5px 18px rgba(0,0,0,0.15);
            z-index: 9999;
            overflow: hidden;
        }

            .profile-menu a {
                display: block;
                padding: 11px 15px;
                color: #333;
                text-decoration: none;
                font-size: 14px;
            }

                .profile-menu a:hover {
                    background: #f8f9fa;
                    color: #dc3545;
                }
        /* Target both html and body to be safe */
        html, body {
            -ms-overflow-style: none !important;  /* IE and Edge */
            scrollbar-width: none !important;     /* Firefox */
        }

        /* For Chrome, Safari and Opera */
        html::-webkit-scrollbar, 
        body::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }
        /* Ensure the nav container is the reference point */
        #navMenu {
            position: relative;
        }

        /* The red underline bar */
        .nav-underline-bar {
            position: absolute;
            bottom: 0;
            height: 3px;
            background-color: #dc3545; /* Bootstrap danger color */
            transition: all 0.3s ease-in-out;
            border-radius: 2px;
            pointer-events: none; /* Don't block clicks */
        }

        /* Optional: remove the text-danger from your C# IsActive helper 
        if you only want the red bar to signify the active state */
        .nav-link.active {
            color: #dc3545 !important;
            /* Force the navbar to have zero top padding */
        }
        .navbar {
            padding-top: 0 !important;
        }

        /* Remove default margin-bottom that Bootstrap <ul> has */
        .navbar-nav {
            margin-top: 0 !important;
            margin-bottom: 0 !important;
        }

        /* Ensure the logo doesn't have internal padding pushing the header up */
        .navbar-brand {
            padding-top: 0 !important;
            margin-top: 0 !important;
            display: flex;
            align-items: center;
            height: 50px; /* Adjust this height to your liking to control the total header thickness */
        }
        
    </style>
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap & FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
    integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" 
    crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Custom -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="font-family:'Nunito Sans', sans-serif">

    <!-- Header -->
    <header class="border-bottom shadow-sm bg-white">
        <nav class="navbar navbar-expand-lg navbar-light bg-white py-0">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold fs-4 text-dark pt-0 mb-0">
                    GZ Shop<span class="text-danger">.</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto my-0 position-relative" id="navMenu">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" class="nav-link @(IsActive("Home"))">
                                <i class="fas fa-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="SanPhamNguoiDung" asp-action="Index" class="nav-link @(IsActive("SanPhamNguoiDung"))">
                                <i class="fas fa-boxes-stacked me-1"></i> Sản phẩm
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="GioHang" asp-action="Index" class="nav-link @(IsActive("GioHang"))">
                                <i class="fas fa-cart-shopping me-1"></i> Giỏ hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="DonHang" asp-action="Index" class="nav-link @(IsActive("DonHang"))">
                                <i class="fas fa-file-invoice me-1"></i> Đơn mua
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Chat" asp-action="Index" class="nav-link @(IsActive("Chat"))">
                                <i class="fas fa-comments me-1"></i> Tin nhắn
                            </a>
                        </li>
                        <div class="nav-underline-bar"></div>
                    </ul>

                    <!-- User & Cart -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="user-profile position-relative">
                                <div class="profile-toggle d-flex align-items-center gap-2" onclick="toggleProfileMenu()">
                                    <span class="text-muted small">
                                        Xin chào, <b>@User.Identity.Name</b>
                                    </span>

                                    <img src="@avatarUrl"
                                         class="user-avatar"
                                         alt="Avatar" />
                                </div>

                                <div id="profileMenu" class="profile-menu">
                                    <a asp-controller="User" asp-action="Profile">
                                        <i class="fa fa-user me-2"></i> Thông tin tài khoản
                                    </a>

                                 @*    <a asp-controller="User" asp-action="ChangeAvatar">
                                        <i class="fa fa-image me-2"></i> Đổi ảnh đại diện
                                    </a> *@

                                    <a asp-controller="User" asp-action="ChangePassword">
                                        <i class="fa fa-lock me-2"></i> Đổi mật khẩu
                                    </a>

                                    <hr class="my-1" />

                                    <a asp-controller="Login" asp-action="Logout" class="text-danger">
                                        <i class="fa fa-sign-out-alt me-2"></i> Đăng xuất
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Login" asp-action="Index" class="btn btn-sm btn-outline-dark">Đăng nhập</a>
                            <a asp-controller="Login" asp-action="Register" class="btn btn-sm btn-dark text-white">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main -->
    <main class="flex-fill">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light mt-auto pt-5 pb-3">
        <div class="container">
            <div class="row g-4">
                <!-- About -->
                <div class="col-md-4">
                    <span class="fw-bold text-light h5">GZ Shop</span><span class="text-danger">.</span>
                    <p class="small text-secondary">Thời trang đẳng cấp – phong cách – tinh tế. Khách hàng là trọng tâm trong hành trình của chúng tôi.</p>
                </div>
                <!-- Links -->
                <div class="col-md-4">
                    <h6 class="fw-bold text-light">Liên kết</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="SanPhamNguoiDung" asp-action="Index" class="text-decoration-none text-light">Sản phẩm</a></li>
                        <li><a asp-controller="GioHang" asp-action="Index" class="text-decoration-none text-light">Giỏ hàng</a></li>
                        <li><a asp-controller="DonHang" asp-action="Index" class="text-decoration-none text-light">Đơn mua của tôi</a></li>
                    </ul>
                </div>
                <!-- Newsletter -->
                <div class="col-md-4">
                    <h6 class="fw-bold text-light">Nhập Email để nhận tin mới nhát</h6>
                    <form class="d-flex mt-2">
                        <input type="email" class="form-control form-control-sm me-2" placeholder="Email của bạn">
                        <button class="btn btn-sm btn-danger" type="submit">Gửi</button>
                    </form>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small text-secondary">
                &copy; @DateTime.Now.Year GZ Shop. All rights reserved.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const nav = document.querySelector("#navMenu");
            const underline = document.querySelector(".nav-underline-bar");
            const activeLink = nav.querySelector(".nav-link.active");

            function moveUnderline(element) {
                if (element) {
                    underline.style.left = element.offsetLeft + "px";
                    underline.style.width = element.offsetWidth + "px";
                }
            }

            // Initial position on page load
            if (activeLink) {
                moveUnderline(activeLink);
            } else {
                underline.style.width = "0"; // Hide if no active link
            }

            // Optional: Hover effect (moves bar when mouse enters, returns when mouse leaves)
            const links = nav.querySelectorAll(".nav-link");
            links.forEach(link => {
                link.addEventListener("mouseenter", () => moveUnderline(link));
            });

            nav.addEventListener("mouseleave", () => {
                if (activeLink) moveUnderline(activeLink);
                else underline.style.width = "0";
            });
        });

        function toggleProfileMenu() {
            const menu = document.getElementById("profileMenu");
            menu.style.display = menu.style.display === "block" ? "none" : "block";
        }

        document.addEventListener("click", function (e) {
            const profile = document.querySelector(".user-profile");
            const menu = document.getElementById("profileMenu");

            if (profile && menu && !profile.contains(e.target)) {
                menu.style.display = "none";
            }
        });
    </script>
</body>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    toastr.options = {
        "closeButton": true,
        "progressBar": true,
        "positionClass": "toast-top-right",
        "timeOut": "3000"
    };

</script>

@if (TempData["Success"] != null)
{
    <script>
        toastr.success('@TempData["Success"]', 'Thành công');
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        toastr.error('@TempData["Error"]', 'Lỗi');
    </script>
}
</html>
