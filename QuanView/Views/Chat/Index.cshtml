@{
    ViewData["Title"] = "Tin nhắn";
    var chatError = ViewBag.ChatError as string;
    var staffName = ViewBag.StaffName as string ?? "Nhân viên hỗ trợ";
}

<section class="customer-chat-page">
    <div class="chat-shell">
        <div class="chat-hero">
            <div class="support-avatar">
                <i class="fa fa-headset"></i>
            </div>
            <div>
                <h1>Hỗ trợ khách hàng</h1>
                <p id="supportName">@staffName</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(chatError))
        {
            <div class="chat-error">@chatError</div>
        }

        <div id="messageList" class="customer-message-list">
            <div class="empty-chat">
                <i class="fa fa-comments"></i>
                <p>Đang tải tin nhắn...</p>
            </div>
        </div>

        <form id="sendForm" class="customer-composer">
            <input type="text" id="messageInput" placeholder="Nhập tin nhắn cho shop..." autocomplete="off" @(string.IsNullOrWhiteSpace(chatError) ? "" : "disabled")>
            <button type="submit" @(string.IsNullOrWhiteSpace(chatError) ? "" : "disabled")>
                <i class="fa fa-paper-plane"></i>
            </button>
        </form>
    </div>
</section>

<style>
    .customer-chat-page {
        min-height: calc(100vh - 120px);
        background: #f1f5f9;
        padding: 36px 16px;
    }

    .chat-shell {
        width: min(920px, 100%);
        height: min(720px, calc(100vh - 160px));
        min-height: 560px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10);
    }

    .chat-hero {
        height: 76px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 20px;
        border-bottom: 1px solid #e5e7eb;
        background: #0f172a;
        color: #fff;
    }

    .support-avatar {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: #fff;
        font-size: 1.2rem;
    }

    .chat-hero h1 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 800;
        letter-spacing: 0;
    }

    .chat-hero p {
        margin: 2px 0 0;
        color: #cbd5e1;
        font-size: .9rem;
    }

    .chat-error {
        margin: 16px;
        padding: 12px 14px;
        border-radius: 8px;
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        font-weight: 700;
    }

    .customer-message-list {
        flex: 1;
        min-height: 0;
        overflow: auto;
        padding: 22px;
        background: #f8fafc;
    }

    .message-row {
        display: flex;
        margin-bottom: 10px;
    }

    .message-row.mine {
        justify-content: flex-end;
    }

    .message-bubble {
        max-width: min(560px, 78%);
        padding: 10px 13px;
        border-radius: 16px;
        background: #fff;
        color: #111827;
        border: 1px solid #e5e7eb;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.05);
    }

    .message-row.mine .message-bubble {
        background: #2563eb;
        color: #fff;
        border-color: #2563eb;
    }

    .message-meta {
        margin-top: 4px;
        color: #94a3b8;
        font-size: .72rem;
    }

    .message-row.mine .message-meta {
        color: rgba(255,255,255,.78);
        text-align: right;
    }

    .customer-composer {
        display: flex;
        gap: 10px;
        padding: 14px;
        border-top: 1px solid #e5e7eb;
        background: #fff;
    }

    .customer-composer input {
        flex: 1;
        height: 48px;
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 0 17px;
        outline: 0;
    }

    .customer-composer input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .customer-composer button {
        width: 48px;
        height: 48px;
        border: 0;
        border-radius: 50%;
        background: #2563eb;
        color: #fff;
    }

    .customer-composer button:disabled,
    .customer-composer input:disabled {
        opacity: .55;
    }

    .empty-chat {
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #64748b;
        text-align: center;
        gap: 10px;
    }

    .empty-chat i {
        font-size: 3rem;
        color: #cbd5e1;
    }

    @@media (max-width: 768px) {
        .customer-chat-page {
            padding: 0;
        }

        .chat-shell {
            height: calc(100vh - 56px);
            min-height: 520px;
            border-radius: 0;
            border-left: 0;
            border-right: 0;
        }
    }
</style>

@section Scripts {
    <script>
        $(function () {
            const hasError = @((!string.IsNullOrWhiteSpace(chatError)).ToString().ToLowerInvariant());
            const $messageList = $('#messageList');
            const $messageInput = $('#messageInput');

            function escapeHtml(value) {
                return String(value || '').replace(/[&<>"']/g, function (ch) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
                });
            }

            function formatTime(value) {
                if (!value) return '';
                return new Date(value).toLocaleString('vi-VN', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
            }

            function loadMessages() {
                if (hasError) return;
                $.get('@Url.Action("Messages", "Chat")')
                    .done(function (res) {
                        if (!res || !res.success) return;
                        $('#supportName').text(res.room.staffName || 'Nhân viên hỗ trợ');

                        const messages = res.data || [];
                        if (!messages.length) {
                            $messageList.html('<div class="empty-chat"><i class="fa fa-comment-dots"></i><p>Shop có thể hỗ trợ gì cho bạn?</p></div>');
                            return;
                        }

                        $messageList.html(messages.map(m => `
                            <div class="message-row ${m.senderType === 'customer' ? 'mine' : ''}">
                                <div class="message-bubble">
                                    <div>${escapeHtml(m.content)}</div>
                                    <div class="message-meta">${escapeHtml(m.senderName)} · ${formatTime(m.createdAt)}</div>
                                </div>
                            </div>
                        `).join(''));
                        markRoomSeen(res.room.id, messages);
                        $messageList.scrollTop($messageList[0].scrollHeight);
                    });
            }

            function markRoomSeen(roomId, messages) {
                if (!roomId || !messages || !messages.length) return;
                const lastMessage = messages[messages.length - 1];
                if (!lastMessage || !lastMessage.id) return;
                localStorage.setItem(`gz-chat-seen-${roomId}`, String(lastMessage.id));
                if (typeof window.refreshChatNotifications === 'function') {
                    window.refreshChatNotifications();
                }
            }

            $('#sendForm').on('submit', function (e) {
                e.preventDefault();
                const content = $messageInput.val().trim();
                if (!content) return;
                $(this).find('button').prop('disabled', true);
                $.post('@Url.Action("Send", "Chat")', { content: content })
                    .done(function () {
                        $messageInput.val('');
                        loadMessages();
                    })
                    .always(() => $('#sendForm').find('button').prop('disabled', false));
            });

            loadMessages();
            setInterval(loadMessages, 5000);
        });
    </script>
}
