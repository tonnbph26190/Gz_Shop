@model QuanApi.Dtos.SanPhamKhachHangViewModel
@{
    var lang = Context.Request.Cookies["UserLanguage"] ?? "vi"; 
    ViewData["Title"] = ((lang == "vi") ? "Chi tiết sản phẩm" : "Product Details");
    var userId = ViewBag.UserId ?? ""; // Lấy từ ViewBag, nếu chưa có thì để rỗng
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<style>
    :root {
        --primary-red: #d32f2f;
        --hover-red: #b71c1c;
        --soft-bg: #f8f9fa;
        --border-color: #e0e0e0;
    }

    .product-detail-container {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 40px;
        margin-top: 30px;
        border: 1px solid rgba(0,0,0,0.05);
    }

    /* Modern Image Slider */
    .carousel-viewport {
        width: 100%;
        aspect-ratio: 1 / 1; /* This ensures the box has a height based on its width */
        overflow: hidden;
        position: relative;
        border-radius: 15px;
        background: #f8f9fa;
        display: block; /* Ensure it's not hidden */
    }

    .carousel-viewport:hover .product-detail-img-main {
        transform: scale(1.08);
    }

    .product-detail-img-main {
        width: 100%;
        height: 100%;
        object-fit: contain; /* Keeps the whole image visible without cropping */
        display: block;
        transition: transform .45s ease;
        will-change: transform;
    }

    /* Thumbnail styling */
    .thumbnail-list {
        gap: 10px;
        padding: 10px 0;
        scrollbar-width: thin;
    }

    .thumb-item {
        width: 80px;
        height: 80px;
        border-radius: 10px;
        border: 2px solid transparent;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        opacity: 0.6;
    }

    .thumb-item.active {
        border-color: var(--primary-red);
        opacity: 1;
        transform: translateY(-3px);
        box-shadow: 0 4px 10px rgba(211, 47, 47, 0.2);
    }

    /* Variant Buttons */
    .product-detail-btn-option {
        padding: 10px 20px;
        border: 1px solid var(--border-color);
        border-radius: 30px; /* Pill shape */
        background: #fff;
        margin: 4px;
        font-weight: 500;
        transition: all 0.2s;
    }

    .product-detail-btn-option:hover:not(.disabled) {
        border-color: var(--primary-red);
        color: var(--primary-red);
    }

    .product-detail-btn-option.selected {
        background: var(--primary-red) !important;
        color: white !important;
        border-color: var(--primary-red);
        box-shadow: 0 4px 12px rgba(211, 47, 47, 0.3);
    }

    .product-detail-btn-option.disabled {
        background: #f5f5f5;
        color: #ccc;
        text-decoration: line-through;
        cursor: not-allowed;
    }

    /* Price Section */
    .product-detail-price {
        font-size: 2.5rem;
        color: var(--primary-red);
        font-weight: 800;
        letter-spacing: -1px;
    }

    .product-detail-oldprice {
        color: #9ca3af;
        font-size: 1.35rem;
        font-weight: 600;
        text-decoration: line-through;
        text-decoration-thickness: 2px;
    }

    .product-detail-discount-badge {
        background: rgba(211, 47, 47, 0.1);
        border-radius: 999px;
        color: var(--primary-red);
        font-size: 0.8rem;
        font-weight: 700;
        padding: 5px 10px;
    }

    /* Quantity Toggle */
    .product-detail-qty {
        background: var(--soft-bg);
        border-radius: 10px;
        padding: 5px;
        display: inline-flex;
        border: 1px solid var(--border-color);
    }

    .product-detail-qty-btn {
        width: 40px;
        height: 40px;
        border: none;
        background: transparent;
        font-size: 1.2rem;
        border-radius: 8px;
        transition: background 0.2s;
    }

    .product-detail-qty-btn:hover {
        background: rgba(0,0,0,0.05);
    }

    #soLuong {
        background: transparent;
        border: none;
        font-weight: bold;
        font-size: 1.1rem;
    }

    /* Action Button */
    .product-detail-addcart {
        height: 60px;
        border-radius: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
        box-shadow: 0 6px 20px rgba(211, 47, 47, 0.3);
        transition: transform .2s ease, box-shadow .2s ease, opacity .2s ease;
    }

    .product-detail-addcart:hover:not(:disabled) {
        box-shadow: 0 10px 26px rgba(211, 47, 47, 0.38);
        transform: translateY(-2px);
    }

    .product-detail-addcart.is-adding {
        opacity: .8;
        pointer-events: none;
    }

    .back-to-index-btn {
        border-radius: 30px;
        padding: 10px 25px;
        color:black;
        text-decoration: none;
        background: white;
        border: 1px solid var(--border-color);
        font-weight: 600;
    }
    .back-to-index-btn:hover{
        border-color: red;
        color:red;
    }
    /* Remove default arrows for Chrome, Safari, Edge, Opera */
    #soLuong::-webkit-outer-spin-button,
    #soLuong::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Remove default arrows for Firefox */
    #soLuong[type=number] {
        -moz-appearance: textfield;
    }

    /* Ensure the image slider takes up full height/width */
    #imageSlider div {
        display: flex;
        justify-content: center;
        align-items: center;
        background: #f8f9fa;
    }
    #imageSlider {
        display: flex;
        height: 100%;
        width: 100%;
    }
</style>

<div class="container py-4">
    <a href="/SanPhamNguoiDung/Index" class="back-to-index-btn m-2">
        <i class="fa fa-arrow-left me-2"></i> @((lang == "vi") ? "Quay lại" : "Back")
    </a>

    <div class="product-detail-container">
        <div class="row g-5"> <div class="col-md-5">
                @if (Model.DanhSachAnh != null && Model.DanhSachAnh.Any())
                {
                    <div class="carousel-viewport" style="aspect-ratio: 1/1; overflow: hidden; position: relative; border-radius: 15px;">
                        <div id="imageSlider" class="d-flex" style="transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); width: 100%; height: 100%;">
                            @foreach (var img in Model.DanhSachAnh)
                            {
                                <div style="min-width: 100%; height: 100%; flex-shrink: 0;">
                                    <img src="@img" class="product-detail-img-main" style="width: 100%; height: 100%; object-fit: contain;" />
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-row mt-3 thumbnail-list justify-content-start w-100 overflow-auto">
                        @for (int i = 0; i < Model.DanhSachAnh.Count; i++)
                        {
                            <img src="@Model.DanhSachAnh[i]"
                                 class="thumb-item @(i == 0 ? "active" : "")"
                                 data-index="@i" />
                        }
                    </div>
                }
            </div>
            
            <div class="col-md-7">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item text-muted">@Model.DanhMuc</li>
                    </ol>
                </nav>
                <h1 class="product-detail-title h2 mb-3">@Model.TenSanPham</h1>
                
                <div class="d-flex align-items-center flex-wrap gap-2 mb-4">
                    <span class="product-detail-price" id="giaBan">---</span>
                    <span class="product-detail-oldprice" id="giaGoc"></span>
                    <span class="product-detail-discount-badge d-none" id="phanTramGiam"></span>
                </div>

                <hr class="my-4 opacity-50">

                <div class="product-variant-selectors">
                    <div class="mb-4">
                        <label class="form-label d-block fw-bold text-uppercase small text-muted mb-3">
                            @((lang == "vi") ? "Màu sắc" : "Color")
                        </label>
                        <div id="colorOptions" class="d-flex flex-wrap gap-1"></div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block fw-bold text-uppercase small text-muted mb-3">
                            @((lang == "vi") ? "Kích thước" : "Size")
                        </label>
                        <div id="sizeOptions" class="d-flex flex-wrap gap-1"></div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block fw-bold text-uppercase small text-muted mb-3">
                            @((lang == "vi") ? "Họa tiết" : "Pattern")
                        </label>
                        <div id="patternOptions" class="d-flex flex-wrap gap-1"></div>
                    </div>

                    <div class="row align-items-center mt-5">
                        <div class="col-auto">
                            <label class="fw-bold me-3">@((lang == "vi") ? "Số lượng:" : "Qty:")</label>
                            <div class="product-detail-qty">
                                <button type="button" class="product-detail-qty-btn" id="btnMinus"><i class="fa fa-minus small"></i></button>
                                <input type="number"
                                       id="soLuong"
                                       class="form-control text-center"
                                       style="width: 70px; border: none; font-weight: bold; background: transparent; box-shadow:none;"
                                       min="1"
                                       step="1"
                                       inputmode="numeric"
                                       value="1">
                                <button type="button" class="product-detail-qty-btn" id="btnPlus"><i class="fa fa-plus small"></i></button>
                            </div>
                        </div>
                        <div class="col">
                            <div id="stockInfo" class="ms-2"></div>
                        </div>
                    </div>
                </div>

                <button class="btn btn-primary product-detail-addcart w-100 mt-4 d-flex align-items-center justify-content-center" onclick="themGioHang()">
                    <i class="fas fa-shopping-bag me-3"></i>
                    <span>@((lang == "vi") ? "Thêm vào giỏ hàng" : "Add to Cart")</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- 1. GLOBAL VARIABLES & STATE ---
        let lang = "@lang";
        let bienThes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BienThes));
        console.log("BIEN THES =", bienThes);
        let images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachAnh));
        
        let selectedSize = '';
        let selectedColor = '';
        let selectedPattern = '';

        // Carousel State
        let currentIndex = 0;
        let totalImages = images ? images.length : 0;
        let autoCycleTimer;
        let pauseTimeout;

        // --- 2. CAROUSEL LOGIC ---
        function moveSlider(index) {
            if (totalImages <= 0) return;
            if (index >= totalImages) index = 0;
            if (index < 0) index = totalImages - 1;

            currentIndex = index;
            const offset = -currentIndex * 100;
            $('#imageSlider').css('transform', `translateX(${offset}%)`);

            // Update Thumbnail UI
            $('.thumb-item').removeClass('active');
            const $activeThumb = $(`.thumb-item[data-index="${currentIndex}"]`);
            $activeThumb.addClass('active');
            
            // Smoothly scroll thumbnail into view if list is long
            $activeThumb[0].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }

        function startAutoCycle() {
            stopAutoCycle();
            if (totalImages > 1) {
                autoCycleTimer = setInterval(() => moveSlider(currentIndex + 1), 5000);
            }
        }

        function stopAutoCycle() {
            clearInterval(autoCycleTimer);
            clearTimeout(pauseTimeout);
        }

        // --- 3. PRODUCT VARIANT LOGIC ---
        function renderOptions() {
            const allColors = [...new Set(bienThes.map(b => b.Mau))];
            const allSizes = [...new Set(bienThes.map(b => b.Size))];
            const allPatterns = [...new Set(bienThes.map(b => b.HoaTiet))];

            // COLOR
            $('#colorOptions').html(allColors.map(mau => {
                const hasStock = bienThes.some(b => b.Mau === mau && b.SoLuong > 0);
                const isSelected = selectedColor === mau ? 'selected' : '';
                const isDisabled = !hasStock ? 'disabled' : '';
                return `<button type="button" class="product-detail-btn-option ${isSelected} ${isDisabled}" data-mau="${mau}" ${isDisabled}>${mau}</button>`;
            }).join(''));

            // SIZE
            $('#sizeOptions').html(allSizes.map(size => {
                const exists = bienThes.some(b => b.Size === size && b.SoLuong > 0 && (!selectedColor || b.Mau === selectedColor));
                const isSelected = selectedSize === size ? 'selected' : '';
                const isDisabled = !exists ? 'disabled' : '';
                return `<button type="button" class="product-detail-btn-option ${isSelected} ${isDisabled}" data-size="${size}" ${isDisabled}>${size}</button>`;
            }).join(''));

            // PATTERN
            $('#patternOptions').html(allPatterns.map(p => {
                const exists = bienThes.some(b => b.HoaTiet === p && b.SoLuong > 0 && (!selectedColor || b.Mau === selectedColor) && (!selectedSize || b.Size === selectedSize));
                const isSelected = selectedPattern === p ? 'selected' : '';
                const isDisabled = !exists ? 'disabled' : '';
                return `<button type="button" class="product-detail-btn-option ${isSelected} ${isDisabled}" data-pattern="${p}" ${isDisabled}>${p}</button>`;
            }).join(''));
        }

        function updatePriceAndQty() {
            const isFullySelected = selectedSize && selectedColor && selectedPattern;
            const addCartBtn = $('.product-detail-addcart');

            if (!isFullySelected) {
                $('#giaBan').text('---');
                $('#giaGoc').text('');
                $('#phanTramGiam').addClass('d-none').text('');
                $('#soLuong').attr('max', 1); // Reset max
                addCartBtn.prop('disabled', true).css('opacity', '0.5');
                return;
            }

            const bienThe = bienThes.find(b =>
                String(b.Size).trim().toLowerCase() === String(selectedSize).trim().toLowerCase() &&
                String(b.Mau).trim().toLowerCase() === String(selectedColor).trim().toLowerCase() &&
                String(b.HoaTiet).trim().toLowerCase() === String(selectedPattern).trim().toLowerCase()
            );

            if (bienThe) {
                const giaGoc = Number(bienThe.GiaGoc || 0);
                const giaSauGiam = Number(bienThe.GiaSauGiam || giaGoc);
                $('#giaBan').text(giaSauGiam.toLocaleString('vi-VN') + 'đ');

                if (giaGoc > giaSauGiam) {
                    const phanTramGiam = Math.round((1 - giaSauGiam / giaGoc) * 100);
                    $('#giaGoc').text(giaGoc.toLocaleString('vi-VN') + 'đ');
                    $('#phanTramGiam').removeClass('d-none').text('-' + phanTramGiam + '%');
                } else {
                    $('#giaGoc').text('');
                    $('#phanTramGiam').addClass('d-none').text('');
                }

                // CRITICAL: Update the max attribute so the buttons and keyboard logic know the limit
                $('#soLuong').attr('max', bienThe.SoLuong); 
                
                // If current quantity is higher than new stock, bring it down
                if (parseInt($('#soLuong').val()) > bienThe.SoLuong) {
                    $('#soLuong').val(bienThe.SoLuong > 0 ? bienThe.SoLuong : 1);
                }

                addCartBtn.prop('disabled', bienThe.SoLuong <= 0).css('opacity', '1');
                updateStockInfo(bienThe.SoLuong);
                updateImageByVariant(bienThe);
            }
        }

        function updateStockInfo(stock) {
            let html = '';
            if (stock <= 0) html = `<span class="text-danger fw-bold">${lang == "vi" ? 'Hết hàng' : 'Out of Stock'}</span>`;
            else if (stock <= 5) html = `<span class="text-warning fw-bold">${lang == "vi" ? 'Chỉ còn ' + stock : 'Only ' + stock + ' left'}</span>`;
            else html = `<span class="text-success fw-bold">${lang == "vi" ? 'Còn ' + stock + ' hàng' : stock + ' available'}</span>`;
            $('#stockInfo').html(html);
        }
        function updateImageByVariant(bienThe) {
            if (!bienThe) return;

            let variantImages = [];

            if (bienThe.DanhSachAnh && bienThe.DanhSachAnh.length > 0) {
                variantImages = bienThe.DanhSachAnh;
            } else if (bienThe.AnhDaiDien) {
                variantImages = [bienThe.AnhDaiDien];
            }

            let allProductImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachAnh));

            images = [
                ...variantImages,
                ...allProductImages
            ].filter((x, i, arr) => x && x.trim() !== "" && arr.indexOf(x) === i);

            if (images.length === 0) {
                images = ["/img/default-product.jpg"];
            }

            stopAutoCycle();

            totalImages = images.length;
            currentIndex = 0;

            $('#imageSlider').html(images.map(img => `
                <div style="min-width:100%;height:100%;flex-shrink:0;">
                    <img src="${img}"
                         class="product-detail-img-main"
                         style="width:100%;height:100%;object-fit:contain;" />
                </div>
            `).join('')).css('transform', 'translateX(0%)');

            $('.thumbnail-list').html(images.map((img, index) => `
                <img src="${img}"
                     class="thumb-item ${index === 0 ? 'active' : ''}"
                     data-index="${index}" />
            `).join(''));

            if (totalImages > 1) {
                startAutoCycle();
            }
        }
        // --- 4. INITIALIZATION & EVENTS ---
        $(document).ready(function () {
            renderOptions();
            updatePriceAndQty();
            // ======================
            // QUANTITY CONTROL
            // ======================

            const $qtyInput = $('#soLuong');

            // Chỉ cho nhập số
            $qtyInput.on('input', function () {

                let value = $(this).val();

                // Xóa ký tự không phải số
                value = value.replace(/[^0-9]/g, '');

                let max = parseInt($(this).attr('max')) || 1;

                if (value === '') {
                    $(this).val('');
                    return;
                }

                value = parseInt(value);

                // Không nhỏ hơn 1
                if (value < 1) value = 1;

                // Không vượt tồn kho
                if (value > max) {
                    alert(`Số lượng đã vượt quá tồn kho! Hiện chỉ còn ${max} sản phẩm.`);
                    value = max;
                }

                $(this).val(value);
            });

            // Khi click ra ngoài
            $qtyInput.on('blur', function () {

                let value = parseInt($(this).val());
                let max = parseInt($(this).attr('max')) || 1;

                if (isNaN(value) || value < 1) {
                    value = 1;
                }

                if (value > max) {
                    value = max;
                }

                $(this).val(value);
            });

            // Nút +
            $('#btnPlus').on('click', function () {

                let current = parseInt($qtyInput.val()) || 1;
                let max = parseInt($qtyInput.attr('max')) || 1;

                if (current < max) {
                    $qtyInput.val(current + 1);
                }
            });

            // Nút -
            $('#btnMinus').on('click', function () {

                let current = parseInt($qtyInput.val()) || 1;

                if (current > 1) {
                    $qtyInput.val(current - 1);
                }
            });
            if (totalImages > 1) startAutoCycle();

        });

        // Event Handlers
        $(document).on('click', '.thumb-item', function () {
            moveSlider($(this).data('index'));
            stopAutoCycle();
            pauseTimeout = setTimeout(startAutoCycle, 5000);
        });
		// Handle manual typing/pasting in the quantity input
		
		$(document).on('click', '.product-detail-btn-option', function() {
			if ($(this).hasClass('disabled')) return;
			
			const $this = $(this);
			if ($this.data('mau')) {
				selectedColor = $this.data('mau');
			} else if ($this.data('size')) {
				selectedSize = $this.data('size');
			} else if ($this.data('pattern')) {
				selectedPattern = $this.data('pattern');
			}
			
			// RE-RENDER to update disabled states for other rows
			renderOptions(); 
			updatePriceAndQty();
		});

        // Quantity logic
        @* $('#btnMinus').click(() => { let v = parseInt($('#soLuong').val()); if(v > 1) $('#soLuong').val(v-1); });
        $('#btnPlus').click(() => { 
            let v = parseInt($('#soLuong').val()); 
            let m = parseInt($('#soLuong').attr('max')); 
            if(v < m) $('#soLuong').val(v+1); 
        }); *@

        // Final function: Add to Cart
		function themGioHang() {
            const $addCartBtn = $('.product-detail-addcart');

            if ($addCartBtn.hasClass('is-adding')) {
                return;
            }
			if (!selectedSize || !selectedColor || !selectedPattern) {
				alert('Vui lòng chọn đầy đủ!');
				return;
			}

			const bienThe = bienThes.find(b =>
				String(b.Size).trim().toLowerCase() === selectedSize.toLowerCase() &&
				String(b.Mau).trim().toLowerCase() === selectedColor.toLowerCase() &&
				String(b.HoaTiet).trim().toLowerCase() === selectedPattern.toLowerCase()
			);
			if (!bienThe) {
				alert('Vui lòng chọn đúng biến thể!');
				return;
			}

			if (bienThe.SoLuong <= 0) {
				alert('Sản phẩm đã hết hàng!');
				return;
			}

			const soLuong = parseInt($('#soLuong').val());
			if (soLuong <= 0) {
				alert('Số lượng phải lớn hơn 0!');
				return;
			}

			if (soLuong > bienThe.SoLuong) {
				alert(`Số lượng vượt quá tồn kho! Hiện có: ${bienThe.SoLuong}`);
				return;
			}

			function decodeHtmlEntities(text) {
				const textarea = document.createElement('textarea');
				textarea.innerHTML = text;
				return textarea.value;
			}

            const originalButtonHtml = $addCartBtn.html();
            $addCartBtn
                .addClass('is-adding')
                .prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Dang them...');

			$.post('/GioHang/Add', {
				idsp: bienThe.IDSanPhamChiTiet,
				soluong: soLuong
			}, function (res) {
				try { if (typeof res === 'string') res = JSON.parse(res); } catch (e) { }
                    if (res && res.success === true) {

                        const activeImage = document.querySelector('.thumb-item.active') || document.querySelector('.product-detail-img-main');
                        if (window.animateAddToCart) {
                            window.animateAddToCart(activeImage);
                        }

                        if (window.loadCartCount) {
                            window.loadCartCount();
                        }

                        if (window.toastr) {
                            toastr.success('Sản phẩm đã được thêm vào giỏ hàng!', 'Thành công');
                        } else {
                            alert('Sản phẩm đã được thêm vào giỏ hàng!');
                        }
                    } else {
					const msg = (res && res.message ? String(res.message) : '').toLowerCase();
					if (msg.includes('vượt quá tồn kho') || msg.includes('tối đa')) {
						alert('Bạn đã đạt số lượng tối đa cho sản phẩm này trong giỏ hàng!');
					} else {
						alert('Thêm vào giỏ hàng thất bại!');
					}
				}
			}).fail(function () {
				alert('Bạn đã đạt số lượng tối đa cho sản phẩm này trong giỏ hàng!');
			}).always(function () {
                $addCartBtn
                    .removeClass('is-adding')
                    .prop('disabled', false)
                    .html(originalButtonHtml);
            });
		}
    </script>
}
