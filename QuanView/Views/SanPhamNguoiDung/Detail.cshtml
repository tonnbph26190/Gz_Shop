@model QuanApi.Dtos.SanPhamKhachHangViewModel
@{
    var lang = Context.Request.Cookies["UserLanguage"] ?? "vi"; 
    ViewData["Title"] = ((lang == "vi") ? "Chi tiết sản phẩm" : "Product Details");
    var userId = ViewBag.UserId ?? ""; // Lấy từ ViewBag, nếu chưa có thì để rỗng
}
<style>
    .thumbnail-list {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 5px;
    }

    .thumb-item {
        width: 70px;
        height: 70px;
        object-fit: cover;
        cursor: pointer;
        border: 2px solid transparent;
        transition: all 0.2s;
        flex-shrink: 0;
    }

		.thumb-item:hover {
			border: 2px solid #d32f2f;
		}

		.thumb-item.active {
			border: 2px solid #d32f2f;
			transform: scale(1.05);
		}
    .product-detail-container {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        padding: 32px 24px;
        margin-top: 24px;
    }

    .product-detail-btn-option.disabled {
        background: #f1f1f1;
        color: #999;
        border: 1px solid #ddd;
        cursor: not-allowed;
        opacity: 0.6;
    }
    .product-detail-img-main {
        width: 100%;
        max-width: 400px;
        border-radius: 8px;
        object-fit: cover;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .product-detail-title {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .product-detail-price {
        font-size: 2rem;
        color: #d32f2f;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .product-detail-oldprice {
        text-decoration: line-through;
        color: #888;
        font-size: 1.2rem;
        margin-left: 12px;
    }

    .product-detail-btn-group label {
        margin-right: 8px;
        font-weight: 500;
    }

    .product-detail-btn-option {
        display: inline-block;
        margin: 0 6px 6px 0;
        padding: 8px 18px;
        border: 1.5px solid #ddd;
        border-radius: 6px;
        background: #fff;
        cursor: pointer;
        font-size: 1rem;
        transition: border 0.2s, color 0.2s;
    }

        .product-detail-btn-option.selected, .product-detail-btn-option:active {
            border: 2px solid #d32f2f;
            color: #d32f2f;
            font-weight: bold;
            background: #fff0f0;
        }

    .product-detail-qty {
		margin-bottom: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .product-detail-qty-btn {
        width: 36px;
        height: 36px;
        border: 1.5px solid #ddd;
        background: #fafafa;
        font-size: 1.3rem;
        border-radius: 6px;
        cursor: pointer;
        transition: border 0.2s;
    }

        .product-detail-qty-btn:active {
            border: 2px solid #d32f2f;
        }

    .product-detail-addcart {
        width: 100%;
        padding: 14px 0;
        font-size: 1.2rem;
        font-weight: bold;
        background: #d32f2f;
        color: #fff;
        border: none;
        border-radius: 8px;
        margin-top: 18px;
        transition: background 0.2s;
    }

        .product-detail-addcart:hover {
            background: #b71c1c;
        }

    media (max-width: 900px) {
        .product-detail-container {
			padding: 12px 2vw;
		}

		.product-detail-title {
			font-size: 1.3rem;
		}

		.product-detail-price {
			font-size: 1.3rem;
		}

    }

    .back-to-index-btn {
        display: inline-block;
        margin-bottom: 18px;
        padding: 8px 22px;
        background: #f5f5f5;
        color: #333;
        border: 1.5px solid #bbb;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, color 0.2s, border 0.2s;
    }

        .back-to-index-btn:hover {
            background: #d32f2f;
            color: #fff;
            border: 1.5px solid #d32f2f;
        }

	#soLuong::-webkit-outer-spin-button,
	#soLuong::-webkit-inner-spin-button {
	-webkit-appearance: none;
	margin: 0;
	}

	/* Firefox */
	#soLuong[type=number] {
	-moz-appearance: textfield;
	}

	.product-info-row {
        display: flex;
        align-items: center;
        margin-bottom: 16px;
    }

    .product-info-label {
        width: 110px;
        font-weight: 600;
        flex-shrink: 0;
        color: #333;
    }

    .product-info-content {
        flex-grow: 1;
    }

	.stock-status-container {
        padding: 4px 0;
        min-height: 24px;
    }
</style>
	<a href="/SanPhamNguoiDung/Index" class="back-to-index-btn m-2"><i class="fa fa-arrow-left"></i> @((lang == "vi") ? "Quay lại" : "Back")</a>
<div class="container product-detail-container">
    <div class="row">
		<div class="col-md-5 d-flex flex-column align-items-center">
			@if (Model.DanhSachAnh != null && Model.DanhSachAnh.Any())
			{
				<div class="carousel-viewport" style="width: 100%; overflow: hidden; position: relative; border-radius: 8px;">
					<div id="imageSlider" class="d-flex" style="transition: transform 0.5s ease-in-out; width: 100%;">
						@foreach (var img in Model.DanhSachAnh)
						{
							<img src="@img" class="product-detail-img-main" style="min-width: 100%; flex-shrink: 0; object-fit: contain;" />
						}
					</div>
				</div>

				<div class="d-flex flex-row mt-3 thumbnail-list justify-content-start w-100" style="overflow-x: auto; white-space: nowrap; padding-bottom: 10px;">
					@for (int i = 0; i < Model.DanhSachAnh.Count; i++)
					{
						<img src="@Model.DanhSachAnh[i]"
							class="img-thumbnail thumb-item @(i == 0 ? "active" : "")"
							data-index="@i" 
							style="width: 70px; height: 70px; margin-right: 8px; flex: 0 0 auto;"/>
					}
				</div>
			}
		</div>
		<div class="col-md-7">
			<div class="product-detail-title fs-1">@Model.TenSanPham</div>
			<div class="mb-2 text-muted">@Model.DanhMuc</div>
			
			<div class="mb-3">
				<span class="product-detail-price" id="giaBan"></span>
				<span class="product-detail-oldprice" id="giaGoc"></span>
			</div>

<div class="product-variant-selectors">
                
                <div class="product-info-row">
                    <div class="product-info-label">
                        @((lang == "vi") ? "Màu sắc:" : "Color:")
                    </div>
                    <div class="product-info-content">
                        <div id="colorOptions"></div>
                    </div>
                </div>

                <div class="product-info-row">
                    <div class="product-info-label">
                        @((lang == "vi") ? "Size:" : "Size:")
                    </div>
                    <div class="product-info-content">
                        <div id="sizeOptions"></div>
                    </div>
                </div>

                <div class="product-info-row">
                    <div class="product-info-label">
                        @((lang == "vi") ? "Họa tiết:" : "Pattern:")
                    </div>
                    <div class="product-info-content">
                        <div id="patternOptions"></div>
                    </div>
                </div>

                <div class="product-info-row">
                    <div class="product-info-label">
                        @((lang == "vi") ? "Số lượng:" : "Quantity:")
                    </div>
                    <div class="product-info-content">
                        <div class="product-detail-qty">
                            <button type="button" class="product-detail-qty-btn" id="btnMinus">-</button>
                            <input type="number" id="soLuong" class="form-control mx-1" 
                                   style="width: 70px; text-align: center; border-radius: 6px;" 
                                   min="1" value="1">
                            <button type="button" class="product-detail-qty-btn" id="btnPlus">+</button>
                        </div>
                    </div>
                </div>

                <div class="stock-status-container mt-2">
                    <div id="stockInfo">
                        <span class="text-muted small">
                            @((lang == "vi") ? "Chọn size và màu để xem thông tin tồn kho" : "Select size and color to view stock information")
                        </span>
                    </div>
                </div>
            </div>

			<button class="btn btn-primary product-detail-addcart w-100 mt-3" onclick="themGioHang()">
				<i class="fas fa-shopping-cart mr-2"></i>
				@((lang == "vi") ? "Thêm vào giỏ hàng" : "Add to Cart")
			</button>
		</div>
    </div>
</div>

@section Scripts {
    <script>
        // --- 1. GLOBAL VARIABLES & STATE ---
        let lang = "@lang";
        let bienThes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BienThes));
        let images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachAnh));
        
        let selectedSize = '';
        let selectedColor = '';
        let selectedPattern = '';

        // Carousel State
        let currentIndex = 0;
        let totalImages = images ? images.length : 0;
        let autoCycleTimer;
        let pauseTimeout;

        // --- 2. CAROUSEL LOGIC ---
        function moveSlider(index) {
            if (totalImages <= 0) return;
            if (index >= totalImages) index = 0;
            if (index < 0) index = totalImages - 1;

            currentIndex = index;
            const offset = -currentIndex * 100;
            $('#imageSlider').css('transform', `translateX(${offset}%)`);

            // Update Thumbnail UI
            $('.thumb-item').removeClass('active');
            $(`.thumb-item[data-index="${currentIndex}"]`).addClass('active');
        }

        function startAutoCycle() {
            stopAutoCycle();
            if (totalImages > 1) {
                autoCycleTimer = setInterval(() => moveSlider(currentIndex + 1), 5000);
            }
        }

        function stopAutoCycle() {
            clearInterval(autoCycleTimer);
            clearTimeout(pauseTimeout);
        }

        // --- 3. PRODUCT VARIANT LOGIC ---
		function renderOptions() {
			const allColors = [...new Set(bienThes.map(b => b.Mau))];
			const allSizes = [...new Set(bienThes.map(b => b.Size))];
			const allPatterns = [...new Set(bienThes.map(b => b.HoaTiet))];

			// COLOR: Always enabled if it exists in stock at all
			$('#colorOptions').html(allColors.map(mau => {
				const hasStock = bienThes.some(b => b.Mau === mau && b.SoLuong > 0);
				const isSelected = selectedColor === mau ? 'selected' : '';
				const isDisabled = !hasStock ? 'disabled' : '';
				return `<button type="button" class="product-detail-btn-option ${isSelected} ${isDisabled}" data-mau="${mau}" ${isDisabled}>${mau}</button>`;
			}).join(''));

			// SIZE: Enabled only if it exists for the selected Color (if Color is picked)
			$('#sizeOptions').html(allSizes.map(size => {
				const exists = bienThes.some(b => 
					b.Size === size && b.SoLuong > 0 && 
					(!selectedColor || b.Mau === selectedColor)
				);
				const isSelected = selectedSize === size ? 'selected' : '';
				const isDisabled = !exists ? 'disabled' : '';
				return `<button type="button" class="product-detail-btn-option ${isSelected} ${isDisabled}" data-size="${size}" ${isDisabled}>${size}</button>`;
			}).join(''));

			// PATTERN: Enabled only if it matches selected Color AND Size
			$('#patternOptions').html(allPatterns.map(p => {
				const exists = bienThes.some(b => 
					b.HoaTiet === p && b.SoLuong > 0 &&
					(!selectedColor || b.Mau === selectedColor) &&
					(!selectedSize || b.Size === selectedSize)
				);
				const isSelected = selectedPattern === p ? 'selected' : '';
				const isDisabled = !exists ? 'disabled' : '';
				return `<button type="button" class="product-detail-btn-option ${isSelected} ${isDisabled}" data-pattern="${p}" ${isDisabled}>${p}</button>`;
			}).join(''));
		}

		function updatePriceAndQty() {
			// Check if user has made all selections
			const isFullySelected = selectedSize && selectedColor && selectedPattern;
			const addCartBtn = $('.product-detail-addcart');

			if (!isFullySelected) {
				// Reset price display or show a range/default
				$('#giaBan').text('---');
				$('#giaGoc').text('');
				$('#stockInfo').html(`<span class="text-muted small">${lang == "vi" ? 'Vui lòng chọn đầy đủ các tùy chọn' : 'Please select all options'}</span>`);
				
				// Disable Add to Cart
				addCartBtn.prop('disabled', true).css('background', '#999'); 
				return;
			}

			const bienThe = bienThes.find(b =>
				String(b.Size).trim().toLowerCase() === String(selectedSize).trim().toLowerCase() &&
				String(b.Mau).trim().toLowerCase() === String(selectedColor).trim().toLowerCase() &&
				String(b.HoaTiet).trim().toLowerCase() === String(selectedPattern).trim().toLowerCase()
			);

			if (bienThe) {
				$('#giaBan').text(Number(bienThe.GiaSauGiam).toLocaleString() + ' VND');
				$('#giaGoc').text(bienThe.GiaSauGiam < bienThe.GiaGoc ? Number(bienThe.GiaGoc).toLocaleString() + ' VND' : '');
				$('#soLuong').attr('max', bienThe.SoLuong);

				if (bienThe.SoLuong <= 0) {
					addCartBtn.text(lang === "vi" ? 'Hết hàng' : 'Out of Stock').prop('disabled', true).css('background', '#6c757d');
				} else {
					addCartBtn.text(lang === "vi" ? 'Thêm vào giỏ hàng' : 'Add to Cart').prop('disabled', false).css('background', '#d32f2f');
				}
				updateStockInfo(bienThe.SoLuong);
			}
		}

        function updateStockInfo(stock) {
            let html = '';
            if (stock <= 0) html = `<span class="text-danger fw-bold">${lang == "vi" ? 'Hết hàng' : 'Out of Stock'}</span>`;
            else if (stock <= 5) html = `<span class="text-warning fw-bold">${lang == "vi" ? 'Chỉ còn ' + stock : 'Only ' + stock + ' left'}</span>`;
            else html = `<span class="text-success fw-bold">${lang == "vi" ? 'Còn ' + stock + ' hàng' : stock + ' available'}</span>`;
            $('#stockInfo').html(html);
        }

        // --- 4. INITIALIZATION & EVENTS ---
		$(document).ready(function () {
			// REMOVE the "Auto-select first available variant" block entirely
			renderOptions();
			updatePriceAndQty(); // This will now handle the empty state
			
			if (totalImages > 1) startAutoCycle();
		});

        // Event Handlers
        $(document).on('click', '.thumb-item', function () {
            moveSlider($(this).data('index'));
            stopAutoCycle();
            pauseTimeout = setTimeout(startAutoCycle, 5000);
        });
		// Handle manual typing/pasting in the quantity input
		$(document).on('input change', '#soLuong', function () {
			let val = parseInt($(this).val());
			let max = parseInt($(this).attr('max')) || 1;

			if (isNaN(val) || val < 1) {
				$(this).val(1);
			} else if (val > max) {
				$(this).val(max);
			}
		});
		$(document).on('click', '.product-detail-btn-option', function() {
			if ($(this).hasClass('disabled')) return;
			
			const $this = $(this);
			if ($this.data('mau')) {
				selectedColor = $this.data('mau');
			} else if ($this.data('size')) {
				selectedSize = $this.data('size');
			} else if ($this.data('pattern')) {
				selectedPattern = $this.data('pattern');
			}
			
			// RE-RENDER to update disabled states for other rows
			renderOptions(); 
			updatePriceAndQty();
		});

        // Quantity logic
        $('#btnMinus').click(() => { let v = parseInt($('#soLuong').val()); if(v > 1) $('#soLuong').val(v-1); });
        $('#btnPlus').click(() => { 
            let v = parseInt($('#soLuong').val()); 
            let m = parseInt($('#soLuong').attr('max')); 
            if(v < m) $('#soLuong').val(v+1); 
        });

        // Final function: Add to Cart
		function themGioHang() {
			if (!selectedSize || !selectedColor || !selectedPattern) {
				alert('Vui lòng chọn đầy đủ!');
				return;
			}

			const bienThe = bienThes.find(b =>
				String(b.Size).trim().toLowerCase() === selectedSize.toLowerCase() &&
				String(b.Mau).trim().toLowerCase() === selectedColor.toLowerCase() &&
				String(b.HoaTiet).trim().toLowerCase() === selectedPattern.toLowerCase()
			);
			if (!bienThe) {
				alert('Vui lòng chọn đúng biến thể!');
				return;
			}

			if (bienThe.SoLuong <= 0) {
				alert('Sản phẩm đã hết hàng!');
				return;
			}

			const soLuong = parseInt($('#soLuong').val());
			if (soLuong <= 0) {
				alert('Số lượng phải lớn hơn 0!');
				return;
			}

			if (soLuong > bienThe.SoLuong) {
				alert(`Số lượng vượt quá tồn kho! Hiện có: ${bienThe.SoLuong}`);
				return;
			}

			function decodeHtmlEntities(text) {
				const textarea = document.createElement('textarea');
				textarea.innerHTML = text;
				return textarea.value;
			}

			const tenSanPham = decodeHtmlEntities('@Model.TenSanPham');
			const confirmMessage = `Bạn có chắc muốn thêm "${tenSanPham}" (${selectedColor}, ${selectedSize}) x${soLuong} vào giỏ hàng không?`;

			if (!confirm(confirmMessage)) {
				return;
			}

			$.post('/GioHang/Add', {
				idsp: bienThe.IDSanPhamChiTiet,
				soluong: soLuong
			}, function (res) {
				try { if (typeof res === 'string') res = JSON.parse(res); } catch (e) { }
				if (res && res.success === true) {
					alert('Sản phẩm đã được thêm vào giỏ hàng!');
				} else {
					const msg = (res && res.message ? String(res.message) : '').toLowerCase();
					if (msg.includes('vượt quá tồn kho') || msg.includes('tối đa')) {
						alert('Bạn đã đạt số lượng tối đa cho sản phẩm này trong giỏ hàng!');
					} else {
						alert('Thêm vào giỏ hàng thất bại!');
					}
				}
			}).fail(function () {
				alert('Bạn đã đạt số lượng tối đa cho sản phẩm này trong giỏ hàng!');
			});
		}
    </script>
}