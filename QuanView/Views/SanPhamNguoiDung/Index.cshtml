@model List<QuanApi.Dtos.SanPhamKhachHangViewModel>
@{
    ViewData["Title"] = "Sản phẩm";
    var page = ViewBag.Page ?? 1;
    var pageSize = ViewBag.PageSize ?? 9;
    var total = ViewBag.Total ?? 0;
    var priceFrom = Context.Request.Query["priceFrom"].ToString();
    var priceTo = Context.Request.Query["priceTo"].ToString();
    var category = Context.Request.Query["category"].ToString();
    var size = Context.Request.Query["size"].ToString();
    var color = Context.Request.Query["color"].ToString();
    var sortOrder = Context.Request.Query["sortOrder"].ToString();
    var stockFilter = Context.Request.Query["stockFilter"].ToString();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    :root {
        --primary-red: #e74c3c;
        --dark-gray: #2d3436;
    }

    body { background-color: #fcfcfc; }

    /* Product Card Enhancements */
    .product-card {
        border-radius: 12px;
        border: 1px solid #f0f0f0;
        background: #fff;
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        cursor: pointer;
    }

    .product-card:hover {
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
        transform: translateY(-4px);
        border-color: var(--primary-red);
    }

    .product-img-container {
        position: relative;
        overflow: hidden;
        aspect-ratio: 1/1;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    .product-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--dark-gray);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.8rem;
        line-height: 1.4;
    }

    /* Price Styling */
    .product-price {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--primary-red);
    }

    .product-oldprice {
        text-decoration: line-through;
        color: #adb5bd;
        font-size: 0.85rem;
    }

    /* Sidebar & Filters */
    .sidebar-section {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        border: 1px solid #eee;
        position: sticky;
        top: 20px;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        color: #636e72;
    }

    /* Pagination */
    .pagination .page-link {
        border: none;
        margin: 0 4px;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px !important;
        font-weight: 600;
    }

    .pagination .active .page-link {
        background: var(--primary-red);
        box-shadow: 0 4px 10px rgba(231, 76, 60, 0.3);
    }
</style>

<div class="container py-5">
    <div class="row">
        <div class="col-lg-3">
            <div class="sidebar-section shadow-sm">
                <button class="btn btn-dark w-100 d-lg-none mb-3" type="button" data-bs-toggle="collapse" data-bs-target="#filterContent">
                    <i class="bi bi-filter"></i> Bộ lọc
                </button>

                <div class="collapse d-lg-block" id="filterContent">
                    <h5 class="fw-bold mb-4 d-none d-lg-block">
                        <i class="bi bi-funnel me-2"></i>Bộ lọc
                    </h5>
                    
                    <form method="get" asp-action="Index">
                        <div class="mb-4">
                            <label class="form-label">Tìm kiếm</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search"></i></span>
                                <input type="text" class="form-control bg-light border-start-0" name="search" placeholder="Tên sản phẩm..." value="@Context.Request.Query["search"]" />
                            </div>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <label class="form-label">Giá từ</label>
                                <input type="number" class="form-control" name="priceFrom" placeholder="0đ" value="@priceFrom">
                            </div>
                            <div class="col-6">
                                <label class="form-label">Đến</label>
                                <input type="number" class="form-control" name="priceTo" placeholder="Đến..." value="@priceTo">
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Kích cỡ</label>
                            <select class="form-select border-0 bg-light" name="size">
                                <option value="">Mọi kích cỡ</option>
                                @foreach (var s in ViewBag.Sizes as List<string> ?? new List<string>())
                                {
                                    <option value="@s" @(size == s ? "selected" : "")>@s</option>
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Màu sắc</label>
                            <select class="form-select border-0 bg-light" name="color">
                                <option value="">Mọi màu sắc</option>
                                @foreach (var c in ViewBag.Colors as List<string> ?? new List<string>())
                                {
                                    <option value="@c" @(color == c ? "selected" : "")>@c</option>
                                }
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill shadow-sm py-2">
                            Áp dụng lọc
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="bg-white p-3 rounded-4 shadow-sm mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <span class="text-muted">Tìm thấy <b class="text-dark">@total</b> sản phẩm</span>
                
                <form method="get" class="d-flex gap-2 mb-0" id="sortForm">
                    <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
                    <input type="hidden" name="priceFrom" value="@priceFrom" />
                    <input type="hidden" name="priceTo" value="@priceTo" />
                    <input type="hidden" name="category" value="@category" />
                    <input type="hidden" name="size" value="@size" />
                    <input type="hidden" name="color" value="@color" />

                    <select class="form-select form-select-sm w-auto rounded-3" name="stockFilter" onchange="this.form.submit()">
                        <option value="" @(stockFilter == "" ? "selected" : "")>Tình trạng</option>
                        <option value="inStock" @(stockFilter == "inStock" ? "selected" : "")>Còn hàng</option>
                        <option value="outStock" @(stockFilter == "outStock" ? "selected" : "")>Hết hàng</option>
                    </select>

                    <select class="form-select form-select-sm w-auto rounded-3" name="sortOrder" onchange="this.form.submit()">
                        <option value="" @(sortOrder == "" ? "selected" : "")>Sắp xếp</option>
                        <option value="asc" @(sortOrder == "asc" ? "selected" : "")>Giá thấp → Cao</option>
                        <option value="desc" @(sortOrder == "desc" ? "selected" : "")>Giá cao → Thấp</option>
                    </select>
                </form>
            </div>

            <div class="row g-4">
                @foreach (var sp in Model)
                {
                    var minBienThe = sp.BienThes?.OrderBy(b => b.GiaSauGiam > 0 ? b.GiaSauGiam : b.GiaGoc).FirstOrDefault();
                    var giaGoc = minBienThe?.GiaGoc ?? 0;
                    var giaSauGiam = minBienThe?.GiaSauGiam ?? 0;
                    var totalStock = sp.BienThes?.Sum(b => b.SoLuong) ?? 0;
                    var detailUrl = (sp.BienThes != null && sp.BienThes.Any()) 
                                    ? $"/SanPhamNguoiDung/Detail/{sp.BienThes.First().IDSanPhamChiTiet}" 
                                    : "#";

                    <div class="col-6 col-md-4">
                        <div class="product-card h-100 d-flex flex-column" onclick="location.href='@detailUrl'">
                            <div class="product-img-container">
                                <img src="@sp.UrlAnh" class="product-img" alt="@sp.TenSanPham" loading="lazy" />
                                @if (giaGoc > 0 && giaSauGiam > 0 && giaSauGiam < giaGoc)
                                {
                                    var discountPercent = Math.Round((double)(giaGoc - giaSauGiam) / (double)giaGoc * 100);
                                    
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 shadow-sm">
                                        -@discountPercent%
                                    </span>
                                }
                            </div>

                            <div class="p-3 flex-grow-1 d-flex flex-column">
                                <small class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">@sp.DanhMuc</small>
                                <div class="product-title mb-2">@sp.TenSanPham</div>
                                
                                <div class="mt-auto">
                                    <div class="d-flex align-items-center mb-2">
                                        @if (giaSauGiam > 0 && giaSauGiam < giaGoc)
                                        {
                                            <span class="product-price me-2">@giaSauGiam.ToString("N0")₫</span>
                                            <span class="product-oldprice">@giaGoc.ToString("N0")₫</span>
                                        }
                                        else
                                        {
                                            <span class="product-price">@giaGoc.ToString("N0")₫</span>
                                        }
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        @{
                                            var stockColor = totalStock > 10 ? "text-success" : totalStock > 0 ? "text-warning" : "text-danger";
                                        }
                                        <small class="@stockColor fw-semibold" style="font-size: 0.8rem;">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                                            @(totalStock > 0 ? $"Còn {totalStock}" : "Hết hàng")
                                        </small>
                                        
                                        <button class="btn btn-sm btn-light rounded-circle @(totalStock == 0 ? "disabled" : "")">
                                            <i class="bi bi-cart-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (total > pageSize)
            {
                <nav class="mt-5">
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= Math.Ceiling((double)total / pageSize); i++)
                        {
                            <li class="page-item @(i == (int)page ? "active" : "")">
                                <a class="page-link shadow-sm" href="?page=@i&search=@Context.Request.Query["search"]&priceFrom=@priceFrom&priceTo=@priceTo&category=@category&size=@size&color=@color&sortOrder=@sortOrder&stockFilter=@stockFilter">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>