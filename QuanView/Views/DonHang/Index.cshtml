@model dynamic
@using QuanApi.Data
@{
    var lang = Context.Request.Cookies["UserLanguage"] ?? "vi";
    ViewData["Title"] = ((lang == "vi") ? "ĐƠN MUA CỦA TÔI" : "MY ORDERS");
    var label = (lang == "vi") ? "Tìm kiếm đơn hàng" : "Search Order";
    var placeholder = (lang == "vi") ? "Nhập mã đơn hàng (tùy chọn)" : "Enter order ID (optional)";
    var titleMsg = (lang == "vi") ? "Mã đơn hàng chỉ chứa chữ hoa, số và dấu gạch dưới" : "Order ID only contains uppercase letters, numbers and underscores";
    var search = ViewBag.Search as string ?? "";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
    var quickDate = ViewBag.QuickDate as string ?? "";
    var trangThai = ViewBag.TrangThai as string ?? "";
    var isAuthenticated = ViewBag.IsAuthenticated as bool? ?? false;
}

<style>
    :root {
        --primary-blue: #007bff;
        --border-light: #f0f0f0;
    }

    .order-container {
        max-width: 1100px;
        margin: auto;
    }

    /* Professional Filter Section */
    .filter-card {
        background: #fff;
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.03);
        margin-bottom: 25px;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #555;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-control {
        border-radius: 8px;
        padding: 10px 15px;
        border: 1px solid #ced4da !important; 
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-control:focus {   
        border-color: var(--primary-blue) !important;
        box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.15); 
        outline: none;
    }

    /* Modern Order Table */
    .order-table-wrapper {
        background: white;
        border-radius: 12px;
        border: 1px solid var(--border-light);
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .table thead th {
        background: #fafafa;
        color: #888;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 15px 20px;
        border-bottom: 1px solid var(--border-light);
    }

    .table tbody td {
        padding: 18px 20px;
        vertical-align: middle;
        font-size: 0.95rem;
        border-bottom: 1px solid #f8f8f8;
    }

    /* Refined Status Badges */
    .status-badge {
        padding: 6px 14px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }

    .status-cho-confirm { background: #fff8e1; color: #f57c00; } /* Pending */
    .status-shipping { background: #e3f2fd; color: #1976d2; }    /* Delivering */
    .status-success { background: #e8f5e9; color: #2e7d32; }     /* Success */
    .status-cancel { background: #ffebee; color: #c62828; }      /* Cancelled */
    .status-transfer-pending { background: #d4f2dd; color: #0f5132; }
    .highlight-transfer-pending td { background: #e8f8ee !important; }
    .highlight-store-ship-paid td { background: #fff9e6 !important; }
    
    /* Buttons */
    .action-btn {
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s;
        border: none;
    }

    .btn-view { background: #f0f0f0; color: #333; }
    .btn-view:hover { background: #e0e0e0; color: #000; }

    .btn-cancel { background: #fff1f1; color: #d32f2f; }
    .btn-cancel:hover { background: #d32f2f; color: #fff; }

    .btn-search {
        background: #111;
        color: #fff;
        border-radius: 8px;
        padding: 10px 25px;
        font-weight: 600;
    }

    .btn-search:hover { background: #333; color: #fff; }

    .btn-point-history {
        border-radius: 8px;
        font-weight: 600;
        white-space: nowrap;
    }

    .point-summary-card {
        background: #f8f9ff;
        border: 1px solid #eef0ff;
        border-radius: 10px;
        padding: 14px 16px;
    }

    .point-history-table th,
    .point-history-table td {
        white-space: nowrap;
    }

    /* Pagination */
    .pagination .page-link {
        border: none;
        color: #111;
        margin: 0 3px;
        border-radius: 6px;
        font-weight: 600;
    }

    .pagination .page-item.active .page-link {
        background: #111;
        border-color: #111;
    }

    #search-icon {
        border: 1px solid #6c757d !important; 
    }
    #search-icon:hover {
        background-color: #6c757d !important; 
    }
</style>

<div class="container order-container py-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="fw-bold m-0">@((lang == "vi") ? "ĐƠN MUA CỦA TÔI" : "MY ORDERS")</h2>
        <i class="bi bi-bag-check text-muted h3 m-0"></i>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning" role="alert">@TempData["ErrorMessage"]</div>
    }

    <div class="filter-card">
        @if (isAuthenticated)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
                <div class="d-flex align-items-center text-success">
                    <i class="bi bi-patch-check-fill me-2"></i>
                    <span class="small fw-bold">Verified Account: @User.Identity.Name</span>
                </div>
                <button type="button" class="btn btn-outline-primary btn-sm btn-point-history" id="openPointHistoryBtn">
                    <i class="bi bi-coin me-1"></i>@((lang == "vi") ? "Lịch sử điểm" : "Point history")
                </button>
            </div>

            <form method="get" action="@Url.Action("Index")" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">@label</label>
                        <input type="text" class="form-control" name="search" placeholder="@placeholder" value="@search" pattern="[A-Z0-9_]+" title="@titleMsg">
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">TRẠNG THÁI</label>
                        <select class="form-control" name="trangThai">
                            <option value="" selected="@(trangThai == "")">Tất cả</option>
                            <option value="Chờ xác nhận" selected="@(trangThai == "Chờ xác nhận")">Chờ xác nhận</option>
                            <option value="DaThanhToan" selected="@(trangThai == "DaThanhToan")">Đã thanh toán</option>
                            <option value="Đã xác nhận" selected="@(trangThai == "Đã xác nhận")">Đã xác nhận</option>
                            <option value="Đang giao hàng" selected="@(trangThai == "Đang giao hàng")">Đang giao hàng</option>
                            <option value="Đã giao" selected="@(trangThai == "Đã giao")">Đã giao</option>
                            <option value="Chờ hoàn tiền" selected="@(trangThai == "Chờ hoàn tiền")">Chờ hoàn tiền</option>
                            <option value="Đã hoàn tiền" selected="@(trangThai == "Đã hoàn tiền")">Đã hoàn tiền</option>
                            <option value="Đã hủy" selected="@(trangThai == "Đã hủy")">Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@((lang == "vi") ? "Theo ngày" : "Quick date")</label>
                        @{
                            var isCustomQuickDate = quickDate == "custom"
                                                    || ((!string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate))
                                                        && quickDate != "today" && quickDate != "1" && quickDate != "7" && quickDate != "28" && quickDate != "");
                        }
                        <select class="form-control" id="quickDate" name="quickDate">
                            <option value="today" selected="@(quickDate == "today" ? "selected" : null)">@((lang == "vi") ? "Hôm nay" : "Today")</option>
                            <option value="1" selected="@(quickDate == "1" ? "selected" : null)">@((lang == "vi") ? "1 ngày trước" : "Last 1 day")</option>
                            <option value="7" selected="@(quickDate == "7" ? "selected" : null)">@((lang == "vi") ? "7 ngày trước" : "Last 7 days")</option>
                            <option value="28" selected="@(quickDate == "28" ? "selected" : null)">@((lang == "vi") ? "28 ngày trước" : "Last 28 days")</option>
                            <option value="custom" selected="@(isCustomQuickDate ? "selected" : null)">@((lang == "vi") ? "Tự chọn" : "Custom")</option>
                            <option value="" selected="@(quickDate == "" ? "selected" : null)">@((lang == "vi") ? "Tất cả" : "All")</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@((lang == "vi") ? "Từ ngày" : "From")</label>
                        <input type="date" class="form-control" id="fromDate" name="fromDate" value="@fromDate">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@((lang == "vi") ? "Đến ngày" : "To")</label>
                        <input type="date" class="form-control" id="toDate" name="toDate" value="@toDate">
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="d-flex w-100 gap-2">

                            <button type="submit"
                                    class="btn btn-outline-dark d-flex align-items-center justify-content-center"
                                    style="height:38px; width:38px;">
                                <i class="fa fa-search"></i>
                            </button>

                            <a href="@Url.Action("Index")"
                               class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                               style="height:38px; width:38px;">
                                <i class="fa fa-rotate-right"></i>
                            </a>

                        </div>
                    </div>
                </div>
            </form>
        }
        else
        {
            <div class="mb-3">
                <h6 class="fw-bold"><i class="bi bi-search me-2"></i>@((lang == "vi") ? "Tra cứu khách vãng lai" : "Guest Order Lookup")</h6>
                <p class="text-muted small">@((lang == "vi") ? "Vui lòng nhập mã đơn hàng để tìm đơn hàng của bạn" : "Enter your order ID below")</p>
            </div>

            <form method="get" action="@Url.Action("Index")" id="filterForm">
                <div class="row g-3">
                    <div class="col-md-8">
                        <input type="text" class="form-control" name="search"
                               placeholder="@((lang == "vi") ? "Nhập mã đơn hàng..." : "Enter order ID...")"
                               value="@search" pattern="[A-Z0-9_]+" required>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-search w-100">@((lang == "vi") ? "Tìm đơn hàng" : "Track Order")</button>
                    </div>
                </div>
            </form>
        }
    </div>

    <div class="order-table-wrapper">
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th class="text-center">#</th>
                        <th>@((lang == "vi") ? "Mã đơn hàng" : "Order ID")</th>
                        <th>@((lang == "vi") ? "Giá trị" : "Total")</th>
                        <th>@((lang == "vi") ? "Trạng thái" : "Status")</th>
                        <th>@((lang == "vi") ? "Loại" : "Type")</th>
                        <th>@((lang == "vi") ? "Ngày đặt" : "Date")</th>
                        <th class="text-center">@((lang == "vi") ? "Hành động" : "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var hoaDons = Model?.HoaDons as List<QuanApi.Data.HoaDon> ?? new List<QuanApi.Data.HoaDon>();
                        var pagination = Model?.Pagination;
                    }
                    @if (hoaDons.Any())
                    {
                        int stt = 1;
                        foreach (var hoaDon in hoaDons)
                        {
                            var statusClass = hoaDon.TrangThai switch {
                                "Chờ xác nhận" => "status-cho-confirm",
                                "Đã thanh toán chờ xác nhận" => "status-transfer-pending",
                                "Đang giao hàng" => "status-shipping",
                                "Giao hàng thành công" => "status-success",
                                "Chờ hoàn tiền" => "status-transfer-pending",
                                "Đã hoàn tiền" => "status-success",
                                "Đã hủy" => "status-cancel",
                                _ => "bg-light text-dark"
                            };
                            var isTransferPending = string.Equals(hoaDon.TrangThai, "Đã thanh toán chờ xác nhận", StringComparison.OrdinalIgnoreCase);
                            var isOnlinePaidTransferConfirmed = IsOnlinePaidTransferConfirmed(hoaDon);
                            var isStoreShipPaidConfirmed = IsStoreShipPaidConfirmed(hoaDon);
                            var rowClass = isTransferPending
                                ? "highlight-transfer-pending"
                                : (isStoreShipPaidConfirmed ? "highlight-store-ship-paid" : "");

                            <tr class="@rowClass">
                                <td class="text-center text-muted small">@stt</td>
                                <td><span class="fw-bold">#@hoaDon.MaHoaDon</span></td>
                                <td class="fw-bold text-dark">@hoaDon.TongTien.ToString("N0") <small>₫</small></td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        @GetTrangThaiText(hoaDon.TrangThai)
                                    </span>
                                    @if (isTransferPending)
                                    {
                                        <div><small class="text-success fw-bold">Đơn đã thanh toán chuyển khoản, chờ xác nhận.</small></div>
                                    }
                                    else if (isStoreShipPaidConfirmed)
                                    {
                                        <div>
                                            <small class="text-warning-emphasis fw-bold">
                                                @FormatPaidPaymentNote(hoaDon.PhuongThucThanhToan)
                                            </small>
                                        </div>
                                    }
                                </td>
                                <td>
                                    @if (hoaDon.BanTaiQuay) {
                                        if (!string.IsNullOrWhiteSpace(hoaDon.DiaChiGiaoHang))
                                        {
                                            <span class="small text-warning"><i class="bi bi-truck me-1"></i>Tại quầy (ship về)</span>
                                        }
                                        else
                                        {
                                            <span class="small text-muted"><i class="bi bi-shop me-1"></i>Tại quầy</span>
                                        }
                                    } else {
                                        <span class="small text-primary"><i class="bi bi-globe me-1"></i>Online</span>
                                    }
                                </td>
                                <td class="small text-muted">@hoaDon.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a href="@Url.Action("ChiTiet", new { id = hoaDon.IDHoaDon })" class="action-btn btn-view">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @* @if (hoaDon.TrangThai == "Chờ xác nhận" || hoaDon.TrangThai == "Đã xác nhận" || hoaDon.TrangThai == "Chờ lấy hàng")
                                        {
                                            <button class="action-btn btn-cancel" onclick="cancelOrder('@hoaDon.IDHoaDon')">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        } *@

                                        @if (hoaDon.TrangThai == "Đang giao hàng")
                                        {
                                            <button class="action-btn btn-view text-primary" onclick="viewShippingInfo('@hoaDon.IDHoaDon')">
                                                <i class="bi bi-truck"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="opacity-25 mb-3"><i class="bi bi-inbox h1"></i></div>
                                <p class="text-muted">@((lang == "vi") ? "Không tìm thấy dữ liệu đơn hàng" : "No orders found")</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (pagination != null && pagination.TotalCount > 0)
    {
        int currentPage = (int)pagination.CurrentPage;
        int totalPages = Math.Max(1, (int)pagination.TotalPages);
        if (currentPage < 1)
        {
            currentPage = 1;
        }
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
        int prevPage = currentPage > 1 ? currentPage - 1 : 1;
        int nextPage = currentPage < totalPages ? currentPage + 1 : totalPages;
        <div class="d-flex justify-content-between align-items-center mt-4 px-2">
            <div class="small text-muted">
                Showing @(((pagination.CurrentPage - 1) * pagination.PageSize) + 1)-@Math.Min(pagination.CurrentPage * pagination.PageSize, pagination.TotalCount) of @pagination.TotalCount
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link shadow-none" href="@Url.Action("Index", new { page = 1, search, trangThai, fromDate, toDate, quickDate })" aria-label="First">
                            <span aria-hidden="true">&laquo;&laquo;</span>
                        </a>
                    </li>
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link shadow-none" href="@Url.Action("Index", new { page = prevPage, search, trangThai, fromDate, toDate, quickDate })" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link shadow-none" href="@Url.Action("Index", new { page = i, search, trangThai, fromDate, toDate, quickDate })">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link shadow-none" href="@Url.Action("Index", new { page = nextPage, search, trangThai, fromDate, toDate, quickDate })" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link shadow-none" href="@Url.Action("Index", new { page = totalPages, search, trangThai, fromDate, toDate, quickDate })" aria-label="Last">
                            <span aria-hidden="true">&raquo;&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@if (isAuthenticated)
{
    <div class="modal fade" id="pointHistoryModal" tabindex="-1" aria-labelledby="pointHistoryModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title" id="pointHistoryModalLabel">
                        <i class="bi bi-coin me-2 text-warning"></i>@((lang == "vi") ? "Lịch sử sử dụng điểm" : "Point usage history")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="pointHistorySummary" class="point-summary-card mb-3 d-none"></div>
                    <div id="pointHistoryError" class="alert alert-warning d-none"></div>
                    <div id="pointHistoryLoading" class="text-center py-4 d-none">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle point-history-table">
                            <thead>
                                <tr>
                                    <th>@((lang == "vi") ? "Đơn hàng" : "Order")</th>
                                    <th>@((lang == "vi") ? "Thời gian mua" : "Purchase time")</th>
                                    <th class="text-end">@((lang == "vi") ? "Điểm trừ" : "Spent points")</th>
                                    <th class="text-end">@((lang == "vi") ? "Điểm cộng" : "Earned points")</th>
                                    <th class="text-end">@((lang == "vi") ? "Điểm trước GD" : "Points before")</th>
                                    <th class="text-end">@((lang == "vi") ? "Điểm sau GD" : "Points after")</th>
                                    <th>@((lang == "vi") ? "Rank" : "Rank")</th>
                                </tr>
                            </thead>
                            <tbody id="pointHistoryTableBody">
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">@((lang == "vi") ? "Bấm nút để tải lịch sử điểm" : "Click button to load point history")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* NO CHANGES TO JAVASCRIPT LOGIC - JUST MOVED SCRIPTS BELOW TO KEEP IT CLEAN *@
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.querySelector('input[name="search"]');
        const quickDateSelect = document.getElementById('quickDate');
        const fromDateInput = document.getElementById('fromDate');
        const toDateInput = document.getElementById('toDate');
        if (searchInput) {
            const form = document.getElementById('filterForm');
            form.addEventListener('submit', function (e) {
                if (searchInput.hasAttribute('required') && searchInput.value.trim() === '') {
                    e.preventDefault();
                    alert('Vui lòng nhập mã đơn hàng để tìm kiếm');
                    searchInput.focus();
                    return false;
                }
                if (searchInput.value.trim() !== '') {
                    const orderCodePattern = /^[A-Z0-9_]+$/;
                    if (!orderCodePattern.test(searchInput.value.trim())) {
                        e.preventDefault();
                        alert('Mã đơn hàng chỉ được chứa chữ hoa, số và dấu gạch dưới');
                        searchInput.focus();
                        return false;
                    }
                }
            });
        }

        function formatDate(date) {
            return date.toISOString().split('T')[0];
        }

        function setDateRange(days) {
            const today = new Date();
            const from = new Date();
            if (days === 'today') {
                // giữ nguyên today
            } else {
                from.setDate(today.getDate() - parseInt(days, 10));
            }

            fromDateInput.value = formatDate(from);
            toDateInput.value = formatDate(today);
        }

        if (quickDateSelect && fromDateInput && toDateInput) {
            // Nếu đã có khoảng ngày nhưng quickDate chưa rõ thì mặc định là custom.
            if ((fromDateInput.value || toDateInput.value) && !quickDateSelect.value) {
                quickDateSelect.value = 'custom';
            }

            quickDateSelect.addEventListener('change', function () {
                if (this.value === '') {
                    fromDateInput.value = '';
                    toDateInput.value = '';
                    return;
                }

                if (this.value === 'custom') {
                    return;
                }

                setDateRange(this.value);
                document.getElementById('filterForm')?.submit();
            });

            fromDateInput.addEventListener('change', function () {
                quickDateSelect.value = 'custom';
            });

            toDateInput.addEventListener('change', function () {
                quickDateSelect.value = 'custom';
            });
        }

        const pointHistoryBtn = document.getElementById('openPointHistoryBtn');
        const pointHistoryModalElement = document.getElementById('pointHistoryModal');
        const pointHistoryLoading = document.getElementById('pointHistoryLoading');
        const pointHistoryError = document.getElementById('pointHistoryError');
        const pointHistorySummary = document.getElementById('pointHistorySummary');
        const pointHistoryTableBody = document.getElementById('pointHistoryTableBody');

        function formatPoints(value) {
            return new Intl.NumberFormat('vi-VN').format(Number(value || 0));
        }

        function formatDateTime(value) {
            if (!value) return '';
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return value;
            return date.toLocaleString('vi-VN');
        }

        function renderPointRows(data) {
            const histories = Array.isArray(data?.lichSu) ? data.lichSu : [];
            const currentPoints = data?.khachHang?.diemHienTai ?? 0;
            const rank = data?.khachHang?.rank || 'Chưa xếp hạng';

            if (!histories.length) {
                pointHistoryTableBody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Chưa có lịch sử điểm.</td></tr>';
                return;
            }

            pointHistoryTableBody.innerHTML = histories.map(item => {
                const orderCode = item.maHoaDon ? '#' + item.maHoaDon : '-';
                const minus = Number(item.soDiemTru || 0);
                const plus = Number(item.soDiemCong || 0);
                const before = Number(item.soDiemTruocGiaoDich || 0);
                const totalAfter = Number(item.tongDiemSauGiaoDich || 0);
                return `
                    <tr>
                        <td class="fw-semibold">${orderCode}</td>
                        <td>${formatDateTime(item.thoiGianMua)}</td>
                        <td class="text-end text-danger fw-semibold">${minus > 0 ? '-' + formatPoints(minus) : '0'}</td>
                        <td class="text-end text-success fw-semibold">${plus > 0 ? '+' + formatPoints(plus) : '0'}</td>
                        <td class="text-end">${formatPoints(before)}</td>
                        <td class="text-end">${formatPoints(totalAfter)}</td>
                        <td><span class="badge bg-primary-subtle text-primary-emphasis">${rank}</span></td>
                    </tr>
                `;
            }).join('');
        }

        if (pointHistoryBtn && pointHistoryModalElement) {
            const pointHistoryModal = new bootstrap.Modal(pointHistoryModalElement);

            pointHistoryBtn.addEventListener('click', async function () {
                pointHistoryModal.show();
                pointHistoryLoading.classList.remove('d-none');
                pointHistoryError.classList.add('d-none');
                pointHistorySummary.classList.add('d-none');
                pointHistoryTableBody.innerHTML = '';

                try {
                    const response = await fetch('/DonHang/LichSuDiem', { method: 'GET' });
                    const data = await response.json();

                    if (!response.ok) {
                        throw new Error(data?.message || 'Không tải được lịch sử điểm.');
                    }

                    const kh = data?.khachHang || {};
                    pointHistorySummary.classList.remove('d-none');
                    pointHistorySummary.innerHTML = `
                        <div class="d-flex flex-wrap gap-3 justify-content-between">
                            <div><strong>Khách hàng:</strong> ${kh.tenKhachHang || '-'}</div>
                            <div><strong>Điểm hiện tại:</strong> ${formatPoints(kh.diemHienTai)}</div>
                            <div><strong>Tổng điểm tích lũy:</strong> ${formatPoints(kh.tongDiemTichLuy)}</div>
                            <div><strong>Rank:</strong> ${kh.rank || 'Chưa xếp hạng'}</div>
                        </div>
                    `;

                    renderPointRows(data);
                } catch (error) {
                    pointHistoryError.classList.remove('d-none');
                    pointHistoryError.textContent = error.message || 'Có lỗi xảy ra khi tải lịch sử điểm.';
                    pointHistoryTableBody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">Không có dữ liệu.</td></tr>';
                } finally {
                    pointHistoryLoading.classList.add('d-none');
                }
            });
        }
    });

    function cancelOrder(orderId) {
        const lyDo = prompt('Vui lòng nhập lý do hủy đơn hàng:');
        if (lyDo === null) return;
        if (lyDo.trim() === '') {
            alert('Vui lòng nhập lý do hủy đơn hàng!');
            return;
        }
        if (confirm('Bạn có chắc muốn hủy đơn hàng này?')) {
            fetch(`/DonHang/HuyDon/${orderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ LyDoHuyDon: lyDo.trim() })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    alert('Đã hủy đơn hàng thành công!');
                    location.reload();
                } else {
                    alert(result.message || 'Không thể hủy đơn hàng');
                }
            })
            .catch(error => alert('Có lỗi xảy ra khi hủy đơn hàng'));
        }
    }

    async function viewShippingInfo(orderId) {
        alert('Đơn hàng sẽ đến tay bạn từ 3-5 ngày');
    }
</script>
