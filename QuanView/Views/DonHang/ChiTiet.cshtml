@model QuanApi.Data.HoaDon
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var tamTinh = Math.Max(0, (Model.TongTien + (Model.TienGiam ?? 0) - (Model.PhiVanChuyen ?? 0)));
    var soTienGiamTuDiem = Model.SoTienGiamTuDiem > 0
        ? Model.SoTienGiamTuDiem
        : (Model.DiemDaDung * Model.TyLeQuyDoiDiem);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --danger-color: #dc3545;
        --bg-light: #f8f9fa;
        --glass-shadow: 0 8px 32px rgba(0,0,0,0.05);
    }

    body { background-color: #f4f7f9; color: #333; }

    /* Order Stepper (Top Progress Bar) */
    .order-stepper {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin-bottom: 40px;
        padding: 0 20px;
    }
    .order-stepper::before {
        content: "";
        position: absolute;
        top: 15px; left: 50px; right: 50px;
        height: 3px; background: #e0e0e0;
        z-index: 1;
    }
    .step {
        position: relative; z-index: 2;
        text-align: center; width: 100px;
    }
    .step-icon {
        width: 35px; height: 35px;
        border-radius: 50%; background: #e0e0e0;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 8px; color: white;
        transition: all 0.3s;
    }
    .step.active .step-icon { background: var(--primary-color); box-shadow: 0 0 0 5px rgba(13, 110, 253, 0.2); }
    .step.completed .step-icon { background: var(--success-color); }
    .step-label { font-size: 12px; font-weight: 600; color: #888; }
    .step.active .step-label { color: var(--primary-color); }

    /* Modern Cards */
    .order-card {
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(0,0,0,0.05);
        box-shadow: var(--glass-shadow);
        margin-bottom: 24px;
    }
    .card-header-premium {
        padding: 20px 25px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .card-header-premium h5 { margin: 0; font-weight: 700; font-size: 1.1rem; }
    .premium-icon { color: var(--primary-color); font-size: 1.3rem; }

    /* Info Rows */
    .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; padding: 25px; }
    .info-item label { display: block; font-size: 12px; text-transform: uppercase; color: #999; letter-spacing: 1px; margin-bottom: 4px; font-weight: 700; }
    .info-item p { margin: 0; font-weight: 500; color: #2d3436; }

    /* Table Styles */
    .table-premium thead th {
        background: #fdfdfd;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1px;
        padding: 15px;
        color: #7f8c8d;
    }
    .product-img-placeholder {
        width: 50px; height: 50px;
        background: #f0f0f0; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        color: #ccc;
    }

    /* Summary Section */
    .summary-box { background: #fcfcfc; border-radius: 12px; padding: 20px; }
    .summary-row { display: flex; justify-content: space-between; margin-bottom: 10px; font-size: 15px; }
    .summary-total { border-top: 2px dashed #eee; margin-top: 15px; padding-top: 15px; font-size: 20px; font-weight: 800; color: var(--primary-color); }

    /* Buttons */
    .btn-custom-back { color: #636e72; background: white; border: 1px solid #dfe6e9; padding: 10px 20px; border-radius: 10px; transition: 0.2s; }
    .btn-custom-back:hover { background: #f1f2f6; color: #2d3436; }
</style>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bold mb-1">Chi tiết đơn hàng</h2>
            <p class="text-muted mb-0">Quản lý và theo dõi thông tin đơn hàng của bạn</p>
        </div>
        <a href="@Url.Action("Index")" class="btn btn-custom-back shadow-sm">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    @if (Model != null)
    {
        <div class="order-card p-4 mb-4">
            <div class="order-stepper">
                @{
                    var status = Model.TrangThai;
                    string[] stages = { "Chờ xác nhận", "Đã xác nhận", "Đang giao hàng", "Giao hàng thành công" };
                    int currentIdx = Array.IndexOf(stages, status);
                    if (status == "Đã hủy") { stages = new string[] { "Chờ xác nhận", "Đã hủy" }; currentIdx = 1; }
                }
                @for (int i = 0; i < stages.Length; i++)
                {
                    bool isCompleted = currentIdx > i || status == "Giao hàng thành công";
                    bool isActive = currentIdx == i;
                    <div class="step @(isActive ? "active" : "") @(isCompleted ? "completed" : "")">
                        <div class="step-icon">
                            @if (isCompleted) { <i class="bi bi-check-lg"></i> }
                            else { <span>@(i + 1)</span> }
                        </div>
                        <div class="step-label">@GetTrangThaiText(stages[i])</div>
                    </div>
                }
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="order-card">
                    <div class="card-header-premium">
                        <i class="bi bi-info-circle-fill premium-icon"></i>
                        <h5>Thông tin vận chuyển</h5>
                    </div>
                    <div class="info-grid">
                        <div class="info-item">
                            <label>Mã Đơn Hàng</label>
                            <p class="text-primary fw-bold">#@Model.MaHoaDon</p>
                        </div>
                        <div class="info-item">
                            <label>Ngày Tạo</label>
                            <p>@Model.NgayTao.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <div class="info-item">
                            <label>Khách Hàng</label>
                            <p>@(string.IsNullOrEmpty(Model.TenNguoiNhan) ? "Khách vãng lai" : Model.TenNguoiNhan)</p>
                        </div>
                        <div class="info-item">
                            <label>Số Điện Thoại</label>
                            <p>@(Model.SoDienThoaiNguoiNhan ?? "N/A")</p>
                        </div>
                        <div class="info-item" style="grid-column: span 2;">
                            <label>Địa Chỉ Nhận Hàng</label>
                            <p><i class="bi bi-geo-alt-fill text-danger me-1"></i> @(Model.DiaChiGiaoHang ?? "Nhận tại quầy")</p>
                        </div>
                    </div>
                </div>

                <div class="order-card">
                    <div class="card-header-premium">
                        <i class="bi bi-bag-check-fill premium-icon"></i>
                        <h5>Sản phẩm đã mua</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-premium mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 40%">Sản phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ChiTietHoaDons)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="product-img-placeholder"><i class="bi bi-image"></i></div>
                                                <div>
                                                    <div class="fw-bold">@item.SanPhamChiTiet?.SanPham?.TenSanPham</div>
                                                    <small class="text-muted">
                                                        @item.SanPhamChiTiet?.MauSac?.TenMauSac / @item.SanPhamChiTiet?.KichCo?.TenKichCo
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.SoLuong</td>
                                        <td class="text-end">@item.DonGia.ToString("N0") ₫</td>
                                        <td class="text-end fw-bold">@item.ThanhTien.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="order-card">
                    <div class="card-header-premium">
                        <i class="bi bi-credit-card-2-back-fill premium-icon"></i>
                        <h5>Thanh toán</h5>
                    </div>
                    <div class="p-4">
                        <div class="summary-box">
                            <div class="summary-row text-muted">
                                <span>Tạm tính</span>
                                <span>@tamTinh.ToString("N0") ₫</span>
                            </div>
                            @if (Model.TienGiam > 0)
                            {
                                <div class="summary-row text-success">
                                    <span>Giảm giá</span>
                                    <span>-@Model.TienGiam?.ToString("N0") ₫</span>
                                </div>
                            }
                            @if (Model.DiemDaDung > 0)
                            {
                                <div class="summary-row text-muted">
                                    <span>Điểm đã dùng</span>
                                    <span>@Model.DiemDaDung.ToString("N0") điểm</span>
                                </div>
                                <div class="summary-row text-success">
                                    <span>Quy đổi từ điểm</span>
                                    <span>-@soTienGiamTuDiem.ToString("N0") ₫ (1 điểm = @Model.TyLeQuyDoiDiem.ToString("N0") ₫)</span>
                                </div>
                            }
                            <div class="summary-row text-muted">
                                <span>Phí vận chuyển</span>
                                <span>@(Model.PhiVanChuyen > 0 ? Model.PhiVanChuyen?.ToString("N0") + " ₫" : "Miễn phí")</span>
                            </div>
                            <div class="summary-row summary-total">
                                <span>Tổng cộng</span>
                                <span>@Model.TongTien.ToString("N0") ₫</span>
                            </div>
                        </div>

                        <div class="mt-4 info-item">
                            <label>Phương thức</label>
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-wallet2 text-primary"></i>
                                <span>@(Model.PhuongThucThanhToan?.TenPhuongThuc ?? "Tiền mặt")</span>
                            </div>
                        </div>

                        @if (Model.TrangThai == "Chờ xác nhận" || Model.TrangThai == "Đã xác nhận")
                        {
                            <button class="btn btn-outline-danger w-100 mt-4 py-2 fw-bold" 
                                    id="btnCancel" onclick="handleCancelOrder('@Model.IDHoaDon')">
                                <i class="bi bi-x-circle me-2"></i> Hủy đơn hàng
                            </button>
                        }
                        
                        @if(!string.IsNullOrEmpty(Model.LyDoHuyDon)) {
                            <div class="alert alert-danger mt-3 mb-0" style="font-size: 13px;">
                                <strong>Lý do hủy:</strong> @Model.LyDoHuyDon
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    async function handleCancelOrder(orderId) {
        const reason = prompt('Lý do bạn muốn hủy đơn hàng này?');
        
        if (!reason || reason.trim() === '') {
            if (reason !== null) alert('Vui lòng nhập lý do để chúng tôi cải thiện dịch vụ!');
            return;
        }

        if (!confirm('Xác nhận hủy đơn hàng này? Thao tác này không thể hoàn tác.')) return;

        const btn = document.getElementById('btnCancel');
        const originalContent = btn.innerHTML;
        
        try {
            // UI Loading state
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Đang xử lý...';

            const response = await fetch(`/DonHang/HuyDon/${orderId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ LyDoHuyDon: reason.trim() })
            });

            const result = await response.json();

            if (result.success) {
                alert('Đơn hàng đã được hủy thành công.');
                window.location.reload();
            } else {
                throw new Error(result.message || 'Lỗi xử lý hệ thống');
            }
        } catch (error) {
            alert(error.message);
            btn.disabled = false;
            btn.innerHTML = originalContent;
        }
    }
</script>

@functions {
    public string GetTrangThaiText(string trangThai)
    {
        return trangThai switch
        {
            "Chờ xác nhận" => "Chờ xác nhận",
            "Đã xác nhận" => "Đã xác nhận",
            "Chờ lấy hàng" => "Chuẩn bị hàng",
            "Đang giao hàng" => "Đang giao",
            "Giao hàng thành công" => "Hoàn thành",
            "Đã hủy" => "Đã hủy",
            _ => trangThai
        };
    }
}