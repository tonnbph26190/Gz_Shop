@model QuanView.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập</title>
    <!-- CSS tương tự trang Register -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-hover: #4338ca;
            --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            --glass-bg: rgba(255, 255, 255, 0.95);
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #1f2937;
        }

        .login-card {
            background: var(--glass-bg);
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            border-radius: 24px;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            animation: slideUp 0.5s ease-out;
        }

        .header-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .header-section h2 {
            font-weight: 700;
            color: #111827;
            letter-spacing: -0.025em;
        }

        .header-section p {
            color: #6b7280;
            font-size: 0.95rem;
        }

        .form-label {
            font-weight: 500;
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
            color: #374151;
        }

        .form-control {
            padding: 0.75rem 1rem;
            border-radius: 12px;
            border: 1px solid #d1d5db;
            transition: all 0.2s;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .password-wrapper {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #9ca3af;
            cursor: pointer;
            padding: 5px;
            z-index: 10;
        }

        .password-toggle:hover {
            color: var(--primary-color);
        }

        .btn-submit {
            background-color: var(--primary-color);
            border: none;
            padding: 0.8rem;
            border-radius: 12px;
            font-weight: 600;
            transition: transform 0.2s, background-color 0.2s;
        }

        .btn-submit:hover {
            background-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        .google-btn {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 0.75rem;
            font-weight: 500;
            color: #374151;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .google-btn:hover {
            background: #f9fafb;
            border-color: #d1d5db;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            margin: 1.5rem 0;
            color: #9ca3af;
            font-size: 0.875rem;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid #e5e7eb;
        }

        .divider:not(:empty)::before { margin-right: .75rem; }
        .divider:not(:empty)::after { margin-left: .75rem; }

        .footer-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
        }

        .footer-link:hover {
            text-decoration: underline;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="header-section">
            <h2>Mừng bạn trở lại</h2>
            <p>Vui lòng đăng nhập để tiếp tục</p>
        </div>

        @if (ViewData.ModelState["LoginError"]?.Errors.Count > 0 || ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 px-3 rounded-3" style="font-size: 0.85rem;">
                <i class="fas fa-exclamation-circle me-2"></i>
                @(ViewBag.Error ?? ViewData.ModelState["LoginError"].Errors[0].ErrorMessage)
            </div>
        }

        @if (ViewBag.SuccessMessage != null)
        {
            <div class="alert alert-success py-2 px-3 rounded-3" style="font-size: 0.85rem;">
                <i class="fas fa-check-circle me-2"></i> @ViewBag.SuccessMessage
            </div>
        }

        <form method="post" action="@Url.Action("FormLogin", "Login")">
            @Html.AntiForgeryToken()
            
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="Email"
                       value="@Model?.Email" placeholder="name@example.com" required>
            </div>

            <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <a href="@Url.Action("ForgotPassword", "Login")" class="footer-link" style="font-size: 0.8rem;">Quên mật khẩu?</a>
                </div>
                <div class="password-wrapper">
                    <input type="password" class="form-control" id="password" name="Password"
                           placeholder="••••••••" required>
                    <button type="button" id="togglePassword" class="password-toggle">
                        <i class="fa-solid fa-eye"></i>
                    </button>
                </div>
            </div>

            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe">
                <label class="form-check-label text-muted" for="rememberMe" style="font-size: 0.85rem;">
                    Ghi nhớ đăng nhập
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-submit w-100 mb-2">Đăng nhập</button>
        </form>

        <div class="divider">Hoặc tiếp tục với</div>

        <a href="@Url.Action("GoogleLogin", "Login")" class="google-btn w-100">
            <svg width="20" height="20" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Google
        </a>

        <p class="text-center mt-4 mb-0" style="font-size: 0.9rem;">
            Chưa có tài khoản? <a href="@Url.Action("Register", "Login")" class="footer-link">Đăng ký ngay</a>
        </p>
    </div>

    <script>
        // Xử lý ẩn hiện mật khẩu
        const passwordInput = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");
        const icon = togglePassword.querySelector("i");

        togglePassword.addEventListener("click", function () {
            const isPassword = passwordInput.type === "password";
            passwordInput.type = isPassword ? "text" : "password";
            icon.classList.toggle("fa-eye");
            icon.classList.toggle("fa-eye-slash");
        });

        // Auto-focus nếu cần
        document.addEventListener('DOMContentLoaded', function () {
            @if (ViewBag.SuccessMessage != null) {
                <text>document.getElementById('email').focus();</text>
            }
        });
    </script>
</body>
</html>