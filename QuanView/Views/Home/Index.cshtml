@model List<QuanApi.Data.Banner>

@{
    ViewData["Title"] = "Home Page";
    var featuredProducts = ViewBag.FeaturedProducts as List<QuanApi.Dtos.SanPhamKhachHangViewModel>
                           ?? new List<QuanApi.Dtos.SanPhamKhachHangViewModel>();
}

<style>
    /* --- Base & Utility --- */
    html { scroll-behavior: smooth; }
    .text-shadow { text-shadow: 0 2px 8px rgba(0,0,0,0.5); }
    .transition-zoom { transition: transform .5s ease; }

    /* --- Section Headers --- */
    .section-title { 
        text-align: center; 
        margin-bottom: 40px; 
        cursor: default; 
    }

    .section-title h2 {
        font-size: 28px;
        font-weight: 700;
        display: inline-block;
        position: relative;
        padding-bottom: 8px;
    }

    .section-title h2::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: 50%; /* Start at center */
        transform: translateX(-50%); /* Center the bar */
        height: 3px;
        width: 60px; /* Original width */
        background: #dc3545;
        border-radius: 3px;
        transition: width 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94); /* Smooth expansion */
    }

    /* The hover effect */
    .section-title:hover h2::after {
        width: 100%; /* Expands to fit the full sentence */
    }
    /* --- Hero Carousel --- */
    .hero__items { height: 70vh; }
    #heroCarousel .carousel-control-prev, 
    #heroCarousel .carousel-control-next,
    #heroCarousel .carousel-indicators {
        opacity: 0;
        transition: all 0.3s ease;
    }
    #heroCarousel .carousel-control-prev { transform: translateX(-15px); }
    #heroCarousel .carousel-control-next { transform: translateX(15px); }
    #heroCarousel:hover .carousel-control-prev,
    #heroCarousel:hover .carousel-control-next,
    #heroCarousel:hover .carousel-indicators {
        opacity: 1;
        transform: translateX(0);
    }

    /* --- Category Showcase --- */
    .category-section {
        background: linear-gradient(180deg, #ffffff 0%, #f7f8fb 100%);
        overflow: hidden;
    }

    .category-reel-wrap {
        position: relative;
        isolation: isolate;
        margin-inline: calc(50% - 50vw);
        overflow: hidden;
        padding-inline: max(18px, calc((100vw - 1320px) / 2));
    }

    .category-reel {
        align-items: stretch;
        display: flex;
        gap: 28px;
        overflow-x: auto;
        padding: 14px 8px 36px;
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
    }

    .category-reel::-webkit-scrollbar {
        display: none;
    }

    .category-frame {
        flex: 0 0 clamp(430px, 58vw, 760px);
        scroll-snap-align: center;
        position: relative;
    }

    .category-banner {
        aspect-ratio: 16 / 10;
        background:
            radial-gradient(circle at 18% 12%, rgba(220,53,69,.08), transparent 32%),
            linear-gradient(135deg, #f8fafc 0%, #eef2f7 100%);
        border: 1px solid rgba(15, 23, 42, .08);
        border-radius: 20px;
        box-shadow: 0 24px 65px rgba(15, 23, 42, .13);
        overflow: hidden;
        position: relative;
    }

    .category-banner img {
        filter: saturate(.98) contrast(1.02);
        height: 100%;
        object-fit: contain;
        padding: 10px;
        transition: transform .55s ease, filter .55s ease;
        width: 100%;
    }

    .category-banner:hover img {
        filter: saturate(1.08) contrast(1.08);
        transform: scale(1.035);
    }

    .category-overlay {
        background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.46));
        inset: 0;
        position: absolute;
        transition: background .3s ease;
    }

    .category-banner:hover .category-overlay {
        background: linear-gradient(180deg, rgba(0,0,0,.16), rgba(0,0,0,.72));
    }

    .category-reel-control {
        align-items: center;
        background: rgba(255,255,255,.94);
        border: 1px solid rgba(15,23,42,.1);
        border-radius: 50%;
        box-shadow: 0 16px 38px rgba(15,23,42,.16);
        color: #111827;
        display: inline-flex;
        height: 46px;
        justify-content: center;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 46px;
        z-index: 4;
    }

    .category-reel-control:hover {
        background: #dc3545;
        color: #fff;
    }

    .category-reel-prev { left: max(14px, calc((100vw - 1320px) / 2)); }
    .category-reel-next { right: max(14px, calc((100vw - 1320px) / 2)); }

    /* --- Product Cards --- */
    .featured-section {
        background:
            radial-gradient(circle at 18% 4%, rgba(220,53,69,.06), transparent 26%),
            linear-gradient(180deg, #f7f8fb 0%, #ffffff 100%) !important;
    }

    .product-card {
        position: relative;
        border: 1px solid rgba(15, 23, 42, .07);
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s ease;
        z-index: 1;
    }
    .product-card:hover { transform: translateY(-8px); box-shadow: 0 20px 44px rgba(15,23,42,.12) !important; }
    .product-img-container {
        position: relative; 
        overflow: hidden; 
        background: #f8fafc;
        z-index: 1;
    }
    .product-card img { aspect-ratio: 4/3; object-fit: contain; transition: transform 0.6s ease; }
    .product-card:hover img { transform: scale(1.08); }

    .badge-sale {
        position: absolute; 
        top: 12px; 
        left: 12px;
        background-color: #dc3545; 
        color: white;
        padding: 4px 10px; 
        font-size: 11px; 
        font-weight: 700;
        border-radius: 4px; 
        z-index: 10;
        text-transform: uppercase;
        opacity: 0.5; 
        transition: opacity 0.3s ease; 
        pointer-events: none; 
    }
        .product-card:hover .badge-sale {
            opacity: 1;
        }
    .product-title {
        font-size: 0.95rem; font-weight: 600; color: #212529;
        display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .current-price { font-size: 1.1rem; font-weight: 700; color: #dc3545; }
    .old-price { font-size: 0.85rem; color: #adb5bd; text-decoration: line-through; margin-left: 6px; }

    .btn-detail {
        border-radius: 6px; font-weight: 600; padding: 8px;
        transition: all 0.3s; border: 1.5px solid #dc3545;
        background: transparent; color: #dc3545; text-align: center;
    }
    .btn-detail:hover { background: #dc3545; color: #fff; }

    /* --- Parallax/Banner Section 2 --- */
    .banner-bg {
        background-size: cover; background-position: center;
        min-height: 500px; display: flex; align-items: center; justify-content: center;
        position: relative; color: white; text-align: center;
    }
    .banner-overlay { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.6); z-index: 1; }
    .banner-content { position: relative; z-index: 2; max-width: 800px; padding: 20px; }

    /* --- Animations --- */
    .reveal-on-scroll { opacity: 0; transform: translateY(40px); transition: all 0.8s ease-out; visibility: hidden; }
    .reveal-on-scroll.active { opacity: 1; transform: translateY(0); visibility: visible; }

    .category-btn {
        border: 2px solid transparent;
        transition: all 0.3s ease;
        z-index: 5;
    }

    .category-btn:hover {
        background-color: #dc3545 !important; 
        color: #fff !important;
        border-color: #fff;
        transform: scale(1.1);
    }

    .category-btn {
        border-radius: 999px;
        opacity: 0.95;
        transform: translateY(8px);
    }

    .category-banner:hover .category-btn {
        opacity: 1;
        transform: translateY(0);
    }
    .category-btn:hover {
        background-color: #dc3545 !important;
        color: white !important;
    }
    /* For Chrome, Safari and Opera */
    section::-webkit-scrollbar {
        display: none;
    }

    /* For IE, Edge and Firefox */
    section {
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
    }
    #chiTiet {
        border-color: #6c757d;
        border-width: 1px;
        border-radius: 5px;
    }

    #chiTiet:hover {
        color:red;
        border-color: red;
    }
</style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Banner section 1 -->
<section id="heroCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <section class="hero__items text-white text-center d-flex align-items-center justify-content-center"
                style="background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/img/banner/Banner2.jpg') center/cover no-repeat;">
                <div style="margin-top: -10rem;">
                    <h1 class="display-4 fw-bold text-shadow">BỘ QUẦN ĐÔNG-XUÂN 2026</h1>
                    <a href="#featured-products" class="btn btn-danger btn-lg mt-3">Mua ngay</a>
                </div>
            </section>
        </div>
        <div class="carousel-item">
            <section class="hero__items" style="background: url('/img/banner/Banner3.jpg') center/cover no-repeat;"></section>
        </div>
        <div class="carousel-item">
            <section class="hero__items" style="background: url('/img/banner/Banner4.jpg') center/cover no-repeat;"></section>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</section>
<!-- Category section -->
<section class="category-section py-5 reveal-on-scroll">
    <div class="container">
        <div class="section-title">
            <h2>Danh mục sản phẩm</h2>
        </div>
        <div class="category-reel-wrap">
            <button type="button" class="category-reel-control category-reel-prev" data-category-reel="prev" aria-label="Danh mục trước">
                <i class="fa fa-chevron-left"></i>
            </button>
            <div class="category-reel" id="categoryReel">
            @if (Model?.Any() == true)
            {
                foreach (var b in Model)
                {
                    var bannerLink = !string.IsNullOrWhiteSpace(b.Link)
                        ? b.Link
                        : Url.Action("SanPhamTheoLink", "Banner", new { id = b.Id });
                    <div class="category-frame">
                        <div class="category-banner">
                            <img src="@b.ImageUrl" alt="@b.Title" class="transition-zoom" loading="lazy" />
                            
                            <div class="category-overlay d-flex flex-column align-items-center justify-content-center text-center px-3">
                                <h4 class="text-white fw-bold mb-3 text-uppercase text-shadow">@b.Title</h4>
                                
                            <a href="@bannerLink" class="btn btn-light btn-sm px-4 py-2 fw-bold shadow-sm category-btn">
                                KHÁM PHÁ
                            </a>
                            </div>
                        </div>
                    </div>
                }
            }
            </div>
            <button type="button" class="category-reel-control category-reel-next" data-category-reel="next" aria-label="Danh mục tiếp theo">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    </div>
</section>
<!-- Product section -->
<section id="featured-products" class="featured-section py-5 reveal-on-scroll">
    <div class="container">
        <div class="section-title">
            <h2>Sản phẩm nổi bật</h2>
        </div>
        <div class="row g-4">
            @foreach (var product in featuredProducts)
            {
                var firstBienThe = product.BienThes?.FirstOrDefault();
                var giaGoc = firstBienThe?.GiaGoc ?? 0;
                var giaSauGiam = firstBienThe?.GiaSauGiam ?? 0;
                var coGiamGia = giaSauGiam < giaGoc;
                var anhDaiDien = !string.IsNullOrEmpty(product.UrlAnh) ? product.UrlAnh : "/img/default-product.jpg";
                var soLuongTon = product.BienThes?.Sum(b => b.SoLuong) ?? 0;

                <div class="col-6 col-md-4 col-lg-3 d-flex">
                    <div class="product-card shadow-sm h-100 w-100 d-flex flex-column">
                        @if (coGiamGia) { <div class="badge-sale">Giảm giá</div> } 

                        <div class="product-img-container">
                            <img src="@anhDaiDien" alt="@product.TenSanPham" class="w-100" />
                        </div>

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="d-flex align-items-baseline mb-2">
                                <h6 class="product-title mb-0 fw-bold">@product.TenSanPham</h6>
                                <span class="mx-2 text-muted" style="font-size: 0.8rem;">•</span>
                                <span class="text-muted" style="font-size: 0.75rem; white-space: nowrap;">@product.DanhMuc</span>
                            </div>
                            
                            <div class="mt-auto">
                                <div class="mb-2">
                                    <span class="current-price">@((coGiamGia ? giaSauGiam : giaGoc).ToString("N0")) đ</span>
                                    @if (coGiamGia) { <span class="old-price">@giaGoc.ToString("N0") đ</span> }
                                </div>

                                <small class="text-muted d-block mb-3">
                                    <i class="bi bi-box-seam me-1"></i>Kho: @soLuongTon
                                </small>

                                <a id="chiTiet" href="@Url.Action("Detail", "SanPhamNguoiDung", new { id = firstBienThe?.IDSanPhamChiTiet })" class="btn btn-detail d-block w-100">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Banner section 2 -->
<section class="reveal-on-scroll">
    <div class="banner-bg" style="background-image: url('../img/banner/Homepage_Video-First_Frame.jpg');">
        <div class="banner-overlay"></div>
        <div class="banner-content text-shadow">
            <h1 class="fw-bold mb-3 fs-1 text-light">Khám Phá Nghệ Thuật quần áo đẳng cấp</h1>
            <p class="fs-6 opacity-90" style="color:#ffffff93">
				khong chỉ là thời trang, mà còn là sự kết hợp tinh tế giữa nghệ thuật và phong cách sống.
            </p>
        </div>
    </div>
</section>

<br class="pt-5">

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const observerOptions = { threshold: 0.1 };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                } else {
                    entry.target.classList.remove('active');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal-on-scroll').forEach(target => observer.observe(target));

        const categoryReel = document.getElementById('categoryReel');
        let categoryAutoTimer = null;

        function getCategoryStep() {
            if (!categoryReel) return 360;
            const card = categoryReel.querySelector('.category-frame');
            return card ? card.offsetWidth + 24 : 520;
        }

        function moveCategoryReel(direction) {
            if (!categoryReel) return;
            const nearEnd = categoryReel.scrollLeft + categoryReel.clientWidth >= categoryReel.scrollWidth - 10;
            if (direction > 0 && nearEnd) {
                categoryReel.scrollTo({ left: 0, behavior: 'smooth' });
                return;
            }
            categoryReel.scrollBy({ left: direction * getCategoryStep(), behavior: 'smooth' });
        }

        function startCategoryAuto() {
            if (!categoryReel || categoryAutoTimer) return;
            categoryAutoTimer = setInterval(() => moveCategoryReel(1), 3200);
        }

        function stopCategoryAuto() {
            clearInterval(categoryAutoTimer);
            categoryAutoTimer = null;
        }

        document.querySelectorAll('[data-category-reel]').forEach(button => {
            button.addEventListener('click', () => {
                const direction = button.dataset.categoryReel === 'next' ? 1 : -1;
                moveCategoryReel(direction);
            });
        });

        if (categoryReel) {
            categoryReel.addEventListener('mouseenter', stopCategoryAuto);
            categoryReel.addEventListener('mouseleave', startCategoryAuto);
            categoryReel.addEventListener('touchstart', stopCategoryAuto, { passive: true });
            categoryReel.addEventListener('touchend', startCategoryAuto);
            startCategoryAuto();
        }
    });
</script>
