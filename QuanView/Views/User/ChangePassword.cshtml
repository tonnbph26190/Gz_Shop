@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-5" style="max-width:600px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                <i class="fa fa-lock text-danger me-2"></i>
                Đổi mật khẩu
            </h3>

            <form asp-controller="User" asp-action="ChangePassword" method="post">

                <div class="mb-3">
                    <label class="form-label">Mật khẩu cũ</label>
                    <input type="password"
                           name="matKhauCu"
                           class="form-control" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("matKhauCu")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mật khẩu mới</label>
                    <input type="password"
                           name="matKhauMoi"
                           class="form-control" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("matKhauMoi")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Xác nhận mật khẩu mới</label>
                    <input type="password"
                           name="xacNhanMatKhau"
                           class="form-control" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("xacNhanMatKhau")
                    </span>
                </div>

                <button type="submit" class="btn btn-danger">
                    Đổi mật khẩu
                </button>

            </form>

        </div>
    </div>
</div>
