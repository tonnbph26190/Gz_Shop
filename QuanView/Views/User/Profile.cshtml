@model KhachHang

@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<div class="container py-5" style="max-width:700px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                <i class="fa fa-user text-danger me-2"></i>
                Thông tin tài khoản
            </h3>

           

            <form asp-controller="User"
                  asp-action="Profile"
                  method="post"
                  enctype="multipart/form-data">

                <div class="text-center mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.AnhDaiDien) ? "/img/avatar-default.png" : Model.AnhDaiDien)"
                         style="width:130px;height:130px;border-radius:50%;object-fit:cover;border:1px solid #ddd;" />

                    <div class="mt-3">
                        <label class="btn btn-outline-danger btn-sm">
                            Đổi ảnh đại diện
                            <input type="file"
                                   name="avatar"
                                   accept="image/*"
                                   hidden />
                        </label>
                        <span class="text-danger small">
                            @Html.ValidationMessage("avatar")
                        </span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tên tài khoản</label>
                    <input name="tenKhachHang"
                           class="form-control"
                           value="@Model.TenKhachHang" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("tenKhachHang")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="email"
                           class="form-control"
                           value="@Model.Email" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("email")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input name="soDienThoai"
                           class="form-control"
                           value="@Model.SoDienThoai" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("soDienThoai")
                    </span>
                </div>

                <button type="submit" class="btn btn-danger">
                    Lưu thay đổi
                </button>

            </form>

        </div>
    </div>
</div>
