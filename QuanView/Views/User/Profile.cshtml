@model KhachHang

@{
    var avatarInitial = string.IsNullOrWhiteSpace(Model.TenKhachHang)
        ? "G"
        : Model.TenKhachHang.Trim().Substring(0, 1).ToUpperInvariant();
}

@{
    ViewData["Title"] = "Thông tin tài khoản";
}

<style>
    .profile-avatar-frame {
        align-items: center;
        background: #dc3545;
        border-radius: 50%;
        color: #fff;
        display: inline-flex;
        font-size: 44px;
        font-weight: 800;
        height: 130px;
        justify-content: center;
        overflow: hidden;
        position: relative;
        width: 130px;
    }

    .profile-avatar-frame img {
        border: 1px solid #ddd;
        border-radius: 50%;
        height: 130px;
        inset: 0;
        object-fit: cover;
        position: absolute;
        width: 130px;
    }
</style>

<div class="container py-5" style="max-width:700px;">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                <i class="fa fa-user text-danger me-2"></i>
                Thông tin tài khoản
            </h3>

           

            <form asp-controller="User"
                  asp-action="Profile"
                  method="post"
                  enctype="multipart/form-data">

                <div class="text-center mb-4">
                    <span class="profile-avatar-frame">
                        <span>@avatarInitial</span>
                        <img id="avatarPreview"
                             src="@(string.IsNullOrEmpty(Model.AnhDaiDien) ? "/img/avatar-default.png" : Model.AnhDaiDien)"
                             onerror="this.style.display='none';" />
                    </span>

                    <div class="mt-3">
                        <label class="btn btn-outline-danger btn-sm">
                            Đổi ảnh đại diện
                            <input type="file"
                                   id="avatarInput"
                                   name="avatar"
                                   accept="image/*"
                                   hidden />
                        </label>
                        <span class="text-danger small">
                            @Html.ValidationMessage("avatar")
                        </span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tên tài khoản</label>
                    <input name="tenKhachHang"
                           class="form-control"
                           value="@Model.TenKhachHang" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("tenKhachHang")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="email"
                           class="form-control"
                           value="@Model.Email" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("email")
                    </span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input name="soDienThoai"
                           class="form-control"
                           value="@Model.SoDienThoai" />
                    <span class="text-danger small">
                        @Html.ValidationMessage("soDienThoai")
                    </span>
                </div>

                <button type="submit" class="btn btn-danger">
                    Lưu thay đổi
                </button>

            </form>

        </div>
    </div>
</div>
<script>
    document.getElementById("avatarInput").addEventListener("change", function (event) {
        const file = event.target.files[0];

        if (file) {
            const imageUrl = URL.createObjectURL(file);
            const avatarPreview = document.getElementById("avatarPreview");
            avatarPreview.style.display = "block";
            avatarPreview.src = imageUrl;
        }
    });
</script>
